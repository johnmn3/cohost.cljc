 .../cpp/jank/runtime/core/make_box.hpp        |  2 +-
 .../include/cpp/jank/runtime/core/math.hpp    | 49 ++++++++++++++-----
 .../include/cpp/jank/runtime/obj/number.hpp   |  3 +-
 .../include/cpp/jank/runtime/oref.hpp         | 37 +++++++++-----
 .../src/cpp/jank/analyze/cpp_util.cpp         |  2 +-
 compiler+runtime/src/cpp/jank/codegen/api.cpp |  2 +-
 .../src/cpp/jank/codegen/cpp_processor.cpp    |  3 +-
