+  /* Each thread's token: a small number from a counter, never 0. */
+  static u32 realize_lock_token() noexcept
+  {
+    static std::atomic<u32> next{ 1 };
+    thread_local u32 const token{ next.fetch_add(1, std::memory_order_relaxed) };
+    return token;
+  }
+
+  lazy_sequence::realize_lock::realize_lock(lazy_sequence const &o) noexcept
+    : o{ o }
+  {
+    auto const me{ realize_lock_token() };
+    if(o.lock_owner.load(std::memory_order_relaxed) == me)
+    {
+      ++o.lock_depth;
+      return;
+    }
+    u32 expected{};
+    while(!o.lock_owner.compare_exchange_weak(expected,
+                                              me,
+                                              std::memory_order_acquire,
+                                              std::memory_order_relaxed))
+    {
+      expected = 0;
+      std::this_thread::yield();
+    }
+    o.lock_depth = 1;
+  }
+
+  lazy_sequence::realize_lock::~realize_lock()
+  {
+    if(--o.lock_depth == 0)
+    {
+      o.lock_owner.store(0, std::memory_order_release);
+    }
+  }
 }
