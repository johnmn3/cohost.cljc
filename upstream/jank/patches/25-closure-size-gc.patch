+  {
+    std::atomic_ref<lazy_meta *> const slot{ ptr };
+    auto current{ slot.load(std::memory_order_acquire) };
+    if(!current)
+    {
+      auto const fresh{ new(UseGC) lazy_meta{ o } };
+      if(slot.compare_exchange_strong(current, fresh, std::memory_order_acq_rel))
+      {
