diff --git a/compiler+runtime/include/cpp/jank/runtime/lazy_meta.hpp b/compiler+runtime/include/cpp/jank/runtime/lazy_meta.hpp
index c6958d95..26a1c3d3 100644
--- a/compiler+runtime/include/cpp/jank/runtime/lazy_meta.hpp
+++ b/compiler+runtime/include/cpp/jank/runtime/lazy_meta.hpp
@@ -40,4 +40,26 @@ namespace jank::runtime
     /*** XXX: Everything here is immutable after initialization. ***/
     ns_ref ns;
   };
+
+  /* A lazy_meta held out of line: null until the object carries meta, so a box pays 8 bytes
+   * instead of lazy_meta's 56 (almost no closure, lazy seq or chunked seq carries meta). Each
+   * holder owns its lazy_meta (copying a holder copies it), so set() never reaches another
+   * object. The pointer is published atomically; the lazy_meta synchronizes its own state. */
+  struct lazy_meta_ptr
+  {
+    lazy_meta_ptr() = default;
+    lazy_meta_ptr(object_ref const meta);
+    lazy_meta_ptr(lazy_meta_ptr const &o);
+    lazy_meta_ptr(lazy_meta_ptr &&o) noexcept;
+    lazy_meta_ptr &operator=(lazy_meta_ptr const &o);
+    lazy_meta_ptr &operator=(object_ref const meta);
+
+    object_ref get() const;
+    void set(object_ref const o);
+
+  private:
+    lazy_meta *load() const;
+
+    mutable lazy_meta *ptr{};
+  };
 }
