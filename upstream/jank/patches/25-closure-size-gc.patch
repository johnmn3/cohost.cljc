+    /* One allocation for the box and its capture context: the context is built in place right
+     * after the box (generated code: one closure site, one GC block). */
+    template <typename Ctx, typename... Args>
+    static jit_closure_ref create(callable_arity_flags const arity_flags,
+                                  jit_closure_arities const * const arities,
+                                  Args &&...args)
+    {
+      /* The context follows the box at its own alignment (not max_align_t's): a 40-byte box
+       * and a two-capture context are 56 bytes, one 64-byte block with bdwgc's extra byte. */
+      constexpr usize align{ alignof(Ctx) < alignof(jit_closure) ? alignof(jit_closure)
+                                                               : alignof(Ctx) };
+      constexpr usize box_size{ (sizeof(jit_closure) + align - 1) / align * align };
+      auto const mem{ static_cast<char *>(GC_malloc(box_size + sizeof(Ctx))) };
+      if(!mem)
+      {
+        throw std::bad_alloc{};
+      }
+      auto const ctx{ ::new(static_cast<void *>(mem + box_size)) Ctx{ std::forward<Args>(args)... } };
+      auto const ret{ ::new(static_cast<void *>(mem)) jit_closure{ arity_flags, ctx } };
+      ret->arities = arities;
+      return runtime::detail::untagged(ret);
+    }
