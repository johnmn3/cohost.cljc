diff --git a/compiler+runtime/src/cpp/jank/ir/processor.cpp b/compiler+runtime/src/cpp/jank/ir/processor.cpp
index e5b4881ef..1aff48c28 100644
--- a/compiler+runtime/src/cpp/jank/ir/processor.cpp
+++ b/compiler+runtime/src/cpp/jank/ir/processor.cpp
@@ -346,6 +346,104 @@ namespace jank::ir
     return name;
   }
 
+  /* Whether the rest param of a variadic arity can escape its body. It provably does not
+   * when every reference to it is a direct argument of an inlined `first`, `second`, `count`
+   * or `empty?` (none of which returns the sequence or a sequence sharing its storage), or
+   * when it is never referenced. Any expression kind not listed below (a nested fn, letfn,
+   * try, def, raw C++, member calls, ...) makes the answer "can escape", as does any other
+   * use of the name, shadowed or not. */
+  static bool rest_param_can_escape(analyze::expr::function_arity const &arity)
+  {
+    using analyze::expression_kind;
+    if(arity.params.empty())
+    {
+      return true;
+    }
+    auto const rest_name{ arity.params.back().name };
+    auto const is_rest_ref{ [&](analyze::expression_ref const e) {
+      return e->kind == expression_kind::local_reference
+        && jtl::static_ref_cast<analyze::expr::local_reference>(e)->name->equal(*rest_name);
+    } };
+    auto const is_allowed_target{ [](analyze::expression_ref const e) {
+      if(e->kind != expression_kind::cpp_value)
+      {
+        return false;
+      }
+      auto const form{ jtl::static_ref_cast<analyze::expr::cpp_value>(e)->form };
+      if(form.get_type() != runtime::object_type::symbol)
+      {
+        return false;
+      }
+      auto const name{ runtime::to_string(form) };
+      return name == "cpp/jank.runtime.first" || name == "cpp/jank.runtime.second"
+        || name == "cpp/jank.runtime.sequence_length" || name == "cpp/jank.runtime.is_empty";
+    } };
+
+    usize total{};
+    usize allowed{};
+    bool unknown{};
+    std::function<void(analyze::expression_ref)> visit;
+    visit = [&](analyze::expression_ref const e) {
+      if(unknown)
+      {
+        return;
+      }
+      switch(e->kind)
+      {
+        case expression_kind::local_reference:
+          if(is_rest_ref(e))
+          {
+            ++total;
+          }
+          return;
+        case expression_kind::cpp_call:
+          {
+            auto const call{ jtl::static_ref_cast<analyze::expr::cpp_call>(e) };
+            if(is_allowed_target(call->source_expr))
+            {
+              for(auto const arg : call->arg_exprs)
+              {
+                if(is_rest_ref(arg))
+                {
+                  ++allowed;
+                }
+              }
+            }
+            break;
+          }
+        case expression_kind::var_deref:
+        case expression_kind::var_ref:
+        case expression_kind::primitive_literal:
+        case expression_kind::recursion_reference:
+        case expression_kind::cpp_value:
+        case expression_kind::cpp_literal:
+        case expression_kind::cpp_type:
+          return;
+        case expression_kind::call:
+        case expression_kind::list:
+        case expression_kind::vector:
+        case expression_kind::map:
+        case expression_kind::set:
+        case expression_kind::recur:
+        case expression_kind::named_recursion:
+        case expression_kind::let:
+        case expression_kind::do_:
+        case expression_kind::if_:
+        case expression_kind::throw_:
+        case expression_kind::cpp_conversion:
+        case expression_kind::cpp_box:
+        case expression_kind::cpp_unbox:
+          break;
+        default:
+          unknown = true;
+          return;
+      }
+      e->walk(visit);
+    };
+    visit(arity.body);
+    return unknown || allowed != total;
+  }
+
   static runtime::callable_arity_flags
   arity_flags(native_vector<analyze::expr::function_arity> const &arities)
   {
@@ -370,9 +468,16 @@ namespace jank::ir
                                      && highest_fixed_arity->fn_ctx->param_count
                                        == variadic_arity->fn_ctx->param_count - 1 };
 
-      return runtime::build_arity_flags(variadic_arity->fn_ctx->param_count - 1,
-                                        true,
-                                        variadic_ambiguous);
+      auto const flags{ runtime::build_arity_flags(variadic_arity->fn_ctx->param_count - 1,
+                                                   true,
+                                                   variadic_ambiguous) };
+      /* -Odirect-call: a rest param that cannot escape lets a call pass the rest args on
+       * the caller's stack (jit_variadic_function::call). */
+      if(util::cli::opts.direct_call && !rest_param_can_escape(*variadic_arity))
+      {
+        return flags | runtime::rest_noescape_flag;
+      }
+      return flags;
     }
     jank_assert(highest_fixed_arity != nullptr);
     return runtime::build_arity_flags(highest_fixed_arity->fn_ctx->param_count, false, false);
