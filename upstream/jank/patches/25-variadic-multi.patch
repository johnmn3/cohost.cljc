+  /* The rest args of one call on the caller's stack: N object_refs and a
+   * native_array_sequence over them, alive until the end of the full expression that makes
+   * the call. Only used when the callee's rest param provably does not escape. */
+  template <usize N>
+  struct stack_rest_args
+  {
+    template <typename... Args>
+    explicit stack_rest_args(Args const &...args)
+      : storage{ args... }
+      , seq{ storage, N }
+    {
+    }
+
+    stack_rest_args(stack_rest_args const &) = delete;
+    stack_rest_args(stack_rest_args &&) = delete;
+
+    operator object_ref() const
+    {
+      return runtime::detail::untagged(&seq);
+    }
+
+    object_ref storage[N];
+    native_array_sequence seq;
+  };
+
+  template <typename... Args>
+  static stack_rest_args<sizeof...(Args)> make_stack_rest(Args const &...args)
+  {
+    return stack_rest_args<sizeof...(Args)>{ args... };
+  }
+
+/* The rest args of a call: on the stack when the fn's rest param does not escape, else one
+ * GC allocation. */
+#define JANK_REST_ARGS(...)                                                              \
+  (is_rest_noescape(arity_flags)                                                         \
+     ? object_ref{ make_stack_rest(__VA_ARGS__) }                                        \
+     : object_ref{ obj::native_array_sequence::create_packed(__VA_ARGS__) })
+
   /* TODO: Share this, rather than dupe it. */
   template <typename F, typename... Args>
   object_ref do_call(F const fn, jit_variadic_function const * const obj, Args... args)
