+  /* Bit 5 of a variadic fn's arity flags (bits 4 and 5 were unused): the compiler proved that
+   * the variadic arity's rest param does not escape its body, so a call may pass the rest args
+   * as a sequence on the caller's stack. */
+  static constexpr callable_arity_flags rest_noescape_flag{ 0b00100000 };
+
+  static constexpr bool is_rest_noescape(callable_arity_flags const arity_flags)
+  {
+    return (arity_flags & rest_noescape_flag);
+  }
+
