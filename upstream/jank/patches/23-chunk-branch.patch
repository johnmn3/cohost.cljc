      * made a chunked lazy pipeline realize its whole chain recursively at the first seq call
      * (a segfault at about 1e6 elements on the unpatched tree with (range 0.0 1e6)). The
@@ -1200,6 +1213,107 @@ namespace jank::runtime
     return make_box<obj::chunked_cons>(chunk, rest);
   }
 
+  /* Calls fn on each element of a chunk, in order: straight over an array_chunk's storage, by
+   * nth otherwise. */
+  template <typename F>
+  static void each_chunk_item(object_ref const chunk, F &&fn)
+  {
+    if(chunk.get_type() == object_type::array_chunk)
+    {
+      auto const c(expect_object<obj::array_chunk>(chunk));
+      for(usize i{ c->offset }; i < c->size; ++i)
+      {
+        fn(c->items[i]);
+      }
+      return;
+    }
+    auto const n(sequence_length(chunk));
+    for(usize i{}; i < n; ++i)
+    {
+      fn(nth(chunk, make_box(static_cast<i64>(i))));
+    }
+  }
+
+  object_ref chunk_map(object_ref const f, object_ref const chunk)
+  {
+    if(chunk.get_type() == object_type::array_chunk)
+    {
+      /* The common case: one block for the new chunk, f's results written straight into it. */
+      auto const c(expect_object<obj::array_chunk>(chunk));
+      auto const n{ c->size - c->offset };
+      auto const in{ c->items + c->offset };
+      auto ret{ obj::array_chunk::create(n) };
+      auto const out{ ret->storage() };
+      for(usize i{}; i < n; ++i)
+      {
+        out[i] = f.call(in[i]);
+      }
+      ret->size = n;
+      return ret;
+    }
+    native_vector<object_ref> out;
+    out.reserve(sequence_length(chunk));
+    each_chunk_item(chunk, [&](object_ref const e) { out.emplace_back(f.call(e)); });
+    return make_box<obj::array_chunk>(std::move(out), static_cast<usize>(0));
+  }
+
+  /* pred's result as a condition: the booleans by identity first (odd?, even?, pos? and the
+   * like return the two singletons), then the general rule. */
+  static bool keeps(object_ref const r)
+  {
+    if(r == jank_true)
+    {
+      return true;
+    }
+    if(r == jank_false)
+    {
+      return false;
+    }
+    return truthy(r);
+  }
+
+  object_ref chunk_filter(object_ref const pred, object_ref const chunk)
+  {
+    constexpr usize staged_max{ 64 };
+    if(chunk.get_type() == object_type::array_chunk)
+    {
+      auto const c(expect_object<obj::array_chunk>(chunk));
+      auto const n{ c->size - c->offset };
+      if(n <= staged_max)
+      {
+        /* The kept elements are staged on the stack (the source chunk keeps them alive), then
+         * copied into one block of exactly their size. */
+        auto const in{ c->items + c->offset };
+        object_ref const *kept[staged_max];
+        usize k{};
+        for(usize i{}; i < n; ++i)
+        {
+          if(keeps(pred.call(in[i])))
+          {
+            kept[k++] = in + i;
+          }
+        }
+        auto ret{ obj::array_chunk::create(k) };
+        auto const out{ ret->storage() };
+        for(usize i{}; i < k; ++i)
+        {
+          out[i] = *kept[i];
+        }
+        ret->size = k;
+        return ret;
+      }
+    }
+    native_vector<object_ref> out;
+    out.reserve(sequence_length(chunk));
+    each_chunk_item(chunk, [&](object_ref const e) {
+      if(keeps(pred.call(e)))
+      {
+        out.emplace_back(e);
+      }
+    });
+    return make_box<obj::array_chunk>(std::move(out), static_cast<usize>(0));
+  }
+
   bool is_chunked_seq(object_ref const o)
   {
     /* TODO: Port visit_object: chunkable. */
