@@ -50,6 +51,28 @@ namespace jank::runtime::obj
   {
   }
 
+  array_chunk_ref array_chunk::create(usize const capacity)
+  {
+    constexpr usize align{ alignof(object_ref) };
+    constexpr usize box_size{ (sizeof(array_chunk) + align - 1) / align * align };
+    static_assert(alignof(array_chunk) <= alignof(std::max_align_t));
+    auto const mem{ static_cast<char *>(GC_malloc(box_size + capacity * sizeof(object_ref))) };
+    if(!mem)
+    {
+      throw std::bad_alloc{};
+    }
+    auto const ret{ ::new(static_cast<void *>(mem)) array_chunk{} };
+    /* The elements live in the same block: the box keeps them alive, and chunk_next()'s views
+     * name this chunk as their owner. */
+    ret->items = reinterpret_cast<object_ref const *>(mem + box_size);
+    return runtime::detail::untagged(ret);
+  }
+
+  object_ref *array_chunk::storage()
+  {
+    return const_cast<object_ref *>(items);
+  }
+
   array_chunk_ref array_chunk::chunk_next() const
   {
     if(offset == size)
