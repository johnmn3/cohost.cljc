+  static bool real_speculation_candidate(runtime::obj::persistent_list_ref const arity_list)
+  {
+    std::function<bool(runtime::object_ref)> scan;
+    scan = [&](runtime::object_ref const o) -> bool {
+      switch(o.get_type())
+      {
+        /* A real literal reads as a tagged small_real. */
+        case runtime::object_type::real:
+        case runtime::object_type::small_real:
+          return true;
+        case runtime::object_type::symbol:
+          {
