+    /* The in-place walk every runtime walker uses (`reduce`, `str`, `sort`, `vec`, `count` of a
+     * seq, equality, hashing, `apply`). It follows the ownership rule `object::next_in_place`
+     * documents: the walker owns the seq it advances in place, and it only ever owns a seq it
+     * got from `fresh_seq()` (or that `next_in_place()` handed back as the same object).
+     *
+     *   - `walk_begin` takes a seqable and returns its first seq, made with `fresh_seq()` once;
+     *     a lazy seq is realized and its inner seq is walked, so no lazy wrapper is stepped.
+     *   - `walk_next` steps the seq: with `next_in_place()` while the walker owns it, else with
+     *     `next()`. When the step lands on a different object (a shared tail, a cached next
+     *     chunk), that object is not owned: if it can step in place, the walker takes a
+     *     `fresh_seq()` of it (one allocation per hand-off, not per element); otherwise it is
+     *     stepped with `next()`, which never mutates.
+     *
+     * `owned` says which of the two steps applies to the returned seq. Both return nil when
+     * the walk is over. */
+    object_ref walk_begin(object_ref const s, bool &owned);
+    object_ref walk_next(object_ref const s, bool &owned);
+    /* Whether a seq the walker owns may be stepped with next_in_place(). */
+    bool steps_in_place(object_ref const s);
+    /* An object reached mid-walk: unwrap lazy seqs, take a fresh seq if it steps in place. */
+    object_ref walk_own(object_ref s, bool &owned);
+  }
+
+  /* A single-pass walk over any seqable. `T` is kept for the callers that name it; the walk
+   * itself is untyped, since a seq can hand off to a seq of another type (a cons onto a
