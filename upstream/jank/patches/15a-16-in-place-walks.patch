diff --git a/compiler+runtime/src/cpp/jank/runtime/sequence_range.cpp b/compiler+runtime/src/cpp/jank/runtime/sequence_range.cpp
index 28d247b5d..6f9615965 100644
--- a/compiler+runtime/src/cpp/jank/runtime/sequence_range.cpp
+++ b/compiler+runtime/src/cpp/jank/runtime/sequence_range.cpp
@@ -2,8 +2,89 @@
 
 namespace jank::runtime
 {
+  namespace detail
+  {
+    /* chunked_cons is left out: its next_in_place() does not hand off to its tail correctly
+     * at a chunk boundary, so the walk steps it with next(), as before. */
+    bool steps_in_place(object_ref const s)
+    {
+      return s.has_behavior(object_behavior::sequence_like_in_place)
+        && s.get_type() != object_type::chunked_cons;
+    }
+
+    object_ref walk_own(object_ref s, bool &owned)
+    {
+      owned = false;
+      while(s.is_some() && s.get_type() == object_type::lazy_sequence)
+      {
+        s = s.seq();
+      }
+      if(s.is_nil())
+      {
+        return {};
+      }
+      if(steps_in_place(s))
+      {
+        auto const fresh{ s.fresh_seq() };
+        if(fresh.is_nil())
+        {
+          return {};
+        }
+        owned = true;
+        return fresh;
+      }
+      return s;
+    }
+
+    object_ref walk_begin(object_ref const s, bool &owned)
+    {
+      owned = false;
+      if(s.is_nil())
+      {
+        return {};
+      }
+      if(s.get_type() == object_type::lazy_sequence)
+      {
+        return walk_own(s.seq(), owned);
+      }
+
+      /* One allocation for the whole walk: a collection makes a new seq, a seq copies itself. */
+      auto const fresh{ s.fresh_seq() };
+      if(fresh.is_nil())
+      {
+        return {};
+      }
+      if(fresh.get_type() == object_type::lazy_sequence)
+      {
+        return walk_own(fresh.seq(), owned);
+      }
+      owned = steps_in_place(fresh);
+      return fresh;
+    }
+
+    object_ref walk_next(object_ref const s, bool &owned)
+    {
+      if(owned)
+      {
+        auto n{ s.next_in_place() };
+        if(n.is_nil())
+        {
+          return {};
+        }
+        if(n == s)
+        {
+          return n;
+        }
+        /* Handed off to another object (a tail, a cached chunk): not ours until copied. */
+        return walk_own(n, owned);
+      }
+
+      return walk_own(s.next(), owned);
+    }
+  }
+
   sequence_range<object_ref> make_sequence_range(object_ref const s)
   {
-    return sequence_range<object_ref>{ s.is_some() ? s.seq() : s };
+    return sequence_range<object_ref>{ s };
   }
 }
