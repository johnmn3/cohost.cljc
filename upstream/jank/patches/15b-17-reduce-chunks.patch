+      /* Applies f; true once f returned a reduced (res is then its value). */
+      bool step(object_ref const e)
+      {
+        res = f.call(res, e);
+        if(res.get_type() == object_type::reduced)
+        {
+          res = expect_object<obj::reduced>(res)->val;
+          stopped = true;
