+      {
+        auto const head{ expect_object<obj::chunked_cons>(c.data)->head };
+        if(head.get_type() == object_type::array_chunk)
+        {
+          auto const chunk{ expect_object<obj::array_chunk>(head) };
+          if(chunk->offset < chunk->buffer->size())
+          {
+            c.chunk = head;
+            c.items = chunk->buffer->data();
+            c.pos = chunk->offset;
+            c.size = chunk->buffer->size();
+          }
+        }
+      }
+    }
+
+    void walk_cursor_begin(object_ref const s, walk_cursor &c)
+    {
+      if(s.is_some() && s.get_type() == object_type::chunked_cons)
+      {
+        /* Read through the chunk: nothing is stepped in place, so no copy is needed. */
+        cursor_at(c, s);
+        return;
+      }
+      c.items = nullptr;
+      c.chunk = jank_nil;
+      c.data = walk_begin(s, c.owned);
+      if(c.data.is_some() && c.data.get_type() == object_type::chunked_cons)
+      {
+        cursor_at(c, c.data);
+      }
+    }
+
+    void walk_cursor_next(walk_cursor &c)
+    {
+      if(c.items)
+      {
+        if(++c.pos < c.size)
+        {
+          return;
+        }
+        cursor_at(c, expect_object<obj::chunked_cons>(c.data)->tail);
+        return;
+      }
+
+      auto const n{ walk_next(c.data, c.owned) };
+      if(n.is_some() && n.get_type() == object_type::chunked_cons)
+      {
+        cursor_at(c, n);
+        return;
+      }
+      c.data = n;
+    }
+
+    object_ref walk_cursor_rest(walk_cursor const &c)
+    {
+      if(!c.items)
+      {
+        return c.data;
+      }
+      auto const typed{ expect_object<obj::chunked_cons>(c.data) };
+      auto const chunk{ expect_object<obj::array_chunk>(c.chunk) };
+      if(c.pos == chunk->offset)
+      {
+        return c.data;
+      }
+      /* The rest shares the chunk's buffer from the current element on. */
+      return make_box<obj::chunked_cons>(make_box<obj::array_chunk>(chunk->buffer, c.pos),
+                                         typed->tail);
+    }
+  }
+
   sequence_range<object_ref> make_sequence_range(object_ref const s)
   {
     return sequence_range<object_ref>{ s };
