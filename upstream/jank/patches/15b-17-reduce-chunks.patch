+  /* behavior::chunkable */
+  static std::pair<object_ref const *, object_ref const *>
+  leaf_at(runtime::detail::native_persistent_vector const &data, usize const index)
+  {
+    std::pair<object_ref const *, object_ref const *> ret{};
+    immer::for_each_chunk_p(data.begin() + static_cast<std::ptrdiff_t>(index),
+                            data.end(),
+                            [&](auto const first, auto const last) {
+                              ret = { first, last };
+                              return false;
+                            });
+    return ret;
+  }
+
+  array_chunk_ref persistent_vector_sequence::chunked_first() const
+  {
+    auto const [first, last](leaf_at(vec->data, index));
+    /* One copy of at most a leaf (32 refs) per chunk, into the chunk's shared buffer. */
+    native_vector<object_ref> buffer(first, last);
+    return make_box<array_chunk>(std::move(buffer), static_cast<usize>(0));
+  }
+
+  object_ref persistent_vector_sequence::chunked_next() const
+  {
+    auto const [first, last](leaf_at(vec->data, index));
+    auto const n{ index + static_cast<usize>(last - first) };
+    if(vec->data.size() <= n)
+    {
+      return {};
+    }
+    return make_box<persistent_vector_sequence>(vec, n);
+  }
 }
