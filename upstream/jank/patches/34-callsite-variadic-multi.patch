diff --git a/compiler+runtime/include/cpp/jank/runtime/core/call_direct.hpp b/compiler+runtime/include/cpp/jank/runtime/core/call_direct.hpp
new file mode 100644
index 00000000..71780459
--- /dev/null
+++ b/compiler+runtime/include/cpp/jank/runtime/core/call_direct.hpp
@@ -0,0 +1,199 @@
+#pragma once
+
+#include <tuple>
+#include <utility>
+
+#include <jank/runtime/core/call.hpp>
+#include <jank/runtime/core/seq.hpp>
+#include <jank/runtime/var.hpp>
+#include <jank/runtime/rtti.hpp>
+#include <jank/runtime/obj/jit_function.hpp>
+#include <jank/runtime/obj/jit_variadic_function.hpp>
+#include <jank/runtime/obj/multi_function.hpp>
+#include <jank/runtime/obj/native_array_sequence.hpp>
+
+/* jank-34: the call sites compiled code makes, at -Odirect-call, to a var whose def the
+ * analyzer saw: a variadic fn (call_variadic_direct) or a multimethod (call_multi_direct).
+ * Both read the fn object at every call and check its shape there, so a redefined var, a
+ * with-redefs or a binding to anything else takes call_fast, as before. */
+namespace jank::runtime
+{
+  namespace detail
+  {
+    template <usize N>
+    [[gnu::always_inline]]
+    inline auto variadic_arity(obj::jit_variadic_function const * const fn)
+    {
+      if constexpr(N == 1) { return fn->arity_1; }
+      else if constexpr(N == 2) { return fn->arity_2; }
+      else if constexpr(N == 3) { return fn->arity_3; }
+      else if constexpr(N == 4) { return fn->arity_4; }
+      else if constexpr(N == 5) { return fn->arity_5; }
+      else if constexpr(N == 6) { return fn->arity_6; }
+      else if constexpr(N == 7) { return fn->arity_7; }
+      else if constexpr(N == 8) { return fn->arity_8; }
+      else if constexpr(N == 9) { return fn->arity_9; }
+      else { return fn->arity_10; }
+    }
+
+    /* The rest args of one call on the caller's stack (29's stack_rest_args, here so a call
+     * site can build it): alive until the call returns. */
+    template <usize N>
+    struct direct_stack_rest
+    {
+      template <typename... Args>
+      explicit direct_stack_rest(Args const &...args)
+        : storage{ object_ref{ args }... }
+        , seq{ storage, N }
+      {
+      }
+
+      direct_stack_rest(direct_stack_rest const &) = delete;
+      direct_stack_rest(direct_stack_rest &&) = delete;
+
+      object_ref ref() const
+      {
+        return runtime::detail::untagged(&seq);
+      }
+
+      object_ref storage[N];
+      obj::native_array_sequence seq;
+    };
+
+    template <std::size_t P, typename F, typename Tuple, std::size_t... I, std::size_t... J>
+    [[gnu::always_inline]]
+    inline object_ref call_variadic_split(F const arity,
+                                          object_ref const self,
+                                          callable_arity_flags const flags,
+                                          Tuple const &args,
+                                          std::index_sequence<I...>,
+                                          std::index_sequence<J...>)
+    {
+      if constexpr(sizeof...(J) == 0)
+      {
+        return arity(self, object_ref{ std::get<I>(args) }..., object_ref{});
+      }
+      else
+      {
+        if(is_rest_noescape(flags))
+        {
+          direct_stack_rest<sizeof...(J)> const rest{ std::get<P + J>(args)... };
+          return arity(self, object_ref{ std::get<I>(args) }..., rest.ref());
+        }
+        return arity(self,
+                     object_ref{ std::get<I>(args) }...,
+                     object_ref{ obj::native_array_sequence::create_packed(
+                       object_ref{ std::get<P + J>(args) }...) });
+      }
+    }
+  }
+
+  /* A call to a var whose def is a variadic fn with P required params, with at least P args
+   * and no fixed arity of this count (the analyzer checked its def): when the fn object is a
+   * jit_variadic_function whose variadic arity still takes P required params (and, for
+   * exactly P args, has no fixed arity of P), call that arity's entry directly with the fixed
+   * args and the rest sequence (on the stack when the rest param does not escape, 29's), with
+   * no arity switch and no virtual call. Anything else takes call_fast. */
+  template <u8 P, typename... Args>
+  [[gnu::always_inline]]
+  inline object_ref call_variadic_direct(object_ref const f, Args const &...args)
+  {
+    constexpr usize n{ sizeof...(Args) };
+    static_assert(P <= n && n <= 10 && P < 10);
+    auto target{ f };
+    if(detail::is_tagged_pointer(target.raw()))
+    {
+      auto t{ target.ptr()->type };
+      if(t == object_type::deferred_cpp_function)
+      {
+        auto const deferred{ static_cast<obj::deferred_cpp_function *>(target.ptr()) };
+        if(deferred->realized.load(std::memory_order_acquire))
+        {
+          target = deferred->compiled_fn;
+          t = detail::is_tagged_pointer(target.raw()) ? target.ptr()->type : object_type::nil;
+        }
+      }
+      if(t == object_type::jit_variadic_function)
+      {
+        auto const fn{ static_cast<obj::jit_variadic_function *>(target.ptr()) };
+        auto const flags{ fn->arity_flags };
+        if(extract_variadic_arity_mask(flags) == mask_variadic_arity(P)
+           && (n > P || !is_variadic_ambiguous(flags)))
+        {
+          auto const arity{ detail::variadic_arity<P + 1>(fn) };
+          if(arity)
+          {
+            return detail::call_variadic_split<P>(arity,
+                                                  target,
+                                                  flags,
+                                                  std::forward_as_tuple(args...),
+                                                  std::make_index_sequence<P>{},
+                                                  std::make_index_sequence<n - P>{});
+          }
+        }
+      }
+    }
+    return call_fast(f, args...);
+  }
+
+  /* A call to a var that held a multimethod when the call was analyzed: when the fn object
+   * is a multi_function, the dispatch value is computed here (a get or a constant for a
+   * one-argument call whose defmulti dispatch is a keyword, a one-key get or a literal; the
+   * dispatch fn through call_fast otherwise), the method is read from the two cache entries
+   * when the hierarchy is the one the cache was built against and the dispatch value is the
+   * entry's (identical), else from multi_function::get_fn, and called through call_fast:
+   * one dynamic call per multimethod call. Anything else takes call_fast. */
+  template <typename... Args>
+  [[gnu::always_inline]]
+  inline object_ref call_multi_direct(object_ref const f, Args const &...args)
+  {
+    constexpr usize n{ sizeof...(Args) };
+    if constexpr(n >= 1 && n <= 10)
+    {
+      if(detail::is_tagged_pointer(f.raw()) && f.ptr()->type == object_type::multi_function)
+      {
+        auto const mf{ static_cast<obj::multi_function *>(f.ptr()) };
+        object_ref dispatch_val;
+        if constexpr(n == 1)
+        {
+          if(mf->dispatch_kind == obj::multi_function::dispatch_kind_key)
+          {
+            dispatch_val = runtime::get(object_ref{ std::get<0>(std::forward_as_tuple(args...)) },
+                                        mf->dispatch_key);
+          }
+          else if(mf->dispatch_kind == obj::multi_function::dispatch_kind_constant)
+          {
+            dispatch_val = mf->dispatch_key;
+          }
+          else
+          {
+            dispatch_val = call_fast(mf->dispatch, args...);
+          }
+        }
+        else
+        {
+          dispatch_val = call_fast(mf->dispatch, args...);
+        }
+
+        auto const h{ mf->hierarchy };
+        auto const current_hierarchy{ h.get_type() == object_type::var
+                                        ? expect_object<var>(h)->deref_inline()
+                                        : h.deref() };
+        if(mf->cached_hierarchy == current_hierarchy)
+        {
+          auto const cache(mf->method_cache);
+          for(auto const &slot : mf->last_method)
+          {
+            auto const last(slot.load(std::memory_order_acquire));
+            if(last && last->cache == cache && last->dispatch_val == dispatch_val)
+            {
+              return call_fast(last->method, args...);
+            }
+          }
+        }
+        return call_fast(mf->get_fn(dispatch_val), args...);
+      }
+    }
+    return call_fast(f, args...);
+  }
+}
