+    /* A native loop binding that recur gives a value of another kind is boxed: analyze the
+     * loop again with it boxed. Each round boxes at least one more binding, so this ends. */
+    native_vector<bool> boxed;
+    while(true)
+    {
+      auto const attempt{ static_box_cast<expr::let>(let_res.expect_ok()) };
+      bool more{};
+      boxed.resize(attempt->pairs.size());
+      for(usize i{}; i < attempt->loop_box_bindings.size() && i < boxed.size(); ++i)
+      {
+        if(attempt->loop_box_bindings[i] && !boxed[i])
+        {
+          boxed[i] = true;
+          more = true;
+        }
+      }
+      if(!more)
+      {
+        break;
+      }
+      loop_details = some(nullptr);
+      next_loop_box_bindings = boxed;
