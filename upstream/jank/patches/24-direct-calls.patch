diff --git a/compiler+runtime/include/cpp/jank/runtime/obj/jit_function.hpp b/compiler+runtime/include/cpp/jank/runtime/obj/jit_function.hpp
index 3b0733c61..df643c21d 100644
--- a/compiler+runtime/include/cpp/jank/runtime/obj/jit_function.hpp
+++ b/compiler+runtime/include/cpp/jank/runtime/obj/jit_function.hpp
@@ -144,3 +144,44 @@ namespace jank::runtime::obj
     lazy_meta meta;
   };
 }
+
+namespace jank::runtime
+{
+  /* The call compiled code makes at -Odirect-call (the default at -O3), and multi_function's
+   * dispatch and method calls. A jit_function's fixed arity is called through its arity
+   * pointer, inline, so the call costs no virtual dispatch and no small-number tag tests;
+   * anything else (a variadic fn, a keyword, a map, a missing arity, which throws) takes
+   * object_ref::call as before. The fn object is read at every call, so a redefined var, a
+   * with-redefs or a binding is seen at once: there is nothing to invalidate. */
+  template <typename... Args>
+  [[gnu::always_inline]]
+  inline object_ref call_fast(object_ref const f, Args const &...args)
+  {
+    constexpr auto n{ sizeof...(Args) };
+    if constexpr(n <= 10)
+    {
+      if(detail::is_tagged_pointer(f.raw()) && f.ptr()->type == object_type::jit_function)
+      {
+        auto const fn{ static_cast<obj::jit_function *>(f.ptr()) };
+        auto const arity{ [fn]() {
+          if constexpr(n == 0) { return fn->arity_0; }
+          else if constexpr(n == 1) { return fn->arity_1; }
+          else if constexpr(n == 2) { return fn->arity_2; }
+          else if constexpr(n == 3) { return fn->arity_3; }
+          else if constexpr(n == 4) { return fn->arity_4; }
+          else if constexpr(n == 5) { return fn->arity_5; }
+          else if constexpr(n == 6) { return fn->arity_6; }
+          else if constexpr(n == 7) { return fn->arity_7; }
+          else if constexpr(n == 8) { return fn->arity_8; }
+          else if constexpr(n == 9) { return fn->arity_9; }
+          else { return fn->arity_10; }
+        }() };
+        if(arity)
+        {
+          return arity(f, object_ref{ args }...);
+        }
+      }
+    }
+    return f.call(object_ref{ args }...);
+  }
+}
diff --git a/compiler+runtime/include/cpp/jank/runtime/obj/native_array_sequence.hpp b/compiler+runtime/include/cpp/jank/runtime/obj/native_array_sequence.hpp
index 6f13faef2..cab86237c 100644
--- a/compiler+runtime/include/cpp/jank/runtime/obj/native_array_sequence.hpp
+++ b/compiler+runtime/include/cpp/jank/runtime/obj/native_array_sequence.hpp
@@ -31,6 +31,28 @@ namespace jank::runtime::obj
     {
     }
 
+    /* One allocation for the sequence and its elements (the array lives right after the
+     * object; bdwgc runs with interior pointers recognized, so a `next` sharing `arr` keeps it
+     * alive). A variadic call's rest args are built this way: half the allocations of
+     * make_box<native_array_sequence>(...) plus make_array_box. */
+    template <typename... Args>
+    static oref<native_array_sequence> create_packed(object_ref const first, Args const &...rest)
+    {
+      constexpr usize n{ sizeof...(Args) + 1 };
+      static_assert(sizeof(native_array_sequence) % alignof(object_ref) == 0);
+      auto const mem{ static_cast<char *>(
+        GC_malloc(sizeof(native_array_sequence) + n * sizeof(object_ref))) };
+      if(!mem)
+      {
+        throw std::runtime_error{ "Unable to allocate a native_array_sequence" };
+      }
+      auto const storage{ reinterpret_cast<object_ref *>(mem + sizeof(native_array_sequence)) };
+      usize i{};
+      new(storage + i++) object_ref{ first };
+      (new(storage + i++) object_ref{ rest }, ...);
+      return new(mem) native_array_sequence{ storage, n };
+    }
+
     /* behavior::object_like */
     bool equal(object const &o) const override;
     void to_string(jtl::string_builder &buff) const override;
diff --git a/compiler+runtime/include/cpp/jank/runtime/var.hpp b/compiler+runtime/include/cpp/jank/runtime/var.hpp
index 4267917ad..b5a111db9 100644
--- a/compiler+runtime/include/cpp/jank/runtime/var.hpp
+++ b/compiler+runtime/include/cpp/jank/runtime/var.hpp
@@ -125,6 +125,18 @@ namespace jank::runtime
 
     /* behavior::deref */
     object_ref deref() override;
+    /* The deref compiled code emits: inline and non-virtual. A var with no thread binding
+     * anywhere (thread_bound is set once, by the first push_thread_bindings of it) reads its
+     * root; otherwise this is deref(). */
+    [[gnu::always_inline]]
+    object_ref deref_inline()
+    {
+      if(!thread_bound.load())
+      {
+        return root.load();
+      }
+      return deref();
+    }
 
     /* behavior::metadatable */
     var_ref with_meta(object_ref m);
