+      return false;
+    }
+
+    static native_set<jtl::immutable_string> const numeric_ops{
+      "+",     "-",  "*",    "/",   "<",   ">",   "<=",  ">=",  "=",    "==",  "inc",
+      "dec",   "zero?", "pos?", "neg?", "quot", "rem", "mod", "max", "min", "even?", "odd?"
+    };
+    auto const is_param{ [&](runtime::object_ref const o) {
+      return o.get_type() == runtime::object_type::symbol
+        && runtime::expect_object<runtime::obj::symbol>(o)->ns.empty()
+        && untyped.contains(runtime::expect_object<runtime::obj::symbol>(o)->name);
