+    static auto const tag_kw(__rt_ctx->intern_keyword("", "tag").expect_ok());
+    native_set<jtl::immutable_string> untyped;
+    for(auto const &p :
+        runtime::expect_object<runtime::obj::persistent_vector>(params_obj.unwrap())->data)
+    {
+      if(p.get_type() != runtime::object_type::symbol)
+      {
+        return false;
+      }
+      auto const sym(runtime::expect_object<runtime::obj::symbol>(p));
+      if(sym->name == "&")
