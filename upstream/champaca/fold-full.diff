+// Copyright (C) 2026  champaca contributors
+// SPDX-License-Identifier: GPL-3.0-or-later WITH Classpath-exception-2.0
+import java.lang.classfile.*;
+import java.lang.constant.*;
+import java.nio.file.*;
+import static java.lang.classfile.ClassFile.*;
+import static java.lang.constant.ConstantDescs.*;
+// A reference with no classpath bytes: each defining loader fails it differently.
+public class LoaderErrorGen {
+    public static void main(String[] args) throws Exception {
+        Path p = Path.of(args[0], "loaderbytes"); Files.createDirectories(p);
+        ClassDesc absent = ClassDesc.of("LoaderErrorAbsent");
+        Files.write(p.resolve("LoaderErrorAbsent.bin"), ClassFile.of().build(absent, b -> {
+            b.withFlags(ACC_PUBLIC | ACC_SUPER);
+            b.withMethodBody(INIT_NAME, MTD_void, ACC_PUBLIC, c -> { c.aload(0); c.invokespecial(CD_Object, INIT_NAME, MTD_void); c.return_(); });
+        }));
+        Files.write(p.resolve("LoaderErrorUser.bin"), ClassFile.of().build(ClassDesc.of("LoaderErrorUser"), b -> {
+            b.withFlags(ACC_PUBLIC | ACC_SUPER);
+            b.withMethodBody("run", MethodTypeDesc.of(CD_Object), ACC_PUBLIC | ACC_STATIC, c -> {
+                c.new_(absent); c.dup(); c.invokespecial(absent, INIT_NAME, MTD_void); c.areturn();
+            });
+        }));
+    }
+}
