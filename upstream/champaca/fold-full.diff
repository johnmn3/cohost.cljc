diff --git a/test/java/LoaderIdentityCheck.java b/test/java/LoaderIdentityCheck.java
new file mode 100644
index 0000000..ef83295
--- /dev/null
+++ b/test/java/LoaderIdentityCheck.java
@@ -0,0 +1,93 @@
+// Copyright (C) 2026  champaca contributors
+// SPDX-License-Identifier: GPL-3.0-or-later WITH Classpath-exception-2.0
+import java.io.InputStream;
+import java.lang.reflect.Array;
+
+// Classes are read as bytes, never loaded by the application loader.
+public class LoaderIdentityCheck {
+    static class Loader extends ClassLoader {
+        Loader(ClassLoader parent) { super(parent); }
+        Class<?> define(boolean unnamed) throws Exception {
+            return define("LoaderIdentityValue", unnamed);
+        }
+        Class<?> define(String name, boolean unnamed) throws Exception {
+            try (InputStream in = LoaderIdentityCheck.class.getResourceAsStream("/" + name + ".class")) {
+                byte[] b = in.readAllBytes();
+                return defineClass(unnamed ? null : name, b, 0, b.length);
+            }
+        }
+        protected Class<?> loadClass(String name, boolean resolve) throws ClassNotFoundException {
+            // The app loader must not load the fixture on our behalf.
+            if (name.equals("LoaderIdentityValue")) {
+                Class<?> c = findLoadedClass(name);
+                if (c != null) return c;
+                if (getParent() instanceof Loader) return getParent().loadClass(name);
+                throw new ClassNotFoundException(name);
+            }
+            return super.loadClass(name, resolve);
+        }
+    }
+    static void check(String label, boolean ok) {
+        System.out.println(label + ": " + ok);
+        if (!ok) throw new AssertionError(label);
+    }
+    public static void main(String[] args) throws Exception {
+        Loader a = new Loader(LoaderIdentityCheck.class.getClassLoader());
+        Loader b = new Loader(LoaderIdentityCheck.class.getClassLoader());
+        Class<?> x = a.define(false), y = b.define(true);
+        check("distinct definitions", x != y && x.getName().equals(y.getName()));
+        check("defining loaders", x.getClassLoader() == a && y.getClassLoader() == b);
+        for (Class<?> c : new Class<?>[] {x, y}) {
+            Object o = c.getConstructor().newInstance();
+            check("forName", Class.forName(c.getName(), false, c.getClassLoader()) == c);
+            check("signature-polymorphic descriptor", c.getMethod("exact").invoke(o) == o);
+            check("literal", c.getMethod("literal").invoke(o) == c);
+            check("field type", c.getDeclaredField("self").getType() == c);
+            check("method types", c.getDeclaredMethod("echo", c).getReturnType() == c);
+            check("constructor type", c.getDeclaredConstructor(c).getParameterTypes()[0] == c);
+            c.getField("self").set(o, o);
+            check("field value", c.getField("self").get(o) == o);
+            check("method value", c.getMethod("echo", c).invoke(o, o) == o);
+            java.lang.invoke.MethodHandles.Lookup lookup = java.lang.invoke.MethodHandles.publicLookup();
+            java.lang.invoke.MethodHandle h = lookup.findVirtual(c, "echo", java.lang.invoke.MethodType.methodType(c, c));
+            java.lang.invoke.MethodHandle ctor = lookup.findConstructor(c, java.lang.invoke.MethodType.methodType(void.class, c));
+            java.lang.invoke.MethodHandle get = lookup.findGetter(c, "self", c);
+            java.lang.invoke.MethodHandle set = lookup.findSetter(c, "self", c);
+            try {
+                check("method handle", h.invokeWithArguments(o, o) == o);
+                check("constructor handle", get.invokeWithArguments(ctor.invokeWithArguments(o)) == o);
+                set.invokeWithArguments(o, o);
+                check("field handle", get.invokeWithArguments(o) == o);
+            } catch (Throwable t) { throw new AssertionError(t); }
+            check("constructor value", c.getField("self").get(c.getConstructor(c).newInstance(o)) == o);
+            Class<?> ar = Array.newInstance(c, 0).getClass();
+            check("array identity", ar.getComponentType() == c && ar.getClassLoader() == c.getClassLoader());
+            check("array binary name", ar.getName().equals("[L" + c.getName() + ";"));
+            check("array forName", Class.forName(ar.getName(), false, c.getClassLoader()) == ar);
+            Class<?> matrix = Array.newInstance(c, 0, 0).getClass();
+            check("matrix identity", matrix.getComponentType() == ar
+                && Class.forName(matrix.getName(), false, c.getClassLoader()) == matrix);
+            check("array field", c.getField("values").getType() == ar);
+            check("array bytecode", c.getMethod("array").invoke(o).getClass() == ar);
+        }
+        check("static isolation", x.getField("count").getInt(null) == 1 && y.getField("count").getInt(null) == 1);
+        for (Loader l : new Loader[] {a, b}) {
+            try { l.define(true); throw new AssertionError("duplicate accepted"); }
+            catch (LinkageError expected) { System.out.println("same-loader duplicate: rejected"); }
+        }
+        Class<?> sx = a.define("LoaderIdentitySub", true);
+        Class<?> sy = b.define("LoaderIdentitySub", false);
+        check("superclass identity", sx.getSuperclass() == x && sy.getSuperclass() == y);
+        check("inherited method", sy.getMethod("echo", y).getReturnType() == y);
+        Loader child = new Loader(b);
+        check("parent delegation", child.loadClass(y.getName()) == y);
+        check("delegated forName", Class.forName(y.getName(), false, child) == y);
+        check("boot shared", Class.forName("java.lang.String", false, child) == String.class);
+        check("boot array shared", Class.forName("[Ljava.lang.String;", false, child) == String[].class);
+        Object other = y.getConstructor().newInstance();
+        try { x.getMethod("echo", x).invoke(x.getConstructor().newInstance(), other); throw new AssertionError("cross-loader argument"); }
+        catch (IllegalArgumentException expected) { System.out.println("cross-loader argument: rejected"); }
+        try { x.getField("self").set(x.getConstructor().newInstance(), other); throw new AssertionError("cross-loader field"); }
+        catch (IllegalArgumentException expected) { System.out.println("cross-loader field: rejected"); }
+    }
+}
