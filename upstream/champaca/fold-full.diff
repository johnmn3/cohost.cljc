@@ -0,0 +1,23 @@
+// Copyright (C) 2026  champaca contributors
+// SPDX-License-Identifier: GPL-3.0-or-later WITH Classpath-exception-2.0
+import clojure.java.api.Clojure;
+import clojure.lang.IFn;
+
+// eval creates a new DynamicClassLoader for each deftype and its compiler stub.
+public class ClojureDeftype {
+    public static void main(String[] args) {
+        IFn read = Clojure.var("clojure.core", "read-string");
+        IFn eval = Clojure.var("clojure.core", "eval");
+        Object form = read.invoke("(do (deftype LoaderIdentityType []) (LoaderIdentityType.))");
+        Object[] values = new Object[3];
+        for (int i = 0; i < values.length; i++) {
+            values[i] = eval.invoke(form);
+            System.out.println("definition " + i + ": " + values[i].getClass().getName());
+        }
+        boolean distinct = values[0].getClass() != values[1].getClass()
+                        && values[0].getClass() != values[2].getClass()
+                        && values[1].getClass() != values[2].getClass();
+        System.out.println("distinct classes: " + distinct);
+        if (!distinct) throw new AssertionError("constructors bound to a different loader");
+    }
+}
