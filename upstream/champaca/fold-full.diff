+// Copyright (C) 2026  champaca contributors
+// SPDX-License-Identifier: GPL-3.0-or-later WITH Classpath-exception-2.0
+public class LoaderErrorCacheCheck {
+    static class L extends ClassLoader {
+        final int mode;
+        L(int mode) { super(null); this.mode = mode; }
+        Class<?> define() throws Exception { return define("LoaderErrorUser"); }
+        Class<?> define(String n) throws Exception {
+            try (var in = LoaderErrorCacheCheck.class.getResourceAsStream("/loaderbytes/" + n + ".bin")) {
+                byte[] b = in.readAllBytes(); return defineClass(null, b, 0, b.length);
+            }
+        }
+        protected Class<?> loadClass(String n, boolean r) throws ClassNotFoundException {
+            if (n.equals("LoaderErrorAbsent")) {
+                if (mode == 0) throw new IllegalStateException("loader A");
+                if (mode == 1) throw new IllegalArgumentException("loader B");
+                Class<?> c = findLoadedClass(n);
+                if (c != null) return c;
+                try { return define(n); } catch (Exception e) { throw new ClassNotFoundException(n, e); }
+            }
+            return super.loadClass(n, r);
+        }
+    }
+    static void run(Class<?> c) throws Exception {
+        try { Object v = c.getMethod("run").invoke(null);
+              System.out.println("value loader: " + (v.getClass().getClassLoader() == c.getClassLoader())); }
+        catch (java.lang.reflect.InvocationTargetException e) { System.out.println(e.getCause().getClass().getName() + ": " + e.getCause().getMessage()); }
+    }
+    public static void main(String[] args) throws Exception {
+        Class<?> a = new L(0).define(), b = new L(1).define(), c = new L(2).define();
+        run(a); run(b); run(c); run(a); run(b);
+    }
+}
