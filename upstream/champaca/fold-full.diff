diff --git a/test/java/LoaderAssignabilityCheck.java b/test/java/LoaderAssignabilityCheck.java
new file mode 100644
index 0000000..b55f08b
--- /dev/null
+++ b/test/java/LoaderAssignabilityCheck.java
@@ -0,0 +1,161 @@
+// Copyright (C) 2026  champaca contributors
+// SPDX-License-Identifier: GPL-3.0-or-later WITH Classpath-exception-2.0
+import java.io.InputStream;
+import java.lang.reflect.Array;
+
+// Assignability is loader-qualified: a class is an instance of exactly the
+// interface definition its own hierarchy resolved, never of a same-named
+// definition from another loader (the protocol-redefinition gap: a reify
+// whose protocol was redefined under a new loader must satisfy the new
+// definition's checks, and only those). Fixtures are read as bytes, never
+// loaded by the application loader, except in the classpath-copy section,
+// where the application loader's own copies are the point.
+public class LoaderAssignabilityCheck {
+    static final String[] FIXTURES = {"AssignIface", "AssignSubIface", "AssignImpl", "AssignSubImpl", "AssignSub", "AssignUser"};
+    static class Loader extends ClassLoader {
+        Loader(ClassLoader parent) { super(parent); }
+        Class<?> define(String name) throws Exception {
+            try (InputStream in = LoaderAssignabilityCheck.class.getResourceAsStream("/" + name + ".class")) {
+                byte[] b = in.readAllBytes();
+                return defineClass(name, b, 0, b.length);
+            }
+        }
+        protected Class<?> loadClass(String name, boolean resolve) throws ClassNotFoundException {
+            for (String f : FIXTURES) {
+                if (name.equals(f)) {
+                    Class<?> c = findLoadedClass(name);
+                    if (c != null) return c;
+                    if (getParent() instanceof Loader) return getParent().loadClass(name);
+                    try { return define(name); }
+                    catch (Exception e) { throw new ClassNotFoundException(name, e); }
+                }
+            }
+            return super.loadClass(name, resolve);
+        }
+    }
+    // A loader that delegates everything: its own definitions come only
+    // from explicit define() calls (the classpath-copy section's loader).
+    static class DefiningLoader extends ClassLoader {
+        DefiningLoader(ClassLoader parent) { super(parent); }
+        Class<?> define(String name) throws Exception {
+            try (InputStream in = LoaderAssignabilityCheck.class.getResourceAsStream("/" + name + ".class")) {
+                byte[] b = in.readAllBytes();
+                return defineClass(name, b, 0, b.length);
+            }
+        }
+    }
+    static void check(String label, boolean ok) {
+        System.out.println(label + ": " + ok);
+        if (!ok) throw new AssertionError(label);
+    }
+    public static void main(String[] args) throws Exception {
+        Loader a = new Loader(LoaderAssignabilityCheck.class.getClassLoader());
+        Loader b = new Loader(LoaderAssignabilityCheck.class.getClassLoader());
+        Class<?> iA = a.define("AssignIface"), iB = b.define("AssignIface");
+        Class<?> cA = a.define("AssignImpl"),  cB = b.define("AssignImpl");
+        Object oA = cA.getConstructor().newInstance();
+        Object oB = cB.getConstructor().newInstance();
+        check("distinct ifaces", iA != iB);
+        check("isInstance same A", iA.isInstance(oA));
+        check("isInstance cross A-vs-B", !iA.isInstance(oB));
+        check("isInstance cross B-vs-A", !iB.isInstance(oA));
+        check("isInstance same B", iB.isInstance(oB));
+        check("assignable same A", iA.isAssignableFrom(cA));
+        check("assignable cross A-from-B", !iA.isAssignableFrom(cB));
+        check("assignable cross B-from-A", !iB.isAssignableFrom(cA));
+        check("assignable same B", iB.isAssignableFrom(cB));
+        check("impl interfaces identity", cA.getInterfaces()[0] == iA && cB.getInterfaces()[0] == iB);
+        // inherited interface through a subclass defined in each loader
+        Class<?> sA = a.define("AssignSub"), sB = b.define("AssignSub");
+        Object soA = sA.getConstructor().newInstance();
+        Object soB = sB.getConstructor().newInstance();
+        check("sub isInstance same A", iA.isInstance(soA));
+        check("sub isInstance cross B-vs-A", !iB.isInstance(soA));
+        check("sub isInstance same B", iB.isInstance(soB));
+        // subinterface: an impl of the subinterface is an instance of the base
+        Class<?> siA = a.define("AssignSubIface"), siB = b.define("AssignSubIface");
+        Class<?> scA = a.define("AssignSubImpl"), scB = b.define("AssignSubImpl");
+        Object scoA = scA.getConstructor().newInstance();
+        Object scoB = scB.getConstructor().newInstance();
+        check("subiface isInstance base A", iA.isInstance(scoA));
+        check("subiface isInstance base cross", !iB.isInstance(scoA));
+        check("subiface isInstance sub A", siA.isInstance(scoA));
+        check("subiface isInstance sub cross", !siA.isInstance(scoB));
+        check("base assignable from subiface same", iA.isAssignableFrom(siA));
+        check("base assignable from subiface cross", !iA.isAssignableFrom(siB));
+        check("subiface assignable from subimpl same", siA.isAssignableFrom(scA));
+        check("subiface assignable from subimpl cross", !siA.isAssignableFrom(scB));
+        check("subiface interfaces identity", siA.getInterfaces()[0] == iA && siB.getInterfaces()[0] == iB);
+        // bytecode instanceof / checkcast in a class defined per loader
+        Class<?> uA = a.define("AssignUser"), uB = b.define("AssignUser");
+        check("bytecode instanceof A same", (Boolean) uA.getMethod("isIface", Object.class).invoke(null, oA));
+        check("bytecode instanceof A cross", !(Boolean) uA.getMethod("isIface", Object.class).invoke(null, oB));
+        check("bytecode instanceof B same", (Boolean) uB.getMethod("isIface", Object.class).invoke(null, oB));
+        check("bytecode instanceof B cross", !(Boolean) uB.getMethod("isIface", Object.class).invoke(null, oA));
+        check("bytecode instanceof subiface A same", (Boolean) uA.getMethod("isSubIface", Object.class).invoke(null, scoA));
+        check("bytecode instanceof subiface A cross", !(Boolean) uA.getMethod("isSubIface", Object.class).invoke(null, scoB));
+        try { uA.getMethod("castIface", Object.class).invoke(null, oB); throw new AssertionError("bytecode cast cross"); }
+        catch (java.lang.reflect.InvocationTargetException e) {
+            if (!(e.getCause() instanceof ClassCastException)) throw new AssertionError("bytecode cast cross", e);
+            System.out.println("bytecode cast cross: rejected");
+        }
+        check("bytecode cast same", uA.getMethod("castIface", Object.class).invoke(null, oA) == oA);
+        try { iB.cast(oA); throw new AssertionError("Class.cast cross"); }
+        catch (ClassCastException e) { System.out.println("Class.cast cross: rejected"); }
+        check("Class.cast same", iA.cast(oA) == oA);
+        // arrays of a loader-qualified element type
+        Object arrA = Array.newInstance(cA, 1);
+        Class<?> iArrA = Array.newInstance(iA, 0).getClass();
+        Class<?> iArrB = Array.newInstance(iB, 0).getClass();
+        check("array isInstance same", iArrA.isInstance(arrA));
+        check("array isInstance cross", !iArrB.isInstance(arrA));
+        check("array assignable same", iArrA.isAssignableFrom(arrA.getClass()));
+        check("array assignable cross", !iArrB.isAssignableFrom(arrA.getClass()));
+        check("array forName identity", Class.forName("[LAssignIface;", false, a) == iArrA);
+        check("array component", iArrA.getComponentType() == iA && iArrB.getComponentType() == iB);
+        // a third definition of the same name: only the diagonal holds
+        Loader c = new Loader(LoaderAssignabilityCheck.class.getClassLoader());
+        Class<?> iC = c.define("AssignIface");
+        Class<?> cC = c.define("AssignImpl");
+        Object oC = cC.getConstructor().newInstance();
+        check("three-way diagonal A", iA.isInstance(oA) && !iB.isInstance(oA) && !iC.isInstance(oA));
+        check("three-way diagonal B", iB.isInstance(oB) && !iA.isInstance(oB) && !iC.isInstance(oB));
+        check("three-way diagonal C", iC.isInstance(oC) && !iA.isInstance(oC) && !iB.isInstance(oC));
+        // a subclass in a child loader inherits the parent loader's interface
+        Loader child = new Loader(a);
+        Class<?> subChild = child.define("AssignSub");
+        Object oSub = subChild.getConstructor().newInstance();
+        check("child sub isInstance parent iface", iA.isInstance(oSub));
+        check("child sub isInstance other iface", !iB.isInstance(oSub));
+        check("child sub superclass is parent impl", subChild.getSuperclass() == cA);
+        // classpath copy: a custom loader took the name first; the app
+        // loader's own copies stay assignability-isolated from it
+        DefiningLoader l = new DefiningLoader(LoaderAssignabilityCheck.class.getClassLoader());
+        Class<?> iL = l.define("AssignIface");
+        Class<?> cL = l.define("AssignImpl");
+        Object oL = cL.getConstructor().newInstance();
+        Class<?> iApp = Class.forName("AssignIface");
+        Class<?> cApp = Class.forName("AssignImpl");
+        Object oApp = cApp.getConstructor().newInstance();
+        check("app iface is app-loaded", iApp.getClassLoader() == LoaderAssignabilityCheck.class.getClassLoader());
+        check("copies distinct", iL != iApp && cL != cApp);
+        check("custom isInstance own", iL.isInstance(oL));
+        check("custom isInstance app impl", !iL.isInstance(oApp));
+        check("app isInstance own", iApp.isInstance(oApp));
+        check("app isInstance custom impl", !iApp.isInstance(oL));
+        check("app assignable own", iApp.isAssignableFrom(cApp));
+        check("app assignable custom", !iApp.isAssignableFrom(cL));
+        check("custom assignable own", iL.isAssignableFrom(cL));
+        check("custom assignable app", !iL.isAssignableFrom(cApp));
+        check("app impl interfaces identity", cApp.getInterfaces()[0] == iApp);
+        check("custom impl interfaces identity", cL.getInterfaces()[0] == iL);
+        // a loader that already resolved a name by delegation cannot then
+        // define its own class of that name (HotSpot: LinkageError)
+        DefiningLoader m = new DefiningLoader(LoaderAssignabilityCheck.class.getClassLoader());
+        Class<?> mc = m.define("AssignImpl");
+        check("delegated impl iface is app iface", mc.getInterfaces()[0] == iApp);
+        try { m.define("AssignIface"); throw new AssertionError("own define after delegation"); }
+        catch (LinkageError e) { System.out.println("own define after delegation: rejected"); }
+        System.out.println("LoaderAssignabilityCheck done");
+    }
+}
