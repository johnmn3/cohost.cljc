+++ b/test/java/LoaderBoundaryCheck.java
@@ -0,0 +1,56 @@
+// Copyright (C) 2026  champaca contributors
+// SPDX-License-Identifier: GPL-3.0-or-later WITH Classpath-exception-2.0
+import java.lang.invoke.*;
+public class LoaderBoundaryCheck {
+    static class L extends ClassLoader {
+        L(ClassLoader p) { super(p); }
+        Class<?> define(String n) throws Exception {
+            try (var in = LoaderBoundaryCheck.class.getResourceAsStream("/" + n + ".class")) {
+                byte[] b = in.readAllBytes(); return defineClass(n, b, 0, b.length);
+            }
+        }
+        protected Class<?> loadClass(String n, boolean r) throws ClassNotFoundException {
+            Class<?> c = findLoadedClass(n);
+            return c != null ? c : super.loadClass(n, r);
+        }
+    }
+    static void check(String n, boolean v) { System.out.println(n + ": " + v); if (!v) throw new AssertionError(n); }
+    public static void main(String[] args) throws Throwable {
+        String n = "LoaderBoundaryType";
+        L a = new L(null), b = new L(a);
+        Class<?> x = a.define(n), y = args.length == 0 ? b.define(n) : x;
+        a.define("LoaderBoundaryParent").getDeclaredMethods();
+        if (args.length != 0) {
+            b.define("LoaderBoundaryChild").getDeclaredMethods();
+            System.out.println("constraint primed");
+            return;
+        }
+        try { b.define("LoaderBoundaryChild").getDeclaredMethods(); throw new AssertionError("constraint accepted"); }
+        catch (LinkageError e) {
+            System.out.println("constraint: " + e.getClass().getName());
+            check("constraint diagnostic", e.getMessage().startsWith("loader constraint violation"));
+        }
+        try { MethodHandles.publicLookup().findStatic(y, "identity", MethodType.methodType(x, x)); throw new AssertionError("alias accepted"); }
+        catch (ReflectiveOperationException e) {
+            System.out.println(e.getClass().getName() + ": " + e.getMessage());
+            System.out.println(e.getCause().getClass().getName() + ": " + e.getCause().getMessage());
+        }
+        Object o = y.getConstructor().newInstance();
+        check("right method type", MethodHandles.publicLookup().findStatic(y, "identity", MethodType.methodType(y, y)).invokeWithArguments(o) == o);
+        ClassLoader app = LoaderBoundaryCheck.class.getClassLoader();
+        Class<?> z = Class.forName(n, false, app);
+        check("classpath separate", z != x && z != y && z.getName().equals(x.getName()));
+        check("classpath loader", z.getClassLoader() == app);
+        check("classpath lookup cached", Class.forName(n, false, app) == z);
+        Object zo = z.getConstructor().newInstance();
+        check("classpath self reference", z.getMethod("literal").invoke(zo) == z);
+        check("classpath caller", Class.forName("LoaderClasspathCaller").getMethod("literal").invoke(null) == z);
+        try { Class.forName(n, false, new L(null)); throw new AssertionError("sibling visible"); }
+        catch (ClassNotFoundException e) { System.out.println("sibling invisible"); }
+        L initiated = new L(a);
+        check("delegated initiation", Class.forName(n, false, initiated) == x);
+        try { initiated.define(n); throw new AssertionError("initiated duplicate accepted"); }
+        catch (LinkageError e) { System.out.println("initiating loader duplicate rejected"); }
+        check("boot still shared", Class.forName("java.lang.String", false, b) == String.class);
+    }
+}
