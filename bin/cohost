#!/usr/bin/env bb
;; cohost — stock Clojure 1.12 on a host of your choice, with tools.deps.
;;
;;   cohost :<host> <clojure CLI args...>
;;
;; The first argument names the runtime; everything after it is the Clojure
;; CLI's own surface: -Sdeps, -A/-M/-X aliases (with their :main-opts,
;; :exec-fn and :exec-args), -e, -i, -m, a script, -, -r, -X fn kvs, -Spath,
;; -P, -Sdescribe. deps.edn in the current directory is resolved with
;; tools.deps (through the Clojure CLI, the resolver `clj` uses); every
;; classpath entry becomes a cohost source root — directories as they are,
;; jars extracted under ~/.cache/cohost/deps — so booted code's `require`
;; finds dependency namespaces through cohost's ordinary loader. :jvm is the
;; :clj leg: `clojure` on PATH runs the real Clojure CLI, unchanged. Without
;; that command, jolt resolves the classpath and lib/champaca runs clojure.main
;; (bin/cohost_clj_body.clj). -T and -Sdescribe stay on `clojure`.
;;
;; Design, what's supported and what isn't: doc/CLI.md.
(require '[babashka.fs :as fs]
         '[babashka.process :as p]
         '[clojure.edn :as edn]
         '[clojure.string :as str]
         '[clojure.java.io :as io])

;; dir/p, or p itself when it is absolute (babashka.fs before 0.5 refuses an
;; absolute second argument: "... is not a relative path")
(defn under [dir p] (if (fs/absolute? p) (fs/path p) (fs/path dir p)))

(def script-file (fs/canonicalize *file*))
(load-file (str (fs/parent script-file) "/cohost_clj_body.clj"))
(def repo (str (fs/parent (fs/parent script-file))))
(def stock-root (str repo "/resources/cohost/clojure-1.12.0"))
(def cache-dir (str (fs/home) "/.cache/cohost"))

(def wired ["cljs" "jolt" "lpy" "cljw" "phel" "lg" "jank" "squint"])

;; the program each wired host runs, and how to get it
(def host-bins
  {"cljs" ["node" "node 18+ (https://nodejs.org, or: brew install node)"]
   "jolt" ["jolt" "bash dev/install/jolt.sh"]
   "lpy" ["basilisp" "bash dev/install/basilisp.sh"]
   "cljw" ["cljw" "bash dev/install/cljw.sh"]
   "phel" ["phel" "bash dev/install/phel.sh"]
   "lg" ["lg" "bash dev/install/lg.sh"]
   "jank" ["jank" "bash dev/install/jank.sh"]
   "squint" ["node" "node 18+ (https://nodejs.org, or: brew install node)"]})

(def path-sep java.io.File/pathSeparator)
(def hosts (set (concat ["jvm" "cljrs"] wired)))

(defn die [code & lines]
  (doseq [l lines] (binding [*out* *err*] (println l)))
  (System/exit code))

(defn usage []
  (die 2
       "usage: cohost [:<target>] <clojure CLI args...>"
       "  the target: :<target> first, else :cohost/target in ./deps.edn, else :jank"
       (str "  hosts: :jvm " (str/join " " (map #(str ":" %) wired)) "   (:cljrs not wired yet)")
       "  e.g. cohost :cljs -e \"(+ 1 2)\""
       "       cohost :cljs -M -m demo.main arg1"
       "       cohost :jolt -X demo.core/run :x 1"
       "       cohost :cljs -Spath"
       "  :jvm is the :clj leg: `clojure` on PATH, else jolt's champaca backup."
       "  :jolt:lpy names several hosts; :clj in that string is the official clojure CLI."
       "  COHOST_CLJ_BODY=clojure|jolt."
       "  COHOST_CHAMPACA_SRC is champaca's jolt sources when this process's :clj leg is champaca."))

(defn run-inherit
  "Run cmd with inherited stdio in dir; -> its exit code. Every child sees
   COHOST_HOME, the checkout this script runs from (the cohost/app template
   reads it). extra is merged over that."
  [dir cmd & [extra]]
  (-> (p/process cmd {:dir dir :inherit true
                      :extra-env (merge {"COHOST_HOME" repo} extra)})
      deref :exit))

(defn sdeps-text
  "A -Sdeps value as data text. Since Clojure CLI 1.12.0.1530 the value
   may name a file, whose contents are the deps data. Consumers that
   parse the value themselves (jolt, merged-aliases, the -T template
   merge) read the file here; the real CLI is handed the value verbatim,
   file form included, exactly as stock."
  [s]
  (if (fs/exists? s) (slurp s) s))

(defn with-templates
  "The Clojure CLI's arguments for a tool (-T): cohost's deps-new templates
   (templates/cohost-app) on its classpath, merged into the -Sdeps the
   arguments carry (the CLI takes one)."
  [args]
  (let [lib {'cohost/templates {:local/root (str repo "/templates/cohost-app")}}
        i (.indexOf ^java.util.List args "-Sdeps")]
    (if (neg? i)
      (into ["-Sdeps" (pr-str {:deps lib})] args)
      (assoc args (inc i) (pr-str (update (edn/read-string (sdeps-text (nth args (inc i)))) :deps merge lib))))))

;; --------------------------------------------------------------------------
;; arguments, as the Clojure CLI's own script reads them: its options first,
;; then -M/-X/-T (or the first other argument) and what follows it

(defn parse-args [args]
  (loop [[a & more :as args] args
         o {:sdeps [] :resolve [] :aliases []}]
    (cond
      (nil? a) o
      (= a "-Sdeps") (recur (next more) (update o :sdeps conj (first more)))
      (= a "-Sthreads") (recur (next more) (update o :resolve conj a (first more)))
      (#{"-Srepro" "-Sforce"} a) (recur more (update o :resolve conj a))
      (= a "-Strace") (recur (next args) (update o :resolve conj "-Strace"))
      (= a "-Stree") (recur (next args) (assoc o :tree? true))
      (= a "-Spath") (recur more (assoc o :spath? true))
      (= a "-Sdescribe") (recur more (assoc o :describe? true))
      (= a "-Sverbose") (recur more (assoc o :verbose? true))
      (= a "-P") (recur more (assoc o :prepare? true))
      ;; JVM options mean nothing off the JVM
      (str/starts-with? a "-J") (recur more o)
      (re-matches #"-A(:.*)?" a) (recur more (update o :aliases conj a))
      (re-matches #"-M(:.*)?" a) (assoc o :mode :M :alias a :main more)
      (re-matches #"-X(:.*)?" a) (assoc o :mode :X :alias a :main more)
      (re-matches #"-T.*" a) (assoc o :mode :T)
      ;; anything else starts clojure.main's own arguments
      :else (assoc o :mode :M :main args))))

;; --------------------------------------------------------------------------
;; tools.deps resolution

(defn extract-jar!
  "Extract a jar's .clj/.cljc sources into the cache (once per jar
   version); -> the extracted directory as a source root."
  [jar]
  (let [f (io/file jar)
        key (format "%08x" (hash (str jar "|" (.length f) "|" (.lastModified f))))
        dir (fs/file cache-dir "deps" (str (str/replace (fs/file-name jar) #"\.jar$" "") "-" key))]
    (when-not (fs/exists? (fs/file dir ".cohost-done"))
      (fs/create-dirs dir)
      (with-open [zf (java.util.zip.ZipFile. f)]
        (doseq [e (enumeration-seq (.entries zf))
                :let [n (.getName e)]
                :when (and (not (.isDirectory e))
                           (or (str/ends-with? n ".clj") (str/ends-with? n ".cljc")))]
          (let [out (fs/file dir n)]
            (fs/create-dirs (fs/parent out))
            (io/copy (.getInputStream zf e) out))))
      (spit (fs/file dir ".cohost-done") ""))
    (str dir)))

(defn- program-start-failed?
  [e]
  (loop [x e]
    (cond (nil? x) false
          (instance? java.io.IOException x) true
          :else (recur (try (.getCause ^Throwable x) (catch Throwable _ nil))))))

(defn- run-resolver
  "Run a classpath command. A missing binary is a die, not an uncaught
   IOException from p/process."
  [cmd cwd]
  (try
    @(p/process cmd {:dir cwd :out :string :err :string})
    (catch Exception e
      (if (program-start-failed? e)
        (die 1
             (str "cohost: `" (first cmd) "` failed to start: " (.getMessage e))
             (str "  `" (first cmd) "` is not on PATH."))
        (throw e)))))

(defn- cp-entries
  "The last non-blank line of a -Spath stdout, split into absolute entries."
  [cwd out]
  (let [line (str/trim (or (last (remove str/blank? (str/split-lines (or out "")))) ""))]
    (mapv (fn [entry]
            (when-not (str/blank? entry)
              (str (fs/absolutize (under cwd entry)))))
          (str/split line (re-pattern (java.util.regex.Pattern/quote path-sep))))))

(defn- roots-of
  "Directories as they are, jars extracted. org.clojure/clojure's jar is
   left out: on a cohost host the runtime is the language."
  [entries]
  (vec (keep (fn [abs]
               (cond
                 (nil? abs) nil
                 (fs/directory? abs) abs
                 (and abs (str/ends-with? abs ".jar") (fs/exists? abs))
                 (when-not (re-find #"[/\\]org[/\\]clojure[/\\]clojure[/\\][^/\\]+[/\\]clojure-[^/\\]+\.jar$" abs)
                   (extract-jar! abs))
                 (and abs (fs/exists? abs))
                 (do (binding [*out* *err*]
                       (println (str "cohost: skipping classpath entry " abs)))
                     nil)
                 :else nil))
             entries)))

(defn resolve-deps
  "tools.deps resolution of the current directory's deps.edn, through the
   Clojure CLI (tools.deps' front end, so -Sdeps, aliases and the
   root/user/project config chain merge exactly as they do for `clj`).
   -> {:roots [...] :argmap {...}}: the source roots in classpath order —
   directories as they are, jars extracted; org.clojure/clojure's jar is
   left out, since the host runtime IS the language, booted from cohost's
   pinned stock sources — and the aliases' argmap (:main-opts, :exec-fn,
   :exec-args, :ns-default, :ns-aliases), read from the basis the CLI
   writes beside the classpath."
  [cwd {:keys [sdeps resolve aliases alias]}]
  (let [cmd (vec (concat ["clojure" "-Sverbose" "-Spath"] (mapcat (fn [d] ["-Sdeps" d]) sdeps)
                         resolve aliases (when alias [alias])))
        out (run-resolver cmd cwd)]
    (when-not (zero? (:exit out))
      (binding [*out* *err*] (print (:err out)) (flush))
      (die 1 (str "cohost: tools.deps resolution failed (" (str/join " " cmd) ")")))
    (let [lines (str/split-lines (:out out))
          cp-file (some #(second (re-matches #"cp_file\s*=\s*(.*)" %)) lines)
          basis (when cp-file (fs/file (under cwd (str/replace cp-file #"\.cp$" ".basis"))))
          basis-edn (when (and basis (fs/exists? basis))
                      (edn/read-string {:default tagged-literal} (slurp basis)))
          entries (cp-entries cwd (:out out))]
      {:argmap (:argmap basis-edn)
       :basis basis-edn
       :entries (vec (remove nil? entries))
       :roots (roots-of entries)})))

(declare jolt-alias-args alias-argmap)

(defn dep-version [coord]
  (or (:mvn/version coord) (:git/sha coord) (some-> (:local/root coord) str) ""))

(defn print-dep-tree
  "The -Stree answer, rendered natively from the delegated basis: roots
   are the basis's top-level deps in order; a lib's children are the libs
   whose :parents contain the chain from a root down to it. The basis
   does not keep a parent's POM declaration order, so siblings print in
   basis order; the graph and the versions are the resolver's own."
  [basis]
  (let [libs (:libs basis)]
    (letfn [(walk [chain lib depth]
              (println (str (apply str (repeat depth "  "))
                            (when (pos? depth) ". ")
                            lib " " (dep-version (get libs lib))))
              (doseq [[child _] (filter (fn [[_ e]] (contains? (:parents e) chain)) libs)]
                (walk (conj chain child) child (inc depth))))]
      (doseq [root (keys (:deps basis))]
        (walk [root] root 0)))))

(defn resolve-deps-jolt
  "Classpath for the native jolt adapter when `clojure` is not on PATH.
   jolt -Srepro -Spath (plus the command's alias flags) is the no-JVM
   resolver the champaca leg already uses. jolt does not write the CLI's
   .basis, so :argmap comes from deps.edn the same way that leg reads
   aliases. Roots are still directories and extracted jars: cohost.cli
   loads source from those roots. The clojure jar stays out of :roots;
   champaca's classpath keeps every entry, and the bundle's app jars
   supply Clojure."
  [cwd o]
  (let [bin (or (fs/which "jolt")
                (die 1 "cohost: :jolt resolves its classpath with `jolt`, which is not on PATH."))
        cmd (into [(str bin) "-Srepro" "-Spath"] (jolt-alias-args o))
        out (run-resolver cmd cwd)]
    (when-not (zero? (:exit out))
      (binding [*out* *err*] (print (:err out)) (flush))
      (die 1 (str "cohost: jolt classpath resolution failed (" (str/join " " cmd) ")")))
    (let [entries (cp-entries cwd (:out out))]
      {:argmap (alias-argmap cwd o)
       :entries (vec (remove nil? entries))
       :roots (roots-of entries)})))

;; --------------------------------------------------------------------------
;; clojure.main's arguments, and clojure.run.exec's

(defn abs-path [cwd f] (str (fs/absolutize (under cwd f))))

(defn main-config
  "clojure.main's arguments: init options (-i/--init, -e/--eval, in the
   order given), then one main option. -> {:inits [...] :main {...}|nil}"
  [cwd args]
  (loop [[a b & more :as args] args inits []]
    (cond
      (nil? a) {:inits inits :main (when (empty? inits) {:type :repl})}
      (#{"-i" "--init"} a) (recur more (conj inits [:i (abs-path cwd b)]))
      (#{"-e" "--eval"} a) (recur more (conj inits [:e b]))
      (#{"-m" "--main"} a) {:inits inits :main {:type :main :ns b :args (vec more)}}
      (#{"-r" "--repl"} a) {:inits inits :main {:type :repl}}
      (= "-" a) {:inits inits :main {:type :stdin :args (vec (rest args))}}
      (#{"-h" "--help" "-?"} a) (usage)
      (str/starts-with? a "-") (die 2 (str "cohost: unknown option " a))
      :else {:inits inits :main {:type :script :path (abs-path cwd a) :args (vec (rest args))}})))

(defn exec-config
  "clojure.run.exec's arguments: an optional fn symbol, then key value pairs
   (a vector key is a path) and an optional trailing map, merged over the
   aliases' :exec-args. -> the :exec main."
  [args argmap]
  (let [vals (mapv #(try (edn/read-string %)
                         (catch Exception _ (die 2 (str "cohost: unreadable -X argument " %))))
                   args)
        [f kvs] (if (symbol? (first vals)) [(first vals) (rest vals)] [nil vals])
        f (or f (:exec-fn argmap)
              (die 2 "No function found on command line or in :exec-fn"))
        f (cond (namespace f) (let [ns (symbol (namespace f))]
                                (symbol (str (get (:ns-aliases argmap) ns ns)) (name f)))
                (:ns-default argmap) (symbol (str (:ns-default argmap)) (name f))
                :else (die 2 (str "cohost: unqualified function " f " and no :ns-default")))
        [pairs trailing] (if (odd? (count kvs)) [(butlast kvs) (last kvs)] [kvs nil])
        exec-args (merge (reduce (fn [m [k v]] (if (vector? k) (assoc-in m k v) (assoc m k v)))
                                 (or (:exec-args argmap) {})
                                 (partition 2 pairs))
                         trailing)]
    {:type :exec :ns (namespace f) :fn (name f) :args-edn (pr-str exec-args)}))

;; --------------------------------------------------------------------------
;; host launches

(defn ensure-cljs-build! []
  (let [lm (fn [f] (.toMillis (fs/last-modified-time f)))
        out (fs/file repo "target/cljs-cli/main.js")
        stale? (or (not (fs/exists? out))
                   (> (lm (fs/file repo "cljs-cli.edn")) (lm out))
                   (boolean (some (fn [f] (> (lm f) (lm out)))
                                  (fs/glob (fs/file repo "src") "**.{cljc,cljs}"))))]
    (when stale?
      (binding [*out* *err*] (println "cohost: compiling the ClojureScript host build (target/cljs-cli) ..."))
      ;; cljs-cli.edn's relative output paths are load-bearing: the nodejs
      ;; bootstrap joins the output-dir onto the process's directory, so the
      ;; build — and the node launch — both run from the repo, and cohost.cli
      ;; moves to the project directory (:cwd).
      ;; unit 8: Eve is in the build (cohost.hosts.cljs-eve): its hosts.edn
      ;; :cljs row joins the classpath (dev/eve-cljs/eve_paths.clj), merged
      ;; with COHOST_CLI_SDEPS; the git dep is fetched first when absent
      (let [_ (load-file (str repo "/dev/eve-cljs/eve_paths.clj"))
            _ (when-not (fs/exists? ((resolve 'eve-paths/eve-checkout-dir) repo))
                (run-inherit repo ["clojure" "-P" "-M:cljs"]))
            sdeps ((resolve 'eve-paths/eve-cljs-build-sdeps) repo (System/getenv "COHOST_CLI_SDEPS"))
            cmd (vec (concat ["clojure" "-Sdeps" sdeps]
                             ["-M:cljs" "-m" "cljs.main" "-co" "cljs-cli.edn" "-c"]))]
        (when-not (zero? (run-inherit repo cmd))
          (die 1 "cohost: cljs build failed"))))))

(defn ensure-squint-build! []
  ;; The squint body is a compiled body like cljs: the whole
  ;; cohost + Eve graph is staged and compiled by squint ahead of
  ;; time (dev/build_squint.clj) into target/squint-cli; node runs
  ;; its main.mjs with the cfg. Eve comes from the same pinned git
  ;; dep the cljs build uses; its hosts.edn :squint row names the
  ;; adapter roots. Rebuilds when any source under src/ or the
  ;; Eve checkout's squint roots is newer than the build stamp.
  (let [work (fs/file repo "target/squint-cli")
        main (fs/file work "main.mjs")
        _ (load-file (str repo "/dev/eve-cljs/eve_paths.clj"))
        eve-dir ((resolve 'eve-paths/eve-checkout-dir) repo)]
    (when-not (fs/exists? eve-dir)
      (run-inherit repo ["clojure" "-P" "-M:cljs"]))
    (let [hosts-edn (fs/file eve-dir "hosts.edn")
          row (when (fs/exists? hosts-edn)
                (get (clojure.edn/read-string (slurp hosts-edn)) :squint))]
      (when-not row
        (die 1 (str "cohost: the pinned Eve checkout has no :squint row in hosts.edn"
                    " — the squint seat is not in this Eve pin yet")))
      (let [roots (into [(str repo "/src") (str eve-dir "/src")]
                        (map #(str eve-dir "/" %) row))
            lm (fn [f] (try (.toMillis (fs/last-modified-time f)) (catch Exception _ 0)))
            stale? (or (not (fs/exists? main))
                       (boolean (some (fn [f] (> (lm f) (lm main)))
                                      (mapcat #(fs/glob % "**.{cljc,cljs}") roots))))]
        (when stale?
          (binding [*out* *err*] (println "cohost: compiling the squint host build (target/squint-cli) ..."))
          (when-not (zero? (run-inherit repo (vec (concat ["bb" "dev/build_squint.clj"
                                                           (str work) "cohost.squint-main" (str eve-dir)]
                                                          roots))))
            (die 1 "cohost: squint build failed")))))))

(defn jank-aot-dir!
  "cohost's own namespaces compiled -O3 (jank-FAST Step 6 stage 1), rebuilt
   when src/cohost or the jank binary changed: dev/perf/jank_aot_ensure.clj,
   run from the repo (its paths are the repo's). -> the absolute cache dir."
  []
  (let [r (-> (p/process ["bb" "-e" "(println (str \"COHOST-AOT-DIR \" (load-file \"dev/perf/jank_aot_ensure.clj\")))"]
                         {:dir repo :out :string :err :inherit})
              deref)
        dir (some #(second (re-matches #"COHOST-AOT-DIR (.*)" %)) (str/split-lines (:out r)))]
    (when-not (and (zero? (:exit r)) dir)
      (die 1 "cohost: jank AOT modules failed (bb -e (load-file \"dev/perf/jank_aot_ensure.clj\") in the repo)"))
    (str (fs/absolutize (under repo dir)))))

(defn jank-introspect?
  "JANK_PRINT_CODEGEN / JANK_PRINT_IR ask jank to print each compiled
   function's generated code / IR. Under the snapshot — the compiled
   launcher, or run-main over the snapshot's objects — nothing compiles
   at run time, so the dump never happens (measured at the j gate:
   exit 0, no line naming cohost). An introspection run therefore
   takes the source boot, as a profile run takes the JIT path: the
   rewritten forms compile in the run and print as they go."
  []
  (let [on (fn [k] (let [v (System/getenv k)]
                     (and v (not= "0" v) (not= "" v))))]
    (boolean (or (on "JANK_PRINT_CODEGEN") (on "JANK_PRINT_IR")))))

(defn jank-launch
  "jank: the module path (a fresh snapshot of the booted core, else cohost's
   AOT objects), whether cohost.cli boots from the snapshot, and the jank
   process's extra environment (the GC setting): lane D's
   dev/perf/jank_snapshot_cli.clj, decided in the repo. With a fresh core
   snapshot and a main namespace (-m, -X), the project's namespaces come
   from a per-project snapshot, built when stale (D-8). An introspection
   run (JANK_PRINT_CODEGEN / JANK_PRINT_IR) overrides all of that to the
   source boot: cohost's AOT objects and core from src."
  [cwd roots run]
  (load-file (str repo "/dev/perf/jank_snapshot_cli.clj"))
  (let [l ((resolve 'jank-cli-launch) repo)
        main-ns (when (#{:main :exec} (get-in run [:main :type])) (get-in run [:main :ns]))
        ;; the launcher binary has no module path: it adds the per-project
        ;; snapshot's directories at run time (the config's :module-paths);
        ;; an introspection run skips the project snapshot too — its
        ;; namespaces also compile in the run, from source
        proj (when (and (:snapshot? l) (not (jank-introspect?)))
               ((resolve 'jank-project-launch) repo cwd roots main-ns (:module-path l) (:env l)))
        merged (merge l proj (when (and (:launcher l) proj) {:module-paths (:project-paths proj)}))]
    (if (jank-introspect?)
      (assoc merged :module-path (str (jank-aot-dir!) ":" repo "/src")
                    :snapshot? false)
      merged)))

(defn- lpy-fresh-src
  "basilisp's cached boot (dev/perf/lpy_snapshot_ensure.clj, decided in the repo):
   its modules' directory when fresh, else nil."
  []
  (let [r (p/shell {:dir repo :out :string :err :string :continue true} "bb" "-e"
                   "(load-file \"dev/perf/lpy_snapshot_ensure.clj\") (println \"LPY-SRC\" (or ((resolve 'lpy-fresh-src)) \"-\"))")
        l (last (filter #(str/starts-with? % "LPY-SRC ") (str/split-lines (:out r))))
        d (when l (subs l 8))]
    (when (and d (not= "-" d)) (str (fs/absolutize (fs/path repo d))))))

(defn lpy-launch
  "basilisp: boot from the cached boot when it is fresh; build it on first use (or
   after a cohost update), one build at a time, with one plain line (its output in
   target/lpy-snapshot.log). COHOST_LPY_SNAPSHOT=off: never. -> {:lpy-src dir
   :snapshot? true}, or nil (this run boots core.clj from source)."
  []
  (when-not (= "off" (System/getenv "COHOST_LPY_SNAPSHOT"))
    (or (when-let [d (lpy-fresh-src)] {:lpy-src d :snapshot? true})
        (let [lock (fs/file repo "target" "lpy-snapshot.lock")
              log (fs/file repo "target" "lpy-snapshot.log")]
          (fs/create-dirs (fs/parent lock))
          (when (and (fs/exists? lock)
                     (> (- (System/currentTimeMillis) (.toMillis (fs/last-modified-time lock))) (* 30 60 1000)))
            (fs/delete-tree lock))
          (binding [*out* *err*]
            (if-not (.mkdir lock)
              (do (println "cohost: basilisp's cached boot is being built by another cohost command; this one boots from source") nil)
              (try
                (println "cohost: building basilisp's cached boot (once per cohost update; about 2 to 4 minutes; log: target/lpy-snapshot.log) ...")
                (let [t0 (System/nanoTime)
                      r (p/shell {:dir repo :out (str log) :err (str log ".err") :continue true} "bb" "-e"
                                 "(load-file \"dev/perf/lpy_snapshot_ensure.clj\") ((resolve 'lpy-ensure!))")]
                  (if (zero? (:exit r))
                    (do (println (str "cohost: basilisp's cached boot is built (" (quot (- (System/nanoTime) t0) 1000000000) " s)"))
                        (when-let [d (lpy-fresh-src)] {:lpy-src d :snapshot? true}))
                    (do (println "cohost: the cached boot build failed (target/lpy-snapshot.log); this run boots from source") nil)))
                (finally (fs/delete-if-exists lock)))))))))

(defn launch-jolt-clj!
  "The :clj leg on champaca, used when `clojure` is not on PATH.
   Sibling of launch!, not a branch of it: the \"jolt\" branch below boots
   cohost.cli on jolt's native adapter, which is not champaca. main-args are
   clojure.main's arguments. jolt-args follow `jolt -Srepro -Spath`."
  [cwd main-args jolt-args]
  (cohost.clj-body/launch-jolt-clj! cwd main-args {:repo repo :jolt-args jolt-args}))

(defn launch! [host cwd config & [jank]]
  (let [cfg (str config)
        src (str repo "/src")]
    (case host
      ;; node starts in the repo, Phel too (its phel-config.php names the
      ;; source directories); cohost.cli moves to the project directory
      "cljs" (do (ensure-cljs-build!)
                 (run-inherit repo ["node" (str repo "/target/cljs-cli/main.js") cfg]))
      ;; squint: the compiled body runs its `cli` entry with the cfg,
      ;; the same contract as the cljs body's main
      "squint" (do (ensure-squint-build!)
                   (run-inherit repo ["node" (str repo "/target/squint-cli/main.mjs") "cli" cfg]))
      ;; Phel compiles to PHP files under $TMPDIR/phel and never removes them: give
      ;; each run its own TMPDIR and remove it after
      "phel" (let [tmp (str (fs/create-temp-dir {:prefix "cohost-phel-"}))]
               ;; PHP's stack: freeing a long lazy seq recurses deeper than its 8 MB default allows
               ;; (a segfault); ask for 1 GB as the built app's run does (only what is used is
               ;; touched), and keep the default where the limit is lower (macOS caps it)
               (try (-> (p/process (if (fs/which "bash")
                                     ["bash" "-c" "ulimit -s 1048576 2>/dev/null; exec phel run dev/phel_cli.phel \"$1\"" "cohost-phel" cfg]
                                     ["phel" "run" "dev/phel_cli.phel" cfg])
                                   {:dir repo :inherit true :extra-env {"COHOST_HOME" repo "TMPDIR" tmp}})
                        deref :exit)
                    (finally (fs/delete-tree tmp))))
      ;; native jolt adapter. When this process's :clj leg is champaca,
      ;; jolt -Scp also gets champaca's sources (COHOST_CHAMPACA_SRC, or the
      ;; bundle's champaca-src) and the bundle runtime is JAVA_HOME.
      ;; :jvm's whole-process champaca launch does not come through here.
      "jolt" (let [champaca? (= :champaca (:provider @cohost.clj-body/clj-leg))
                   srcs (if-not champaca?
                          src
                          (let [{:keys [dir error]} (cohost.clj-body/resolve-champaca-src)]
                            (when error (apply die 1 error))
                            (str src path-sep dir)))
                   b (cohost.clj-body/bundle-dir)
                   rt (fs/file b "runtime")
                   extra (when (and champaca? (fs/exists? rt))
                           {"JAVA_HOME" (str rt)
                            "CHAMPACA_BUNDLE" b
                            "CHAMPACA_CACHE_DIR" (cohost.clj-body/champaca-cache-dir)})]
               (run-inherit cwd ["jolt" "-Scp" srcs "-m" "cohost.cli" cfg] extra))
      "cljw" (run-inherit cwd ["cljw" "-cp" src "-m" "cohost.cli" cfg])
      ;; the lpy launch runs the dev/lpy_cli.lpy entry (the lg/phel pattern):
      ;; basilisp raw-compiles, and cohost's host graph does not analyze raw
      ;; on it (cohost.http's sorted-map, cohost.cli's System/getProperty) --
      ;; the entry requires cohost.hosts.basilisp-prime first, which interns
      ;; the host completions, then the adapter, then cohost.cli.
      "lpy" (run-inherit cwd (vec (concat ["basilisp" "run"]
                                          (when-let [d (:lpy-src jank)] ["-p" d])
                                          ["-p" src (str repo "/dev/lpy_cli.lpy") cfg])))
      "lg" (run-inherit cwd ["lg" "-source-paths" src (str repo "/dev/lg_cli.lg") cfg])
      ;; the snapshot's launcher: cohost.cli compiled with the booted core into one
      ;; jank program (dev/perf/jank_snapshot_key.clj), the program JIT-compiled at
      ;; -O3; without it, the booted core from a fresh snapshot (else cohost's -O3
      ;; AOT objects and a boot of core.clj) and cohost.cli through jank run-main
      ;; COHOST_JANK_PROFILE=1: the run goes through jank's own --profile
      ;; (the compiled launcher cannot take the flag, so the JIT run-main
      ;; path serves it); jank writes its trace to <cwd>/jank.profile
      ;; JANK_PRINT_CODEGEN / JANK_PRINT_IR: the launcher compiles nothing
      ;; at run time and would print no dump, so the run goes through
      ;; run-main on the source boot jank-launch decided (see there)
      "jank" (let [profile? (= "1" (System/getenv "COHOST_JANK_PROFILE"))]
               (-> (p/process (if-let [l (and (not profile?) (not (jank-introspect?)) (:launcher jank))]
                                [l cfg]
                                (vec (concat ["jank"]
                                             (when profile? ["--profile"])
                                             ["-O3" "--module-path" (:module-path jank) "run-main" "cohost.cli" "--" cfg])))
                              {:dir cwd :inherit true :extra-env (:env jank)})
                   deref :exit)))))

;; --------------------------------------------------------------------------

(defn implicit-main?
  "clojure.main options with no -M before them (`cohost -e ...`): the Clojure CLI
   still runs them but warns that the implicit form is deprecated."
  [o]
  (and (= :M (:mode o)) (nil? (:alias o)) (seq (:main o))))

(defn with-explicit-M
  "The arguments with -M before clojure.main's own, as `clojure -M -e ...`."
  [args o]
  (let [i (- (count args) (count (:main o)))]
    (vec (concat (take i args) ["-M"] (drop i args)))))

(defn clojure-cli-command
  "The stock Clojure CLI invocation. Same argument construction the :jvm
   launch has always used."
  [rest-args o]
  (vec (cons "clojure" (cond (= (:mode o) :T) (with-templates rest-args)
                             (implicit-main? o) (with-explicit-M rest-args o)
                             :else rest-args))))

(defn- alias-keywords
  "`:main` from `-M:main`, or `[:a :b]` from `-M:a:b`. A bare `-M` has none."
  [token]
  (when (and (string? token) (str/includes? token ":"))
    (mapv #(keyword (subs % 1)) (re-seq #":[^:]+" token))))

(defn jolt-resolve-args
  "The :resolve flags jolt honours, kept in order: -Sforce, and -Sthreads
   with its value. -Srepro is the jolt command head's own; -Strace is not
   forwarded (jolt writes no trace.edn)."
  [resolve]
  (loop [xs (seq resolve) out []]
    (cond (nil? xs) out
          (= (first xs) "-Sforce") (recur (next xs) (conj out "-Sforce"))
          (= (first xs) "-Sthreads") (recur (nnext xs) (conj out "-Sthreads" (second xs)))
          :else (recur (next xs) out))))

(defn jolt-alias-args
  "Flags after `jolt -Srepro -Spath`: `-Sdeps` (the file form read to
   text — jolt parses the value as EDN and dies on a path), the :resolve
   flags jolt honours, `-A`, and `-M:`/`-X:`."
  [o]
  (vec (concat (mapcat (fn [d] ["-Sdeps" (sdeps-text d)]) (:sdeps o))
               (jolt-resolve-args (:resolve o))
               (:aliases o)
               (when (seq (alias-keywords (:alias o))) [(:alias o)]))))

(defn- read-edn-file [path]
  (when (fs/exists? path)
    (try (edn/read-string {:default tagged-literal} (slurp path))
         (catch Exception e
           (die 1 (str "cohost: cannot read " path ": " (.getMessage e)))))))

(defn- read-edn-string [label s]
  (try (edn/read-string {:default tagged-literal} s)
       (catch Exception e
         (die 2 (str "cohost: unreadable " label ": " (.getMessage e))))))

(defn merged-aliases
  "Project deps.edn aliases, then each `-Sdeps` map. `-Srepro` is in effect
   for this leg, so ~/.clojure/deps.edn is not read."
  [cwd sdeps]
  (let [project (read-edn-file (fs/file cwd "deps.edn"))
        extras (map #(read-edn-string "-Sdeps" (sdeps-text %)) sdeps)]
    (reduce (fn [aliases deps]
              (merge-with merge aliases (or (:aliases deps) {})))
            (or (:aliases project) {})
            extras)))

(defn selected-alias-kws
  "-A aliases in command order, then the aliases inside `-M`/`-X`."
  [o]
  (vec (concat (mapcat alias-keywords (:aliases o))
               (alias-keywords (:alias o)))))

(defn combine-aliases
  "Clojure CLI alias merge for the keys this leg uses. :main-opts concatenate
   left to right. :exec-fn and :ns-default are the last alias that sets them.
   :exec-args and :ns-aliases merge, later keys winning."
  [aliases kws]
  (reduce (fn [acc kw]
            (if-let [a (get aliases kw)]
              {:main-opts (into (or (:main-opts acc) []) (or (:main-opts a) []))
               :exec-fn (or (:exec-fn a) (:exec-fn acc))
               :exec-args (merge (:exec-args acc) (:exec-args a))
               :ns-default (or (:ns-default a) (:ns-default acc))
               :ns-aliases (merge (:ns-aliases acc) (:ns-aliases a))}
              (do (binding [*out* *err*]
                    (println (str "WARNING: Specified aliases are undeclared and are not being used: " kw)))
                  acc)))
          {}
          kws))

(defn alias-argmap
  [cwd o]
  (combine-aliases (merged-aliases cwd (:sdeps o)) (selected-alias-kws o)))

(defn exec-invoke-args
  "clojure.main arguments for `-X`. Clojure 1.12's jar has no clojure.run.exec,
   so this is that invocation: require the fn, call it with the merged arg
   map, and yield nil so `-e` does not print the return value."
  [cfg]
  ["-e" (str "(do ((requiring-resolve '" (:ns cfg) "/" (:fn cfg) ") "
             (:args-edn cfg) ") nil)")])

(defn champaca-main-args
  "clojure.main arguments for the champaca leg.
   `-M` prepends the selected aliases' :main-opts to the user's arguments.
   `-X` invokes the alias's :exec-fn. Anything else is the raw tail."
  [cwd rest-args o]
  (case (:mode o)
    :X (exec-invoke-args (exec-config (:main o) (alias-argmap cwd o)))
    :M (into (or (:main-opts (alias-argmap cwd o)) []) (:main o))
    (vec rest-args)))

(defn default-target
  "The project's target: :cohost/target in ./deps.edn (a keyword, e.g.
   :lpy), else :jank. :jvm is the reference: the real Clojure CLI, as `clj` runs it."
  []
  (let [f (fs/file "deps.edn")
        t (when (fs/exists? f)
            (:cohost/target (try (edn/read-string {:default tagged-literal} (slurp f))
                                 (catch Exception e
                                   (die 1 (str "cohost: cannot read deps.edn: " (.getMessage e)))))))]
    (if t (str/replace (str t) #"^:" "") "jank")))

(let [args *command-line-args*]
  (when (#{"-h" "--help" "help"} (first args)) (usage))
  ;; `cohost :<host> ...` names the target; `cohost ...` takes the project's
  (let [explicit? (some-> (first args) (str/starts-with? ":"))
        raw-host (if explicit? (str/replace (first args) #"^:" "") (default-target))
        host-list (cohost.clj-body/parse-host-string raw-host)
        _ (when (empty? host-list) (die 2 "cohost: empty host string"))
        _ (doseq [h host-list]
            (when-not (or (= h "clj") (contains? hosts h))
              (die 2 (str "cohost: unknown host :" h " (hosts: "
                          (str/join " " (map #(str ":" %) (sort hosts)))
                          ", :clj)"))))
        plan (cohost.clj-body/resolve-clj-leg! host-list)
        host (first host-list)
        rest-args (vec (if explicit? (rest args) args))
        cwd (str (fs/canonicalize "."))
        {:keys [mode] :as o} (parse-args rest-args)]
    (letfn [(exit-clojure []
              (System/exit (run-inherit cwd (clojure-cli-command rest-args o))))
            (exit-champaca []
              (let [{:keys [code lines]} (launch-jolt-clj! cwd (champaca-main-args cwd rest-args o)
                                                           (jolt-alias-args o))]
                (if lines (apply die code lines) (System/exit code))))
            (exit-jvm []
              (let [d (cohost.clj-body/select-clj-body)]
                (case (:body d)
                  :clojure (exit-clojure)
                  :jolt (exit-champaca)
                  (apply die (or (:code d) 1) (:lines d)))))]
      (cond
        ;; -T and -Sdescribe stay on `clojure` for every host string.
        (or (= mode :T) (:describe? o))
        (let [only (if (= mode :T) :tool :describe)]
          (if (fs/which "clojure")
            (exit-clojure)
            (apply die 1 (cohost.clj-body/clojure-only-lines only))))

        ;; The first host is the process. :clj as that first token is the
        ;; official CLI. :jvm is the PATH selector. :jolt, :lpy, :jank, ...
        ;; boot their native adapters below, including :jolt:lpy and
        ;; :lpy:jolt. The :clj provider is already in clj-leg; it does not
        ;; replace this process.
        (= host "clj")
        (if (fs/which "clojure")
          (exit-clojure)
          (die 1 "cohost: :clj is the official `clojure` CLI, which is not on PATH."
               "  a host string that names :clj does not fall back to another :clj leg."))

        (and (= host "jvm") (:tree? o))
        (if (= :jolt (:body (cohost.clj-body/select-clj-body)))
          (die 1 "cohost: -Stree renders from the Clojure CLI's basis; the jolt/champaca leg writes none"
               "  put `clojure` on PATH, or ask a native host, where the CLI resolves and the basis is read")
          (exit-jvm))

        (= host "jvm")
        (exit-jvm)

      (not (some #{host} wired))
      (die 2 (str "cohost: :" host " is not wired into the CLI yet: its boot is still in flight (doc/hosts/PLAN.md)"))

      (not (fs/which (first (host-bins host))))
      (let [[b how] (host-bins host)]
        (die 1 (str "cohost: :" host " runs on `" b "`, which is not on PATH")
             (str "  install it: " (if (str/starts-with? how "bash ") (str "bash " repo "/" (subs how 5)) how))))

      :else
      (let [;; The jolt adapter loads source from :roots. With `clojure` on
            ;; PATH that resolution stays the CLI's (basis argmap, the
            ;; contract this adapter has had). Without it, jolt -Srepro
            ;; -Spath is the resolver, because this host must start with
            ;; no JVM. Other hosts still use the CLI, and a missing binary
            ;; dies instead of throwing.
            resolved (if (and (= host "jolt") (not (fs/which "clojure")))
                       (resolve-deps-jolt cwd o)
                       (resolve-deps cwd o))
            {:keys [roots argmap]} resolved
            champaca? (and (= host "jolt") (= :champaca (:provider plan)))
            bundle (when champaca? (cohost.clj-body/bundle-dir))
            app (when (and bundle (fs/exists? (fs/file bundle "app")))
                  (mapv str (fs/list-dir (fs/file bundle "app"))))]
        (cond
          (:tree? o) (if (:basis resolved)
                       (print-dep-tree (:basis resolved))
                       (die 1 "cohost: -Stree renders from the Clojure CLI's basis; this resolution wrote none"))
          (:spath? o) (println (str/join path-sep roots))
          (:prepare? o) (binding [*out* *err*]
                          (println (str "cohost: prepared " (count roots) " source roots under " cache-dir)))
          :else
          (let [run (if (= mode :X)
                      {:inits [] :main (exec-config (:main o) argmap)}
                      (main-config cwd (concat (when (= mode :M) (:main-opts argmap)) (:main o))))
                cfg-file (fs/file cache-dir "cli" (str "config-" (System/currentTimeMillis) "-" (rand-int 100000) ".edn"))
                jank (case host "jank" (jank-launch cwd roots run) "lpy" (lpy-launch) nil)]
            (fs/create-dirs (fs/parent cfg-file))
            (spit cfg-file (pr-str (merge run {:stock-root stock-root :roots roots :cwd cwd
                                               :report-dir (System/getProperty "java.io.tmpdir")
                                               :report (or (System/getenv "COHOST_MAIN_REPORT") "file")
                                               :verbose (boolean (or (:verbose? o) (System/getenv "COHOST_VERBOSE")))
                                               :clj-provider (:provider plan)
                                               :clj-owner (:owner plan)
                                               :hosts (:hosts plan)}
                                          (when champaca?
                                            {:champaca-bundle bundle
                                             :champaca-cache (cohost.clj-body/champaca-cache-dir)
                                             :champaca-classpath (vec (concat app (:entries resolved)))})
                                          (when jank (select-keys jank [:snapshot? :project-snapshot :module-paths])))))
            ;; System/exit skips finally: the config goes before it
            (let [code (try (launch! host cwd cfg-file jank) (finally (fs/delete-if-exists cfg-file)))]
              (System/exit code)))))))))
