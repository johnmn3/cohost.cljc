;; The Phel adapter (a Lisp on PHP 8.5). Phel reads .cljc with the :phel
;; feature, and its runtime is not Clojure's, so this adapter builds the
;; contract from Phel's own pieces:
;; - namespaces are names, the compiler's current one is GlobalEnvironment's
;;   (*ns* cannot be bound), refers and aliases are that environment's;
;; - a var is a PhelVar over the definition registry; a macro is a def whose
;;   metadata says :macro;
;; - dynamic bindings are DynamicScope frames keyed "ns/name";
;; - chars are one-character strings, a regex is a PCRE pattern string;
;; - phel.core is visible from every namespace (Phel's ns form has no
;;   :refer-clojure), so cohost's namespaces see a host name until a stock
;;   definition shadows it.
(ns cohost.hosts.phel
  (:require [cohost.adapter :as adapter])
  (:use Phel)
  (:use Phel.Shared.Munge)
  (:use Phel.Compiler.Infrastructure.GlobalEnvironmentSingleton)
  (:use Phel.Compiler.CompilerFacade)
  (:use Phel.Lang.Symbol)
  (:use Phel.Lang.PhelVar)
  (:use Phel.Lang.Registry)
  (:use Phel.Lang.DynamicScope)
  (:use Phel.Shared.Parser.Node.TriviaNodeInterface)
  (:use Phel.Lang.Collections.Vector.TransientVectorInterface)
  (:use Phel.Lang.Collections.Map.TransientMapInterface)
  (:use Phel.Lang.Collections.HashSet.TransientHashSetInterface)
  (:use Phel.Lang.Collections.LazySeq.LazySeqInterface)
  (:use Phel.Lang.SeqInterface)
  (:use Phel.Lang.Collections.LinkedList.PersistentListInterface)
  (:use Phel.Lang.Collections.Vector.PersistentVector)
  (:use Phel.Lang.Collections.Vector.PersistentVectorInterface)
  (:use Phel.Lang.Collections.Map.PersistentMapInterface)
  (:use Phel.Lang.Collections.Map.MapEntry)
  (:use Phel.Lang.Collections.HashSet.PersistentHashSetInterface)
  (:use Phel.Lang.Atom)
  (:use Phel.Lang.Volatile)
  (:use Phel.Lang.Delay)
  (:use Phel.Lang.Future)
  (:use Phel.Lang.Reduced)
  (:use Phel.Lang.UUID)
  (:use Phel.Lang.BigInt)
  (:use Phel.Lang.Ratio)
  (:use Phel.Lang.BigDecimal)
  (:use Phel.Lang.Collections.SortedMap.PersistentSortedMap)
  (:use Phel.Lang.Collections.SortedSet.PersistentSortedSet)
  (:use Phel.Shared.Parser.Node.QuoteNode)
  (:use Phel.Shared.Parser.Node.ListNode)
  (:use Phel.Shared.Parser.Node.SymbolNode)
  (:use Phel.Shared.Parser.Node.InnerNodeInterface)
  (:use Phel.Shared.Parser.Node.Token)
  (:use Phel.Compiler.Domain.Analyzer.Environment.NodeEnvironment)
  (:use Phel.Compiler.Domain.Analyzer.Ast.GlobalVarNode))

(defn- genv [] (GlobalEnvironmentSingleton/getInstance))
(defn- ns-str [x] (if (string? x) x (str x)))

;; ---------------------------------------------------------------------------
;; reading: the compiler's lexer and reader, one form at a time, so a form is
;; read after the one before it ran (a ::kw after an ns form is that
;; namespace's)
;;
;; Syntax-quote is the JVM reader's, not Phel's: Phel qualifies a symbol only
;; when it resolves, to where it resolves (core.clj's own and, read before
;; cohost.core has an and, becomes phel.core/and), and leaves the rest bare
;; (spec's `and-spec-impl, defined after the macro that names it). Each ` in
;; the parse tree becomes a marker list the reader takes as is, expanded here
;; as the JVM reads it: an alias's target, the namespace a name resolves to
;; (but never phel.core), else the current namespace; special forms, & and
;; class names stay bare, x# is a gensym per syntax-quote. The code it builds
;; is the same as Phel's: (apply list (concat ...)), vector, hash-map.

(def- sq-mark (Symbol/create "cohost.hosts.phel/syntax-quote"))

(defn- mark-syntax-quotes [node]
  (cond
    (and (php/instanceof node QuoteNode) (= (.getTokenType node) Token/T_QUASIQUOTE))
    (let [s (.getStartLocation node) e (.getEndLocation node)]
      (new ListNode Token/T_OPEN_PARENTHESIS s e
           (php/array (new SymbolNode "`" s e sq-mark) (mark-syntax-quotes (.getExpression node)))))
    (php/instanceof node InnerNodeInterface)
    (.replaceChildren node (php/array_map mark-syntax-quotes (.getChildren node)))
    :else node))

(defn- form-of? [head x]
  (and (php/instanceof x PersistentListInterface) (not (empty? x)) (= head (first x))))

(def- sq-specials
  '#{def if do let* fn* loop* recur quote var throw try catch finally new set! letfn*
     case* deftype* reify* import* monitor-enter monitor-exit . &})

(def- sq-counter (atom 0))

(defn- sq-symbol [sym gensyms]
  (let [n (name sym) ns (namespace sym)]
    (cond
      ns (if-let [t (.resolveAlias (genv) ns)] (symbol t n) sym)
      (contains? sq-specials sym) sym
      (php/str_ends_with n "#")
      (or (get @gensyms n)
          (let [g (symbol (str (php/substr n 0 -1) "__" (swap! sq-counter inc) "__auto__"))]
            (swap! gensyms assoc n g)
            g))
      (or (php/str_starts_with n ".") (php/str_ends_with n ".") (php/str_contains n ".")) sym
      :else
      (let [node (try (.resolve (genv) sym (NodeEnvironment/empty)) (catch \Throwable _ nil))]
        (cond
          (and (php/instanceof node GlobalVarNode) (not= "phel.core" (.getNamespace node)))
          (symbol (.getNamespace node) n)
          (and (not (php/instanceof node GlobalVarNode)) (php/ctype_upper (php/substr n 0 1))) sym
          :else (symbol (.getNs (genv)) n))))))

(declare sq)
(declare expand-syntax-quotes)
(defn- sq-items [xs gensyms]
  (apply list 'concat
         (map (fn [x] (if (form-of? 'unquote-splicing x)
                        (expand-syntax-quotes (second x))
                        (list 'list (sq x gensyms))))
              xs)))

(defn- sq [x gensyms]
  (cond
    ;; a nested syntax-quote: read first, then quoted, as the JVM reads it
    (form-of? sq-mark x) (sq (sq (second x) (atom {})) gensyms)
    ;; unquoted code: the syntax-quotes inside it are its own
    (form-of? 'unquote x) (expand-syntax-quotes (second x))
    (symbol? x) (list 'quote (sq-symbol x gensyms))
    (and (php/instanceof x PersistentListInterface) (not (empty? x))) (list 'apply 'list (sq-items x gensyms))
    (and (vector? x) (not (empty? x))) (list 'apply 'vector (sq-items x gensyms))
    (and (map? x) (not (empty? x))) (list 'apply 'hash-map (sq-items (mapcat (fn [e] [(key e) (val e)]) (seq x)) gensyms))
    (or (keyword? x) (string? x) (number? x) (nil? x) (boolean? x)) x
    :else (list 'quote x)))

;; every marker in a read form, expanded; what holds none stays the same object
(defn- expand-syntax-quotes [x]
  (cond
    (form-of? sq-mark x) (sq (second x) (atom {}))
    (php/instanceof x PersistentListInterface)
    (let [xs (mapv expand-syntax-quotes x)]
      (if (every? true? (map (fn [a b] (php/=== a b)) xs x)) x (with-meta (apply list xs) (meta x))))
    (vector? x)
    (let [xs (mapv expand-syntax-quotes x)]
      (if (every? true? (map (fn [a b] (php/=== a b)) xs x)) x (with-meta xs (meta x))))
    (map? x)
    (let [kvs (mapv (fn [e] [(expand-syntax-quotes (key e)) (expand-syntax-quotes (val e))]) (seq x))]
      (if (every? (fn [[[k v] e]] (and (php/=== k (key e)) (php/=== v (val e)))) (map vector kvs (seq x)))
        x
        (with-meta (into {} kvs) (meta x))))
    (set? x)
    (let [xs (mapv expand-syntax-quotes x)]
      (if (every? true? (map (fn [a b] (php/=== a b)) xs x)) x (with-meta (into #{} xs) (meta x))))
    :else x))

(defn- read-forms [src cb]
  (let [cf (new CompilerFacade)
        ts (.lexString cf src "cohost")]
    (loop []
      (let [tree (.parseNext cf ts)]
        (when-not (nil? tree)
          (when-not (php/instanceof tree TriviaNodeInterface)
            (cb (expand-syntax-quotes (.getAst (.read cf (mark-syntax-quotes tree))))))
          (recur))))))

;; ---------------------------------------------------------------------------
;; namespaces and vars

(defn- with-ns [ns-sym thunk]
  (let [env (genv) old (.getNs env)]
    (.setNs env (ns-str ns-sym))
    (try (thunk) (finally (.setNs env old)))))

(defn- var-of [ns-sym sym] (find-var (symbol (ns-str ns-sym) (str sym))))

;; A namespace's definition names as def registered them: phel.core's
;; ns-interns and ns-publics decode each as a namespace name (a _ becomes -)
(defn- def-names [ns-sym public?]
  (let [enc (.encodeRegistryKey (new Munge) (ns-str ns-sym))
        defs (Phel/getDefinitionInNamespace enc)
        out (transient [])]
    (foreach [k _ defs]
      (when (or (not public?) (not (get (Phel/getDefinitionMetaData enc k) :private)))
        (conj! out (symbol k))))
    (persistent out)))

(defn- ns-interns* [ns-sym]
  (into {} (map (fn [k] [k (var-of ns-sym k)])) (def-names ns-sym false)))

(defn- refer-one! [into-ns sym from-ns]
  (.addRefer (genv) (ns-str into-ns) (Symbol/create (str sym)) (Symbol/create (ns-str from-ns))))

(defn- refer! [into-ns from-ns {:keys [only exclude rename]}]
  (let [names (or only (def-names from-ns true))
        ex (set exclude)]
    (doseq [n names :when (not (contains? ex n))]
      (if-let [r (get rename n)]
        (adapter/intern! into-ns r (var-get (var-of from-ns n)))
        (refer-one! into-ns n from-ns)))))

;; A definition is the run-time registry's (under the name as written, as def
;; stores it: phel.core/intern munges it) and the compiler's table's, which code
;; compiled after it resolves the name through. Interning keeps the var's
;; metadata, as Clojure's intern does.
(defn- intern! [ns-sym sym val]
  (let [enc (.encodeRegistryKey (new Munge) (ns-str ns-sym))]
    (Phel/addDefinition enc (str sym) val (Phel/getDefinitionMetaData enc (str sym)))
    (.addDefinition (genv) (ns-str ns-sym) (Symbol/create (str sym)) true)
    (var-of ns-sym sym)))

;; A var's metadata is its definition's, in the registry: def replaces it there,
;; and the compiler reads it there (:macro, :private, :dynamic). phel.core's
;; alter-meta! of a var installs an override instead, which the compiler never
;; reads and no later def replaces; cohost writes the registry's. Without
;; :inline: the compiler applies it, and core.clj's (definline's) build JVM
;; interop (:inline-meta :strip, as for a def).
(defn- set-var-meta! [v m]
  (let [ns (.getNamespace v) nm (.getName v)]
    (Phel/addDefinition ns nm (.getDefinition (Registry/getInstance) ns nm) (dissoc m :inline :inline-arities))
    v))
(defn- alter-var-meta! [v f & args] (set-var-meta! v (apply f (meta v) args)) (meta v))

;; Phel's own macros name the macros they expand into bare (case its own case
;; and an or, or its own or), so the namespace of the call resolves them: in
;; spec's, which defines an or, its or. A macro cohost.core takes from Phel
;; has its expansion's heads named as cohost.core names them (its own macro of
;; that name, else phel.core's), which keeps every expansion step cohost's.
(defn- phel-macro? [sym]
  (let [m (Phel/getDefinitionMetaData "phel.core" (name sym))]
    (boolean (and m (get m :macro)))))

(defn- own-head [sym]
  (let [n (name sym)]
    (if (some? (find-var (symbol "cohost.core" n))) (symbol "cohost.core" n) (symbol "phel.core" n))))

(defn- qualify-host-expansion [x]
  (cond
    (and (php/instanceof x PersistentListInterface) (not (empty? x)))
    (let [h (first x)]
      (if (= 'quote h)
        x
        (let [h' (if (and (symbol? h) (nil? (namespace h)) (phel-macro? h)) (own-head h) h)]
          (with-meta (apply list h' (map qualify-host-expansion (rest x))) (meta x)))))
    (vector? x) (with-meta (mapv qualify-host-expansion x) (meta x))
    :else x))

;; A macro is a def whose metadata says :macro: the compiler then calls it with
;; &form and &env. A Phel macro taken into another namespace (its root is
;; phel.core's macro fn) expands through qualify-host-expansion.
(defn- mark-macro! [v]
  (let [ns (.getNamespace v) nm (.getName v)
        root (.getDefinition (Registry/getInstance) ns nm)
        host (when (not= "phel.core" ns) (var-of 'phel.core nm))
        root (if (and host (php/=== root (var-get host)) (phel-macro? (symbol nm)))
               (fn [& args] (qualify-host-expansion (apply root args)))
               root)]
    (Phel/addDefinition ns nm root (dissoc (assoc (meta v) :macro true) :inline :inline-arities))
    v))

;; resolve and ns-resolve: the var a symbol names in a namespace, or nil.
;; phel.core's resolve returns a symbol, and every namespace sees phel.core
;; there: a name only phel.core has resolves to nothing, as on the JVM.
(defn- resolve-var [sym]
  (let [node (try (.resolve (genv) sym (NodeEnvironment/empty)) (catch \Throwable _ nil))]
    (when (and (php/instanceof node GlobalVarNode) (not= "phel.core" (.getNamespace node)))
      (find-var (symbol (.getNamespace node) (name sym))))))

(defn- ns-resolve*
  ([ns-sym sym] (ns-resolve* ns-sym nil sym))
  ([ns-sym _env sym] (with-ns ns-sym (fn [] (resolve-var sym)))))

;; the-ns and ns-name, which Phel lacks: a namespace is its name there
(defn- the-ns* [x]
  (or (find-ns (ns-str x))
      (throw (new \Exception (str "No namespace: " x " found")))))
(defn- ns-name* [x] (symbol (the-ns* x)))

;; bindings: one DynamicScope frame per push, keyed as the compiled reads look
(defn- binding-key [v] (str (.getNamespace v) "/" (.getName v)))
(defn- push-bindings! [m]
  (let [frame (php-associative-array)]
    (doseq [[v x] m] (php/aset frame (binding-key v) x))
    (.pushFrame (DynamicScope/getInstance) frame)))

;; ---------------------------------------------------------------------------
;; macro expansions: Phel's analyzer takes a seq as a call only when it is a
;; PersistentList (a cons cell or a lazy seq is no code), and its emitter
;; writes a vector literal only when it is a PersistentVector (a subvec is
;; none: stock sigs builds a macro's :arglists with one). Every other seq
;; becomes a list, every other vector (and a map entry) a vector, metadata
;; included; what does not change stays the same object.

(declare walk-code)
;; the same object (phel.core's identical? is equality for a symbol)
(defn- same? [a b] (php/=== a b))
;; metadata is data
(defn- code-meta [x x']
  (let [m (meta x) m' (when m (walk-code m true))]
    (if (and (same? x x') (same? m m')) x (with-meta x' m'))))

(defn- same-items? [xs ys] (every? true? (map same? xs ys)))

;; Phel compiles (def f (fn ...)) with a shortcut: a call of f in its body is a
;; call of $this. A fn of arity clauses (fn ([x] ...) ...) compiles its nested
;; fns to classes of their own, whose $this is not f: the shortcut then makes
;; a nested fn call itself. One clause is written (fn [x] ...), which compiles
;; right; a def of several is given its fn through (do ...), which turns the
;; shortcut off (the call goes through the registry).
(defn- fn-clauses [x]
  (when (and (php/instanceof x PersistentListInterface) (= 'fn (first x)))
    (let [tail (rest x)
          [nm tail] (if (symbol? (first tail)) [(first tail) (rest tail)] [nil tail])]
      (when (and (seq tail) (every? (fn [c] (php/instanceof c PersistentListInterface)) tail))
        [nm tail]))))

(defn- unshortcut [x]
  (if-let [[nm clauses] (fn-clauses x)]
    (if (= 1 (count clauses))
      (with-meta (apply list (concat ['fn] (when nm [nm]) (first clauses))) (meta x))
      x)
    (if (and (php/instanceof x PersistentListInterface) (= 'def (first x)) (= 3 (count x))
             (fn-clauses (nth x 2)))
      (with-meta (list 'def (second x) (list 'do (nth x 2))) (meta x))
      x)))

(defn- walk-code [x q?]
  (cond
    (php/instanceof x PersistentListInterface)
    (let [q? (or q? (= 'quote (first x)))
          xs (mapv (fn [y] (walk-code y q?)) x)
          x' (if (same-items? xs x) x (code-meta x (apply list xs)))]
      (if q? x' (unshortcut x')))
    (php/instanceof x PersistentVector)
    (let [xs (mapv (fn [y] (walk-code y q?)) x)] (code-meta x (if (same-items? xs x) x xs)))
    (php/instanceof x PersistentVectorInterface) (code-meta x (mapv (fn [y] (walk-code y q?)) x))
    (php/instanceof x MapEntry) [(walk-code (key x) q?) (walk-code (val x) q?)]
    (php/instanceof x PersistentMapInterface)
    ;; (Phel's map over a map sees its values: its seq is the entries)
    (let [kvs (mapv (fn [e] [(walk-code (key e) q?) (walk-code (val e) q?)]) (seq x))]
      (code-meta x (if (every? (fn [[[k v] e]] (and (same? k (key e)) (same? v (val e)))) (map vector kvs (seq x)))
                     x
                     (into (empty x) kvs))))
    (php/instanceof x PersistentHashSetInterface)
    (let [xs (mapv (fn [y] (walk-code y q?)) x)] (code-meta x (if (same-items? xs x) x (into (empty x) xs))))
    (php/instanceof x SeqInterface) (walk-code (code-meta x (apply list (seq x))) q?)
    (php/instanceof x Symbol) (code-meta x x)
    :else x))

(defn- as-code [x] (walk-code x false))

;; ---------------------------------------------------------------------------

(def adapter
  {:name :phel
   :core-ns 'phel.core
   :catch-all 'Throwable
   :read-forms read-forms
   ;; Phel's special forms are fn, let, loop; letfn is phel.core's macro, named
   ;; qualified (cohost.core's letfn, the stock macro, expands to letfn*). And
   ;; defonce is a special form too: an entry of its own name, so a call of the
   ;; stock macro is written qualified
   :special-forms '{fn* fn let* let loop* loop letfn* phel.core/letfn defonce defonce}
   ;; a fn's & rest argument is a vector
   :rest-args :vector
   ;; Phel applies a def's :inline fn at compile time, and core.clj's build
   ;; JVM interop: they are stripped, and the codemod applies them
   :inline-meta :strip
   :rewrite-inline? true
   :code-form as-code
   :eval (fn [form] (eval (as-code form)))
   :read-string (fn ([s] (read-string s)) ([s _opts] (read-string s)))
   :with-ns with-ns
   :ensure-bare-ns! (fn [ns-sym] (create-ns (ns-str ns-sym)) ns-sym)
   :current-ns (fn [] (symbol (.getNs (genv))))
   :set-current-ns! (fn [ns-sym] (.setNs (genv) (ns-str ns-sym)))
   :ns-interns ns-interns*
   :interned-var (fn [ns-sym sym] (var-of ns-sym sym))
   :ns-public-names (fn [ns-sym] (set (def-names ns-sym true)))
   :intern! intern!
   :refer-all! (fn [into-ns from-ns] (refer! into-ns from-ns {}))
   :refer! refer!
   :refer-from-core! (fn [into-ns sym] (refer-one! into-ns sym 'phel.core))
   :alias! (fn [into-ns a target]
             (.addRequireAlias (genv) (ns-str into-ns) (Symbol/create (str a)) (Symbol/create (ns-str target))))
   :mark-macro! mark-macro!
   :core-extras {'resolve resolve-var 'ns-resolve ns-resolve* 'the-ns the-ns* 'ns-name ns-name*}
   :resolve-core (fn [sym] (let [v (var-of 'phel.core sym)] (when (and v (not (:private (meta v)))) v)))
   :require-host! (fn [lib] (throw (ex-info (str "cohost: phel has no require at run time: " lib) {:lib lib})))
   :var-ns (fn [v] (symbol (.getNamespace v)))
   :var-sym (fn [v] (symbol (.getName v)))
   :var? (fn [x] (php/instanceof x PhelVar))
   :namespace? (fn [_] false)
   :dynamic-var? (fn [v] (boolean (or (.isDynamic v) (:dynamic (meta v)))))
   :set-dynamic! (fn [v] (set-var-meta! v (assoc (meta v) :dynamic true)))
   :alter-var-meta! alter-var-meta!
   :push-thread-bindings! push-bindings!
   :pop-thread-bindings! (fn [] (.popFrame (DynamicScope/getInstance)))
   :var-thread-bound? (fn [v] (.hasBinding (DynamicScope/getInstance) (.getNamespace v) (.getName v)))
   :lazy-seq (fn [f] (lazy-seq (f)))
   :delay (fn [f] (delay (f)))
   ;; a PHP scalar or array is never a user type; and phel.core's class of a
   ;; string is the class that string names, which the shim's type lookup is not
   :host-data? (fn [x] (not (php/is_object x)))
   :exception? (fn [x] (php/instanceof x \Throwable))
   :char-code (fn [c] (php/mb_ord c))
   :char? (fn [x] (and (string? x) (= 1 (php/mb_strlen x))))
   :transient? (fn [x] (or (php/instanceof x TransientVectorInterface) (php/instanceof x TransientMapInterface)
                           (php/instanceof x TransientHashSetInterface)))
   :lazy-seq? (fn [x] (php/instanceof x LazySeqInterface))
   :atom? (fn [x] (php/instanceof x Atom))
   ;; Phel's reference and number types
   :volatile? (fn [x] (php/instanceof x Volatile))
   :delay? (fn [x] (php/instanceof x Delay))
   :reduced? (fn [x] (php/instanceof x Reduced))
   :deref? (fn [x] (or (php/instanceof x Atom) (php/instanceof x Volatile) (php/instanceof x Delay)
                       (php/instanceof x Reduced) (php/instanceof x Future) (php/instanceof x PhelVar)))
   :pending? (fn [x] (or (php/instanceof x Delay) (php/instanceof x LazySeqInterface) (php/instanceof x Future)))
   :uuid? (fn [x] (php/instanceof x UUID))
   :bigint? (fn [x] (php/instanceof x BigInt))
   :ratio? (fn [x] (php/instanceof x Ratio))
   :decimal? (fn [x] (php/instanceof x BigDecimal))
   :sorted? (fn [x] (or (php/instanceof x PersistentSortedMap) (php/instanceof x PersistentSortedSet)))
   :nano-time (fn [] (php/hrtime true))
   :current-time-millis (fn [] (php/intdiv (php/hrtime true) 1000000))
   :math-ceil (fn [x] (php/ceil x))
   :math-floor (fn [x] (php/floor x))
   :math-sqrt (fn [x] (php/sqrt x))
   :parse-long (fn [s] (when (php/preg_match "/^[+-]?[0-9]+$/" s) (php/intval s)))
   :parse-double (fn [s] (php/floatval s))
   :upper-case (fn [s] (php/mb_strtoupper (str s)))
   :lower-case (fn [s] (php/mb_strtolower (str s)))
   :index-of (fn [s sub from] (let [i (php/mb_strpos s sub from)] (if (php/=== i false) -1 i)))})

;; cohost's boot redefines names as a REPL session does (core.clj's let, fn,
;; defn twice); Phel allows that in its interactive mode
(Phel/addDefinition "phel.core" "*interactive-mode*" true)

(adapter/install! adapter)
