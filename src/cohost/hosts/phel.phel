;; The Phel adapter (a Lisp on PHP 8.5). Phel reads .cljc with the :phel
;; feature, and its runtime is not Clojure's, so this adapter builds the
;; contract from Phel's own pieces:
;; - namespaces are names, the compiler's current one is GlobalEnvironment's
;;   (*ns* cannot be bound), refers and aliases are that environment's;
;; - a var is a PhelVar over the definition registry; a macro is a def whose
;;   metadata says :macro;
;; - dynamic bindings are DynamicScope frames keyed "ns/name";
;; - chars are one-character strings, a regex is a Pattern of its JVM source
;;   (phel_host.php), which PCRE matches;
;; - phel.core is visible from every namespace (Phel's ns form has no
;;   :refer-clojure), so cohost's namespaces see a host name until a stock
;;   definition shadows it.
(ns cohost.hosts.phel
  (:require [cohost.adapter :as adapter])
  (:use Phel)
  (:use Phel.Shared.Munge)
  (:use Phel.Compiler.Infrastructure.GlobalEnvironmentSingleton)
  (:use Phel.Compiler.CompilerFacade)
  (:use Phel.Lang.Symbol)
  (:use Phel.Lang.PhelVar)
  (:use Phel.Lang.Registry)
  (:use Phel.Lang.DynamicScope)
  (:use Phel.Shared.Parser.Node.TriviaNodeInterface)
  (:use Phel.Lang.Collections.Vector.TransientVectorInterface)
  (:use Phel.Lang.Collections.Map.TransientMapInterface)
  (:use Phel.Lang.Collections.HashSet.TransientHashSetInterface)
  (:use Phel.Lang.Collections.LazySeq.LazySeqInterface)
  (:use Phel.Lang.SeqInterface)
  (:use Phel.Lang.Collections.LinkedList.PersistentListInterface)
  (:use Phel.Lang.Collections.Vector.PersistentVector)
  (:use Phel.Lang.Collections.Vector.PersistentVectorInterface)
  (:use Phel.Lang.Collections.Map.PersistentMapInterface)
  (:use Phel.Lang.Collections.Map.MapEntry)
  (:use Phel.Lang.Collections.HashSet.PersistentHashSetInterface)
  (:use Phel.Lang.Atom)
  (:use Phel.Lang.Volatile)
  (:use Phel.Lang.Delay)
  (:use Phel.Lang.Future)
  (:use Phel.Lang.Reduced)
  (:use Phel.Lang.UUID)
  (:use Phel.Lang.BigInt)
  (:use Phel.Lang.Ratio)
  (:use Phel.Lang.BigDecimal)
  (:use Phel.Lang.Collections.SortedMap.PersistentSortedMap)
  (:use Phel.Lang.Collections.SortedSet.PersistentSortedSet)
  (:use Phel.Shared.Parser.Node.QuoteNode)
  (:use Phel.Shared.Parser.Node.ListNode)
  (:use Phel.Shared.Parser.Node.SymbolNode)
  (:use Phel.Shared.Parser.Node.StringNode)
  (:use Phel.Shared.Parser.Node.NumberNode)
  (:use Phel.Shared.Parser.Node.TaggedLiteralNode)
  (:use Phel.Compiler.Domain.Reader.Exceptions.ReaderException)
  (:use Phel.Lang.TagRegistry)
  (:use Phel.Shared.Parser.Node.InnerNodeInterface)
  (:use Phel.Shared.Parser.Node.Token)
  (:use Phel.Compiler.Domain.Analyzer.Environment.NodeEnvironment)
  (:use Phel.Compiler.Domain.Analyzer.Ast.GlobalVarNode)
  (:use Phel.Lang.ExceptionInfo)
  (:use Phel.Lang.Collections.Struct.AbstractPersistentStruct))

(defn- genv [] (GlobalEnvironmentSingleton/getInstance))
(defn- ns-str [x] (if (string? x) x (str x)))

;; ---------------------------------------------------------------------------
;; regexes: a Pattern (phel_host.php) keeps its JVM source and gives the same
;; Pattern for the same source. Phel's emitter writes no object: code holding
;; one is written (re-literal source) (see walk-code).

(php/eval (str "require_once " (php/var_export (str __DIR__ "/phel_host.php") true) ";"))
(def- pattern-class "cohost\\hosts\\phel\\Pattern")
(defn- pattern? [x] (php/is_a x pattern-class))
(defn re-literal [src]
  (or (php/call_user_func (str pattern-class "::of") src)
      (throw (adapter/ex* 'java.util.regex.PatternSyntaxException
                          (str (php/call_user_func (str pattern-class "::error") src) "\n" src)))))
(defn- re-pattern* [x] (if (pattern? x) x (re-literal x)))

;; ---------------------------------------------------------------------------
;; reading: the compiler's lexer and reader, one form at a time, so a form is
;; read after the one before it ran (a ::kw after an ns form is that
;; namespace's)
;;
;; Syntax-quote is the JVM reader's, not Phel's: Phel qualifies a symbol only
;; when it resolves, to where it resolves (core.clj's own and, read before
;; cohost.core has an and, becomes phel.core/and), and leaves the rest bare
;; (spec's `and-spec-impl, defined after the macro that names it). Each ` in
;; the parse tree becomes a marker list the reader takes as is, expanded here
;; as the JVM reads it: an alias's target, the namespace a name resolves to
;; (but never phel.core), else the current namespace; special forms, & and
;; class names stay bare, x# is a gensym per syntax-quote. The code it builds
;; is the same as Phel's: (apply list (concat ...)), vector, hash-map.
;;
;; A regex literal is the JVM's too: a Pattern of the source as written (Phel
;; reads a PCRE string), through a marker the same way. And a number is the
;; JVM reader's: 0-led digits are octal, so 08 is no number. A tagged literal
;; (but Phel's #php) is read by the reader's tag-reader: a fn of the tag
;; symbol and the form.

(def- sq-mark (Symbol/create "cohost.hosts.phel/syntax-quote"))
(def- re-mark (Symbol/create "cohost.hosts.phel/regex-literal"))
(def- tag-mark (Symbol/create "cohost.hosts.phel/tagged-literal"))

;; #inst and #uuid: Phel's own handlers; any other tag has no reader
(defn- default-tag-reader [tag form]
  (if-let [h (.get (TagRegistry/getInstance) (name tag))]
    (h form)
    (throw (adapter/ex* 'java.lang.RuntimeException (str "No reader function for tag " tag)))))
(def- tag-reader (atom default-tag-reader))

(defn- mark-nodes [node]
  (cond
    (and (php/instanceof node QuoteNode) (= (.getTokenType node) Token/T_QUASIQUOTE))
    (let [s (.getStartLocation node) e (.getEndLocation node)]
      (new ListNode Token/T_OPEN_PARENTHESIS s e
           (php/array (new SymbolNode "`" s e sq-mark) (mark-nodes (.getExpression node)))))
    (and (php/instanceof node StringNode) (php/str_starts_with (.getCode node) "#\""))
    (let [s (.getStartLocation node) e (.getEndLocation node) src (php/substr (.getCode node) 2 -1)]
      (new ListNode Token/T_OPEN_PARENTHESIS s e
           (php/array (new SymbolNode "#" s e re-mark) (new StringNode (.getCode node) s e src))))
    (and (php/instanceof node TaggedLiteralNode) (not= "php" (.getTag node)))
    (let [s (.getStartLocation node) e (.getEndLocation node)]
      (new ListNode Token/T_OPEN_PARENTHESIS s e
           (php/array (new SymbolNode "#" s e tag-mark) (new SymbolNode (.getTag node) s e (Symbol/create (.getTag node)))
                      (mark-nodes (.getForm node)))))
    (and (php/instanceof node NumberNode) (= 1 (php/preg_match "/^[+-]?0[0-7]*[89][0-9]*N?$/" (.getCode node))))
    (throw (adapter/ex* 'java.lang.NumberFormatException (str "Invalid number: " (.getCode node))))
    (php/instanceof node InnerNodeInterface)
    (.replaceChildren node (php/array_map mark-nodes (.getChildren node)))
    :else node))

(defn- form-of? [head x]
  (and (php/instanceof x PersistentListInterface) (not (empty? x)) (= head (first x))))

(def- sq-specials
  '#{def if do let* fn* loop* recur quote var throw try catch finally new set! letfn*
     case* deftype* reify* import* monitor-enter monitor-exit . &})

(def- sq-counter (atom 0))

(defn- sq-symbol [sym gensyms]
  (let [n (name sym) ns (namespace sym)]
    (cond
      ns (if-let [t (.resolveAlias (genv) ns)] (symbol t n) sym)
      (contains? sq-specials sym) sym
      (php/str_ends_with n "#")
      (or (get @gensyms n)
          (let [g (symbol (str (php/substr n 0 -1) "__" (swap! sq-counter inc) "__auto__"))]
            (swap! gensyms assoc n g)
            g))
      (or (php/str_starts_with n ".") (php/str_ends_with n ".") (php/str_contains n ".")) sym
      :else
      (let [node (try (.resolve (genv) sym (NodeEnvironment/empty)) (catch \Throwable _ nil))]
        (cond
          (and (php/instanceof node GlobalVarNode) (not= "phel.core" (.getNamespace node)))
          (symbol (.getNamespace node) n)
          (and (not (php/instanceof node GlobalVarNode)) (php/ctype_upper (php/substr n 0 1))) sym
          :else (symbol (.getNs (genv)) n))))))

(declare sq)
(declare expand-syntax-quotes)
(defn- sq-items [xs gensyms]
  (apply list 'concat
         (map (fn [x] (if (form-of? 'unquote-splicing x)
                        (expand-syntax-quotes (second x))
                        (list 'list (sq x gensyms))))
              xs)))

(defn- sq [x gensyms]
  (cond
    (form-of? re-mark x) (re-literal (second x))
    ;; a nested syntax-quote: read first, then quoted, as the JVM reads it
    (form-of? sq-mark x) (sq (sq (second x) (atom {})) gensyms)
    ;; unquoted code: the syntax-quotes inside it are its own
    (form-of? 'unquote x) (expand-syntax-quotes (second x))
    (symbol? x) (list 'quote (sq-symbol x gensyms))
    (and (php/instanceof x PersistentListInterface) (not (empty? x))) (list 'apply 'list (sq-items x gensyms))
    (and (vector? x) (not (empty? x))) (list 'apply 'vector (sq-items x gensyms))
    (and (map? x) (not (empty? x))) (list 'apply 'hash-map (sq-items (mapcat (fn [e] [(key e) (val e)]) (seq x)) gensyms))
    (or (keyword? x) (string? x) (number? x) (nil? x) (boolean? x) (pattern? x)) x
    :else (list 'quote x)))

;; every marker in a read form, expanded; what holds none stays the same object
(defn- expand-syntax-quotes [x]
  (cond
    (form-of? re-mark x) (re-literal (second x))
    (form-of? tag-mark x) ((deref tag-reader) (second x) (expand-syntax-quotes (nth x 2)))
    (form-of? sq-mark x) (sq (second x) (atom {}))
    (php/instanceof x PersistentListInterface)
    (let [xs (mapv expand-syntax-quotes x)]
      (if (every? true? (map (fn [a b] (php/=== a b)) xs x)) x (with-meta (apply list xs) (meta x))))
    (vector? x)
    (let [xs (mapv expand-syntax-quotes x)]
      (if (every? true? (map (fn [a b] (php/=== a b)) xs x)) x (with-meta xs (meta x))))
    (map? x)
    (let [kvs (mapv (fn [e] [(expand-syntax-quotes (key e)) (expand-syntax-quotes (val e))]) (seq x))]
      (if (every? (fn [[[k v] e]] (and (php/=== k (key e)) (php/=== v (val e)))) (map vector kvs (seq x)))
        x
        (with-meta (into {} kvs) (meta x))))
    (set? x)
    (let [xs (mapv expand-syntax-quotes x)]
      (if (every? true? (map (fn [a b] (php/=== a b)) xs x)) x (with-meta (into #{} xs) (meta x))))
    :else x))

(defn- read-node [cf tree]
  (try (expand-syntax-quotes (.getAst (.read cf (mark-nodes tree))))
       (catch ReaderException e
         (if (php/str_starts_with (.getMessage e) "Duplicate key")
           (throw (adapter/ex* 'java.lang.IllegalArgumentException (.getMessage e)))
           (throw e)))))

(defn- read-forms [src cb]
  (let [cf (new CompilerFacade)
        ts (.lexString cf src "cohost")]
    (loop []
      (let [tree (.parseNext cf ts)]
        (when-not (nil? tree)
          (when-not (php/instanceof tree TriviaNodeInterface)
            (cb (read-node cf tree)))
          (recur))))))

;; read-string: s's first form, as read-forms reads it; with none, opts' :eof
;; or the JVM's EOF. clojure.edn's: its :readers by tag symbol, then its
;; :default fn, then #inst and #uuid.
(defn- read-one [s opts]
  (let [cf (new CompilerFacade)
        ts (.lexString cf (str s) "cohost")]
    (loop []
      (let [tree (.parseNext cf ts)]
        (cond
          (nil? tree) (if (contains? opts :eof)
                        (get opts :eof)
                        (throw (adapter/ex* 'java.lang.RuntimeException "EOF while reading")))
          (php/instanceof tree TriviaNodeInterface) (recur)
          :else (read-node cf tree))))))

(defn- edn-read-string [opts s]
  (when-not (nil? s)
    (let [readers (get opts :readers) dflt (get opts :default) old (deref tag-reader)]
      (reset! tag-reader (fn [tag form]
                           (if-let [r (get readers tag)]
                             (r form)
                             (if (and dflt (nil? (.get (TagRegistry/getInstance) (name tag))))
                               (dflt tag form)
                               (default-tag-reader tag form)))))
      (try (read-one s opts) (finally (reset! tag-reader old))))))

;; ---------------------------------------------------------------------------
;; namespaces and vars

;; the compiler's namespace, and *ns*: phel.core's, and cohost.core's copy of
;; it (Phel's *ns* is no dynamic var, so the boot interns its value)
(defn- set-ns! [ns]
  (.setNs (genv) ns)
  (Phel/setVar "phel.core" "*ns*" ns)
  (when (.isDefined (Registry/getInstance) "cohost.core" "*ns*")
    (Phel/setVar "cohost.core" "*ns*" ns)))

(defn- with-ns [ns-sym thunk]
  (let [old (.getNs (genv))]
    (set-ns! (ns-str ns-sym))
    (try (thunk) (finally (set-ns! old)))))

(defn- var-of [ns-sym sym] (find-var (symbol (ns-str ns-sym) (str sym))))

;; A namespace's definition names as def registered them: phel.core's
;; ns-interns and ns-publics decode each as a namespace name (a _ becomes -)
(defn- def-names [ns-sym public?]
  (let [enc (.encodeRegistryKey (new Munge) (ns-str ns-sym))
        defs (Phel/getDefinitionInNamespace enc)
        out (transient [])]
    (foreach [k _ defs]
      (when (or (not public?) (not (get (Phel/getDefinitionMetaData enc k) :private)))
        (conj! out (symbol k))))
    (persistent out)))

(defn- ns-interns* [ns-sym]
  (into {} (map (fn [k] [k (var-of ns-sym k)])) (def-names ns-sym false)))

(defn- refer-one! [into-ns sym from-ns]
  (.addRefer (genv) (ns-str into-ns) (Symbol/create (str sym)) (Symbol/create (ns-str from-ns))))

(defn- refer! [into-ns from-ns {:keys [only exclude rename]}]
  (let [names (or only (def-names from-ns true))
        ex (set exclude)]
    (doseq [n names :when (not (contains? ex n))]
      (if-let [r (get rename n)]
        (adapter/intern! into-ns r (var-get (var-of from-ns n)))
        (refer-one! into-ns n from-ns)))))

;; A definition is the run-time registry's (under the name as written, as def
;; stores it: phel.core/intern munges it) and the compiler's table's, which code
;; compiled after it resolves the name through. Interning keeps the var's
;; metadata, as Clojure's intern does.
(defn- intern! [ns-sym sym val]
  (let [enc (.encodeRegistryKey (new Munge) (ns-str ns-sym))]
    (Phel/addDefinition enc (str sym) val (Phel/getDefinitionMetaData enc (str sym)))
    (.addDefinition (genv) (ns-str ns-sym) (Symbol/create (str sym)) true)
    (var-of ns-sym sym)))

;; A var's metadata is its definition's, in the registry: def replaces it there,
;; and the compiler reads it there (:macro, :private, :dynamic). phel.core's
;; alter-meta! of a var installs an override instead, which the compiler never
;; reads and no later def replaces; cohost writes the registry's. Without
;; :inline: the compiler applies it, and core.clj's (definline's) build JVM
;; interop (:inline-meta :strip, as for a def).
(defn- set-var-meta! [v m]
  (let [ns (.getNamespace v) nm (.getName v)]
    (Phel/addDefinition ns nm (.getDefinition (Registry/getInstance) ns nm) (dissoc m :inline :inline-arities))
    v))
(defn- alter-var-meta! [v f & args] (set-var-meta! v (apply f (meta v) args)) (meta v))

;; Phel's own macros name the macros they expand into bare (case its own case
;; and an or, or its own or), so the namespace of the call resolves them: in
;; spec's, which defines an or, its or. A macro cohost.core takes from Phel
;; has its expansion's heads named as cohost.core names them (its own macro of
;; that name, else phel.core's), which keeps every expansion step cohost's.
(defn- phel-macro? [sym]
  (let [m (Phel/getDefinitionMetaData "phel.core" (name sym))]
    (boolean (and m (get m :macro)))))

(defn- own-head [sym]
  (let [n (name sym)]
    (if (some? (find-var (symbol "cohost.core" n))) (symbol "cohost.core" n) (symbol "phel.core" n))))

(defn- qualify-host-expansion [x]
  (cond
    (and (php/instanceof x PersistentListInterface) (not (empty? x)))
    (let [h (first x)]
      (if (= 'quote h)
        x
        (let [h' (if (and (symbol? h) (nil? (namespace h)) (phel-macro? h)) (own-head h) h)]
          (with-meta (apply list h' (map qualify-host-expansion (rest x))) (meta x)))))
    (vector? x) (with-meta (mapv qualify-host-expansion x) (meta x))
    :else x))

;; A Phel macro cohost.core takes: its expansion's heads named as cohost.core
;; names them; deftype and defrecord bind their fields in their methods, and a
;; deftype's class is noted (its instances are no records)
(declare bind-fields)
(declare type-forms)
(declare protocol-forms)
(declare reify-forms)
(defn- host-macro [nm root]
  (case nm
    "deftype" (fn [form env tname fields & specs] (type-forms false tname fields specs))
    "defrecord" (fn [form env tname fields & specs] (type-forms true tname fields specs))
    "defprotocol" (fn [form env pname & specs] (protocol-forms pname specs))
    "reify" (fn [form env & specs] (reify-forms specs))
    ;; (Phel's drops a nil type's group: its grouping takes a nil header for none)
    "extend-protocol" (fn [form env p & specs]
                        (apply list 'do
                               (loop [xs specs t nil ms [] started? false acc []]
                                 (cond
                                   (empty? xs) (if started? (conj acc (apply list 'phel.core/extend-type t p ms)) acc)
                                   (php/instanceof (first xs) PersistentListInterface) (recur (rest xs) t (conj ms (first xs)) started? acc)
                                   :else (recur (rest xs) (first xs) [] true
                                                (if started? (conj acc (apply list 'phel.core/extend-type t p ms)) acc))))))
    (fn [& args] (qualify-host-expansion (apply root args)))))

;; A macro is a def whose metadata says :macro: the compiler then calls it with
;; &form and &env. A Phel macro taken into another namespace (its root is
;; phel.core's macro fn) expands through qualify-host-expansion.
(defn- mark-macro! [v]
  (let [ns (.getNamespace v) nm (.getName v)
        root (.getDefinition (Registry/getInstance) ns nm)
        host (when (not= "phel.core" ns) (var-of 'phel.core nm))
        root (if (and host (php/=== root (var-get host)) (phel-macro? (symbol nm)))
               (host-macro nm root)
               root)]
    (Phel/addDefinition ns nm root (dissoc (assoc (meta v) :macro true) :inline :inline-arities))
    v))

;; resolve and ns-resolve: the var a symbol names in a namespace, or nil.
;; phel.core's resolve returns a symbol, and every namespace sees phel.core
;; there: a name only phel.core has resolves to nothing, as on the JVM.
(defn- resolve-var [sym]
  (let [node (try (.resolve (genv) sym (NodeEnvironment/empty)) (catch \Throwable _ nil))]
    (when (and (php/instanceof node GlobalVarNode) (not= "phel.core" (.getNamespace node)))
      (find-var (symbol (.getNamespace node) (name sym))))))

(defn- ns-resolve*
  ([ns-sym sym] (ns-resolve* ns-sym nil sym))
  ([ns-sym _env sym] (with-ns ns-sym (fn [] (resolve-var sym)))))

;; the-ns and ns-name, which Phel lacks: a namespace is its name there
(defn- the-ns* [x]
  (or (find-ns (ns-str x))
      (throw (new \Exception (str "No namespace: " x " found")))))
(defn- ns-name* [x] (symbol (the-ns* x)))

;; bindings: one DynamicScope frame per push, keyed as the compiled reads look
(defn- binding-key [v] (str (.getNamespace v) "/" (.getName v)))
(defn- push-bindings! [m]
  (let [frame (php-associative-array)]
    (doseq [[v x] m] (php/aset frame (binding-key v) x))
    (.pushFrame (DynamicScope/getInstance) frame)))

;; ---------------------------------------------------------------------------
;; macro expansions: Phel's analyzer takes a seq as a call only when it is a
;; PersistentList (a cons cell or a lazy seq is no code), and its emitter
;; writes a vector literal only when it is a PersistentVector (a subvec is
;; none: stock sigs builds a macro's :arglists with one). Every other seq
;; becomes a list, every other vector (and a map entry) a vector, metadata
;; included; what does not change stays the same object.

(declare walk-code)
;; the same object (phel.core's identical? is equality for a symbol)
(defn- same? [a b] (php/=== a b))
;; metadata is data
(defn- code-meta [x x']
  (let [m (meta x) m' (when m (walk-code m true))]
    (if (and (same? x x') (same? m m')) x (with-meta x' m'))))

(defn- same-items? [xs ys] (every? true? (map same? xs ys)))

;; Phel compiles (def f (fn ...)) with a shortcut: a call of f in its body is a
;; call of $this. A fn of arity clauses (fn ([x] ...) ...) compiles its nested
;; fns to classes of their own, whose $this is not f: the shortcut then makes
;; a nested fn call itself. One clause is written (fn [x] ...), which compiles
;; right; a def of several is given its fn through (do ...), which turns the
;; shortcut off (the call goes through the registry).
(defn- fn-clauses [x]
  (when (and (php/instanceof x PersistentListInterface) (= 'fn (first x)))
    (let [tail (rest x)
          [nm tail] (if (symbol? (first tail)) [(first tail) (rest tail)] [nil tail])]
      (when (and (seq tail) (every? (fn [c] (php/instanceof c PersistentListInterface)) tail))
        [nm tail]))))

(defn- unshortcut [x]
  (if (and (php/instanceof x PersistentListInterface) (= 'def (first x)) (= 2 (count x)) (symbol? (second x)))
    (with-meta (list 'def (second x) (list 'cohost.hosts.phel/keep-root (.getNs (genv)) (name (second x)))) (meta x))
  (if-let [[nm clauses] (fn-clauses x)]
    (if (= 1 (count clauses))
      (with-meta (apply list (concat ['fn] (when nm [nm]) (first clauses))) (meta x))
      x)
    (if (and (php/instanceof x PersistentListInterface) (= 'def (first x)) (= 3 (count x))
             (fn-clauses (nth x 2)))
      (with-meta (list 'def (second x) (list 'do (nth x 2))) (meta x))
      x))))

(defn- walk-code [x q?]
  (cond
    (php/instanceof x PersistentListInterface)
    (let [q? (or q? (= 'quote (first x)))
          xs (mapv (fn [y] (walk-code y q?)) x)
          x' (if (same-items? xs x) x (code-meta x (apply list xs)))]
      (if q? x' (unshortcut x')))
    (php/instanceof x PersistentVector)
    (let [xs (mapv (fn [y] (walk-code y q?)) x)] (code-meta x (if (same-items? xs x) x xs)))
    (php/instanceof x PersistentVectorInterface) (code-meta x (mapv (fn [y] (walk-code y q?)) x))
    (php/instanceof x MapEntry) [(walk-code (key x) q?) (walk-code (val x) q?)]
    (php/instanceof x PersistentMapInterface)
    ;; (Phel's map over a map sees its values: its seq is the entries)
    (let [kvs (mapv (fn [e] [(walk-code (key e) q?) (walk-code (val e) q?)]) (seq x))]
      (code-meta x (if (every? (fn [[[k v] e]] (and (same? k (key e)) (same? v (val e)))) (map vector kvs (seq x)))
                     x
                     (into (empty x) kvs))))
    (php/instanceof x PersistentHashSetInterface)
    (let [xs (mapv (fn [y] (walk-code y q?)) x)] (code-meta x (if (same-items? xs x) x (into (empty x) xs))))
    (php/instanceof x SeqInterface) (walk-code (code-meta x (apply list (seq x))) q?)
    (php/instanceof x Symbol) (code-meta x x)
    (and (not q?) (pattern? x)) (list 'cohost.hosts.phel/re-literal (.-src x))
    :else x))

(defn- as-code [x] (walk-code x false))

;; A root (def x) gives no value: the JVM's var is then unbound, and a def of
;; it again keeps its root. Phel's def sets nil (and its defonce is no
;; expression, which core.clj's defonce needs), so (def x) is written
;; (def x (keep-root ns "x")) (see unshortcut); a var holding unbound has no root.
(def unbound (new \stdClass))
(defn keep-root [ns nm]
  (let [reg (Registry/getInstance) ns (.encodeRegistryKey (new Munge) ns)]
    (if (.isDefined reg ns nm) (.getDefinition reg ns nm) unbound)))
(defn- var-bound? [v]
  (let [ns (.getNamespace v) nm (.getName v) reg (Registry/getInstance)]
    (and (.isDefined reg ns nm) (not (php/=== unbound (.getDefinition reg ns nm))))))

;; a var's metadata names it, as the JVM's does
(defn- var-meta [v]
  (assoc (or (meta v) {}) :name (symbol (.getName v)) :ns (.getNamespace v)))

;; the vars this thread binds: each DynamicScope frame's, innermost first
(defn- thread-bindings []
  (let [out (transient {})]
    (foreach [k x (.snapshot (DynamicScope/getInstance))]
      (when-let [v (find-var (symbol k))] (assoc! out v x)))
    (persistent out)))

;; ---------------------------------------------------------------------------
;; types: Phel's deftype and defrecord are defstructs (a struct is a map of its
;; fields), and a reify is an object of an anonymous class. A deftype's
;; instances are no records: the classes deftype made are noted.

(def deftype-classes (atom #{}))
(defn note-deftype! [cls] (swap! deftype-classes conj cls) nil)

(defn record?* [x]
  (and (php/instanceof x AbstractPersistentStruct) (not (contains? @deftype-classes (php/get_class x)))))

(defn- user-type? [x]
  (or (php/instanceof x AbstractPersistentStruct)
      (and (php/is_object x) (php/str_starts_with (php/get_class x) "class@anonymous"))))

;; (.f x): a field of a struct, else x's PHP method (toString is __toString)
(defn- invoke-member [x nm args absent]
  (let [field (if (php/str_starts_with nm "-") (php/substr nm 1) nm)
        k (keyword field)
        m (.encode (new Munge) (if (= nm "toString") "__toString" nm))]
    (cond
      (and (empty? args) (php/instanceof x AbstractPersistentStruct) (contains? x k)) (get x k)
      (and (php/method_exists x "cohostFns") (contains? (.cohostFns x) (str "." nm)))
      (apply (get (.cohostFns x) (str "." nm)) x args)
      (php/method_exists x m) (php/call_user_func_array (php/array x m) (to-php-array args))
      :else absent)))

;; A deftype or defrecord method sees the type's fields as locals, as the JVM's
;; does (Phel's extend-type gives it only its parameters)
(defn- bind-fields [fields specs]
  (map (fn [x]
         (if (and (php/instanceof x PersistentListInterface) (vector? (second x)) (seq (second x)))
           (let [[m params & body] x
                 this (first params)
                 this' (if (and (symbol? this) (not= '_ this)) this (gensym "this"))]
             (list m (assoc params 0 this')
                   (apply list 'let (vec (mapcat (fn [f] [f (list 'get this' (keyword (name f)))]) fields)) body)))
           x))
       specs))

;; A deftype or defrecord here is Phel's: a defstruct, and an extend-type of its
;; protocol methods. A method of a JVM interface the codemod moved to a PHP
;; interface (host-methods) is the struct class's own method instead, which
;; Phel's extend-type does not take.
(defn- php-interface? [h] (and (symbol? h) (php/str_starts_with (name h) "\\")))

(defn- split-specs [specs]
  (loop [xs specs php? false ifaces [] protos []]
    (if (empty? xs)
      [ifaces protos]
      (let [x (first xs)]
        (if (symbol? x)
          (if (php-interface? x)
            (recur (rest xs) true (conj ifaces x) protos)
            (recur (rest xs) false ifaces (conj protos x)))
          (if php?
            (recur (rest xs) php? (conj ifaces x) protos)
            (recur (rest xs) php? ifaces (conj protos x))))))))

(defn- type-forms [record? tname fields specs]
  (let [[ifaces protos] (split-specs (bind-fields fields specs))
        nm (name tname)
        mg (new Munge)
        cls (str (.encodePhpNs mg *ns*) "\\" (.encode mg nm))
        m (gensym "m") this (gensym "this") f (gensym "f")
        ifaces (concat ifaces ['\cohost\hosts\phel\Fields
                               (list '__get [this f] (list 'phel.core/get this (list 'phel.core/keyword f)))])]
    (apply list 'do
           (concat
            ;; the type's name in its own methods is the var defstruct makes
            ;; (Phel compiles a name it cannot resolve to that name, a string)
            [(list 'def tname nil)
             (apply list 'phel.core/defstruct tname fields ifaces)
             (list 'phel.core/defn (symbol (str "->" nm)) fields (apply list tname fields))]
            (when record?
              [(list 'phel.core/defn (symbol (str "map->" nm)) [m]
                     (apply list tname (map (fn [f] (list 'phel.core/get m (keyword (name f)))) fields)))])
            (when (seq protos) [(apply list 'phel.core/extend-type tname protos)])
            (when-not record? [(list 'cohost.hosts.phel/note-deftype! cls)])
            [tname]))))

;; A protocol is Phel's: a map whose methods dispatch through a table each
;; (P--m--dispatch, an atom keyed by type). Phel's defprotocol takes no
;; docstring or options, and the protocol keeps its tables by method name
;; here, for extend.
(defn- protocol-forms [pname specs]
  (let [doc (when (string? (first specs)) (first specs))
        specs (if doc (rest specs) specs)
        specs (loop [xs specs] (if (keyword? (first xs)) (recur (drop 2 xs)) xs))
        ;; Phel's dispatch fn takes the arglists' names as its parameters, and
        ;; binds no _ (nor a destructuring form): each such one is named
        params (fn [v] (vec (map-indexed (fn [i p] (if (and (symbol? p) (not= '_ p)) p (symbol (str "p" i)))) v)))
        clean (map (fn [m] (apply list (first m) (map params (filter vector? (rest m)))))
                   (filter (fn [x] (php/instanceof x PersistentListInterface)) specs))
        table (fn [m] (symbol (str (name pname) "--" (name m) "--dispatch")))]
    (list 'do
          (apply list 'phel.core/defprotocol pname clean)
          (list 'def pname (list 'phel.core/assoc pname :cohost/methods
                                 (into {} (map (fn [m] [(keyword (name (first m))) (table (first m))]) clean))
                                 :doc doc))
          pname)))

;; A reify here: Phel's reify* object. Its PHP-interface methods are its own;
;; every other method is a fn of the object and the arguments, every arity in
;; one (a PHP method has one, so Phel's reify takes one), closing over the
;; reify's locals. A protocol's is handed to the protocol's dispatch table for
;; the object's class; a JVM interface's is what (.m x) calls (invoke-member),
;; and ILookup's valAt is also ArrayAccess's offsetGet, which Phel's get reads.
(defn- protocol-root [sym]
  (when-let [r (and (symbol? sym) (.resolveAsSymbol (genv) sym (NodeEnvironment/empty)))]
    (let [v (Phel/getDefinition (.encodeRegistryKey (new Munge) (.getNamespace r)) (.getName r))]
      (when (and (map? v) (contains? v :dispatch)) v))))

(defn register-reify! [cls p m k]
  (let [table (or (get (get p :cohost/methods) (keyword m))
                  (throw (ex-info (str "cohost: a reify of " (get p :name) " has no dispatch table for " m) {})))]
    (when-not (contains? (deref table) cls)
      (swap! table assoc cls (fn [this & args] (apply (get (.cohostFns this) k) this args))))
    nil))

(defn- reify-forms [specs]
  (let [[ifaces others] (split-specs specs)
        impls (loop [xs others h nil acc []]
                (if (empty? xs)
                  acc
                  (let [x (first xs)]
                    (if (symbol? x) (recur (rest xs) x acc) (recur (rest xs) h (conj acc [h x]))))))
        ks (distinct (map (fn [[h m]] [h (name (first m))]) impls))
        proto? (into {} (map (fn [k] [k (some? (protocol-root (first k)))]) ks))
        fkey (fn [k] (if (get proto? k) (str (first k) "/" (second k)) (str "." (second k))))
        clauses (fn [k] (mapcat (fn [[h m]]
                                  (when (= k [h (name (first m))])
                                    (let [tail (rest m)]
                                      (if (vector? (first tail)) [(apply list tail)] tail))))
                                impls))
        fns (gensym "fns") obj (gensym "obj") cls (gensym "cls") k (gensym "k") v (gensym "v")
        make (gensym "make") mk (gensym "mk") m (gensym "meta") m2 (gensym "m")
        lookup (some (fn [kk] (when (and (not (get proto? kk)) (= "valAt" (second kk))
                                         (php/str_ends_with (str (first kk)) "ILookup"))
                                (fkey kk)))
                     ks)]
    (list 'let [fns (into {".meta" (list 'fn '[this] '(.cohostMeta this))
                           ".withMeta" (list 'fn ['this m2] (list '.cohostWithMeta 'this m2))}
                          (map (fn [kk] [(fkey kk) (apply list 'fn (clauses kk))]) ks))
                ;; one fn makes the object, so with-meta makes another of its class
                make (list 'phel.core/atom nil)
                mk (list 'phel.core/reset! make
                         (list 'fn [m]
                               (apply list 'reify*
                                      (list 'cohostFns '[_] fns)
                                      (list 'cohostMeta '[_] m)
                                      (list 'cohostWithMeta ['_ m2] (list (list 'phel.core/deref make) m2))
                                      (concat ifaces
                                   (when lookup
                                     ['\ArrayAccess
                                      (list 'offsetGet ['this k] (list (list 'get fns lookup) 'this k))
                                      (list 'offsetExists ['this k] (list 'not (list 'nil? (list (list 'get fns lookup) 'this k))))
                                      (list 'offsetSet ['this k v] (list 'throw (list 'new '\LogicException "cohost: a reify is no mutable lookup")))
                                      (list 'offsetUnset ['this k] (list 'throw (list 'new '\LogicException "cohost: a reify is no mutable lookup")))])))))
                obj (list mk nil)
                cls (list 'php/get_class obj)]
          (apply list 'do
                 (concat (keep (fn [kk] (when (get proto? kk)
                                          (list 'cohost.hosts.phel/register-reify! cls (first kk) (second kk) (fkey kk))))
                               ks)
                         [obj])))))

;; The JVM interface methods a deftype or reify implements, and the PHP
;; interface each moves to: the one Phel's runtime reads (str's __toString, =
;; and hash's EqualsInterface and HashableInterface), or cohost's IDeref, whose
;; deref() Phel's deref calls
(php/eval "namespace cohost\\hosts\\phel; interface IDeref { public function deref(); }")
(def- host-methods
  '{java.lang.Object {toString [\Stringable __toString]
                      equals [\Phel\Lang\EqualsInterface equals]
                      hashCode [\Phel\Lang\HashableInterface hash]}
    clojure.lang.IDeref {deref [\cohost\hosts\phel\IDeref deref]}})
(def- interface-classes {'clojure.lang.IDeref "cohost\\hosts\\phel\\IDeref"})
;; what a record is besides (a struct is no map? to phel.core)
(def- record-interfaces
  '#{clojure.lang.IPersistentMap clojure.lang.IPersistentCollection clojure.lang.ILookup
     clojure.lang.Associative clojure.lang.Counted clojure.lang.Seqable clojure.lang.IRecord
     clojure.lang.IKeywordLookup clojure.lang.IHashEq clojure.lang.IObj clojure.lang.IMeta
     java.util.Map java.lang.Iterable java.io.Serializable})

;; Phel's protocol dispatch keys for the JVM classes an extend names
(def- host-types
  '{java.lang.Object :default
    java.lang.String :string java.lang.CharSequence :string
    java.lang.Long :int java.lang.Integer :int java.lang.Short :int java.lang.Byte :int java.math.BigInteger :int
    clojure.lang.BigInt :bigint java.lang.Double :float java.lang.Float :float
    java.math.BigDecimal :bigdec clojure.lang.Ratio :ratio
    java.lang.Number [:int :float :bigint :bigdec :ratio]
    java.lang.Boolean :boolean clojure.lang.Keyword :keyword clojure.lang.Symbol :symbol
    clojure.lang.PersistentVector :vector clojure.lang.IPersistentVector :vector clojure.lang.APersistentVector :vector
    clojure.lang.PersistentList :list clojure.lang.IPersistentList :list
    clojure.lang.ISeq [:list Phel.Lang.SeqInterface] clojure.lang.ASeq [:list Phel.Lang.SeqInterface]
    clojure.lang.LazySeq Phel.Lang.Collections.LazySeq.LazySeqInterface
    clojure.lang.PersistentHashMap :hash-map clojure.lang.PersistentArrayMap :hash-map
    clojure.lang.IPersistentMap :hash-map clojure.lang.APersistentMap :hash-map java.util.Map :hash-map
    clojure.lang.PersistentHashSet :set clojure.lang.IPersistentSet :set clojure.lang.APersistentSet :set java.util.Set :set
    clojure.lang.MapEntry :map-entry clojure.lang.IMapEntry :map-entry java.util.Map$Entry :map-entry
    clojure.lang.PersistentQueue :queue
    clojure.lang.Atom :atom clojure.lang.Var :var java.util.UUID :uuid
    clojure.lang.IFn :function clojure.lang.AFn :function clojure.lang.Fn :function clojure.lang.AFunction :function
    clojure.lang.Sequential [:vector :list Phel.Lang.SeqInterface]
    java.util.List [:vector :list Phel.Lang.SeqInterface]
    clojure.lang.Counted [:vector :list :hash-map :set]
    clojure.lang.Associative [:hash-map :vector]
    clojure.lang.IPersistentCollection [:vector :list :hash-map :set Phel.Lang.SeqInterface]
    clojure.lang.Seqable [:vector :list :hash-map :set Phel.Lang.SeqInterface]
    java.util.Collection [:vector :list :set Phel.Lang.SeqInterface]
    java.lang.Iterable [:vector :list :hash-map :set Phel.Lang.SeqInterface]})

;; extend, which Phel lacks: each method's fn into its table under the type's
;; dispatch keys (a class token's, through host-types; a struct type's class;
;; :nil for nil)
(defn- dispatch-key [k] (if (symbol? k) (php/str_replace "." "\\" (str k)) k))
(defn- dispatch-keys [t]
  (cond
    (nil? t) [:nil]
    (symbol? t) (let [k (get host-types t t)] (map dispatch-key (if (vector? k) k [k])))
    :else [(get (deref (.getDefinition (Registry/getInstance) "phel.core" "*type-tag-registry*")) t t)]))
(defn extend* [t & pairs]
  (loop [ps pairs]
    (when (seq ps)
      (let [tables (get (first ps) :cohost/methods)]
        (doseq [k (dispatch-keys t)]
          (doseq [e (seq (second ps))]
            (swap! (get tables (key e)) assoc k (val e)))))
      (recur (drop 2 ps))))
  nil)

;; ---------------------------------------------------------------------------
;; exceptions: the shim's are Phel ExceptionInfos (ex-data {:cohost/class c});
;; Phel's and PHP's own are named by their JVM counterparts. An ExceptionInfo's
;; message is a string: no message is a marker no message is written as.

(def- no-message "\u0000cohost:no-message")

(def- jvm-exception-classes
  {"Phel\\Lang\\Collections\\Exceptions\\IndexOutOfBoundsException" 'java.lang.IndexOutOfBoundsException
   "OutOfBoundsException" 'java.lang.IndexOutOfBoundsException
   "OutOfRangeException" 'java.lang.IndexOutOfBoundsException
   "InvalidArgumentException" 'java.lang.IllegalArgumentException
   "DomainException" 'java.lang.IllegalArgumentException
   "LengthException" 'java.lang.IllegalArgumentException
   "UnexpectedValueException" 'java.lang.IllegalArgumentException
   "DivisionByZeroError" 'java.lang.ArithmeticException
   "ArithmeticError" 'java.lang.ArithmeticException
   "TypeError" 'java.lang.ClassCastException
   "ArgumentCountError" 'clojure.lang.ArityException
   "Phel\\Lang\\ExceptionInfo" 'clojure.lang.ExceptionInfo})

(defn- exception-class [e]
  (or (get jvm-exception-classes (php/get_class e)) 'java.lang.RuntimeException))

(defn- exception-message [e]
  (let [m (.getMessage e)] (when-not (= no-message m) m)))

(defn- new-ex-info
  ([msg m] (new ExceptionInfo (if (nil? msg) no-message msg) m))
  ([msg m cause] (new ExceptionInfo (if (nil? msg) no-message msg) m cause)))

;; Throwable.toString: the class's full name, then ": message" when it has one
(defn- exception-string [e]
  (let [k (or (when (php/instanceof e ExceptionInfo) (get (ex-data e) :cohost/class)) (exception-class e))
        m (exception-message e)]
    (if (nil? m) (str k) (str k ": " m))))

;; ---------------------------------------------------------------------------
;; java.lang.Math: PHP's functions of doubles (fpow is IEEE 754's pow), and
;; JvmMath (phel_host.php) for those PHP lacks

(defn- d [x] (php/floatval x))
(defn- jvm-math-fn [m] (let [f (str "cohost\\hosts\\phel\\JvmMath::" m)] (fn [& args] (php/call_user_func_array f (to-php-array args)))))
(def- jvm-math
  {'sin (fn [x] (php/sin (d x))) 'cos (fn [x] (php/cos (d x))) 'tan (fn [x] (php/tan (d x)))
   'asin (fn [x] (php/asin (d x))) 'acos (fn [x] (php/acos (d x))) 'atan (fn [x] (php/atan (d x)))
   'atan2 (fn [y x] (php/atan2 (d y) (d x)))
   'sinh (fn [x] (php/sinh (d x))) 'cosh (fn [x] (php/cosh (d x))) 'tanh (fn [x] (php/tanh (d x)))
   'exp (fn [x] (php/exp (d x))) 'expm1 (fn [x] (php/expm1 (d x)))
   'log (fn [x] (php/log (d x))) 'log10 (fn [x] (php/log10 (d x))) 'log1p (fn [x] (php/log1p (d x)))
   'sqrt (fn [x] (php/sqrt (d x))) 'hypot (fn [a b] (php/hypot (d a) (d b)))
   'pow (fn [a b] (php/fpow (d a) (d b)))
   'cbrt (let [f (jvm-math-fn "cbrt")] (fn [x] (f (d x))))
   'ulp (let [f (jvm-math-fn "ulp")] (fn [x] (f (d x))))
   'nextUp (let [f (jvm-math-fn "nextUp")] (fn [x] (f (d x))))
   'nextDown (let [f (jvm-math-fn "nextDown")] (fn [x] (f (d x))))
   'nextAfter (let [f (jvm-math-fn "nextAfter")] (fn [a b] (f (d a) (d b))))
   'getExponent (let [f (jvm-math-fn "getExponent")] (fn [x] (f (d x))))
   'scalb (let [f (jvm-math-fn "scalb")] (fn [a n] (f (d a) (php/intval n))))
   'copySign (let [f (jvm-math-fn "copySign")] (fn [a b] (f (d a) (d b))))
   'IEEEremainder (let [f (jvm-math-fn "IEEEremainder")] (fn [a b] (f (d a) (d b))))})

;; ---------------------------------------------------------------------------

(def adapter
  {:name :phel
   :core-ns 'phel.core
   :catch-all 'Throwable
   :read-forms read-forms
   ;; Phel's special forms are fn, let, loop; letfn is phel.core's macro, named
   ;; qualified (cohost.core's letfn, the stock macro, expands to letfn*). And
   ;; defonce is a special form too: an entry of its own name, so a call of the
   ;; stock macro is written qualified
   :special-forms '{fn* fn let* let loop* loop letfn* phel.core/letfn defonce defonce}
   ;; a fn's & rest argument is a vector
   :rest-args :vector
   ;; Phel applies a def's :inline fn at compile time, and core.clj's build
   ;; JVM interop: they are stripped, and the codemod applies them
   :inline-meta :strip
   :rewrite-inline? true
   :code-form as-code
   :eval (fn [form] (eval (as-code form)))
   :read-string (fn ([s] (read-one s {})) ([s opts] (read-one s opts)))
   :edn-read-string edn-read-string
   ;; Phel's own core reads Phel's way (a regex is a PCRE string)
   :host-read-string (fn [s] (read-string s))
   ;; regexes are Patterns (see re-literal)
   :regex? pattern?
   :re-source (fn [re] (.-src re))
   :re-pattern re-pattern*
   :re-find-at (fn [re s from] (.find re s from))
   :re-match-full (fn [re s] (.matchFull re s))
   :re-group-count (fn [re] (.groupCount re))
   :with-ns with-ns
   :ensure-bare-ns! (fn [ns-sym] (create-ns (ns-str ns-sym)) ns-sym)
   :current-ns (fn [] (symbol (.getNs (genv))))
   :set-current-ns! (fn [ns-sym] (set-ns! (ns-str ns-sym)))
   :ns-interns ns-interns*
   :interned-var (fn [ns-sym sym] (var-of ns-sym sym))
   :ns-public-names (fn [ns-sym] (set (def-names ns-sym true)))
   :intern! intern!
   :refer-all! (fn [into-ns from-ns] (refer! into-ns from-ns {}))
   :refer! refer!
   :refer-from-core! (fn [into-ns sym] (refer-one! into-ns sym 'phel.core))
   :alias! (fn [into-ns a target]
             (.addRequireAlias (genv) (ns-str into-ns) (Symbol/create (str a)) (Symbol/create (ns-str target))))
   :mark-macro! mark-macro!
   :core-extras {'extend extend*
                 'resolve resolve-var 'ns-resolve ns-resolve* 'the-ns the-ns* 'ns-name ns-name*
                 'intern (fn ([ns sym] (or (var-of ns sym) (intern! ns sym unbound)))
                             ([ns sym val] (intern! ns sym val)))
                 're-pattern re-pattern*
                 ;; which Phel lacks: its namespaces are their names
                 'all-ns (fn [] (seq (loaded-namespaces)))
                 'newline (fn [] (print "\n") nil)
                 ;; an inst is Phel's #inst, a DateTimeImmutable
                 'inst? (fn [x] (php/instanceof x \DateTimeInterface))
                 'inst-ms (fn [x] (if (php/instanceof x \DateTimeInterface)
                                    (php/intval (.format x "Uv"))
                                    (throw (adapter/ex* 'java.lang.IllegalArgumentException
                                                        (str "No implementation of method: :inst-ms* of protocol: #'clojure.core/Inst found for class: " (php/get_debug_type x))))))}
   ;; (phel.core's intern answers a symbol: the shim's own makes Var.create's;
   ;; its format is PHP's sprintf: core.clj's boots over the shim's Formatter)
   ;; record?, which Phel lacks: a struct no deftype made
   :resolve-core (fn [sym]
                   (if (= 'record? sym)
                     (var-of 'cohost.hosts.phel 'record?*)
                     (let [v (when-not (contains? '#{intern format read-string} sym) (var-of 'phel.core sym))]
                       (when (and v (not (:private (meta v)))) v))))
   :user-type? user-type?
   :invoke-member invoke-member
   :host-type (fn [token] (get host-types token))
   :type-method-style :protocols
   ;; a protocol method's impl is one clause per arity (Phel's extend-type
   ;; makes them one multi-arity fn)
   :protocol-impl-style :per-arity
   :protocol-var? (fn [ns-sym name-sym]
                    (boolean (when-let [v (var-of ns-sym name-sym)]
                               (let [r (.getDefinition (Registry/getInstance) (.getNamespace v) (.getName v))]
                                 (and (map? r) (contains? r :dispatch))))))
   ;; a struct's name is its constructor fn, which phel.core's type registry
   ;; maps to its class
   :class-instance? (fn [c x]
                      (let [cls (get (deref (.getDefinition (Registry/getInstance) "phel.core" "*type-tag-registry*")) c)]
                        (boolean (cond cls (php/is_a x cls)
                                       (string? c) (php/is_a x c)
                                       :else false))))
   :host-method (fn [token m] (get-in host-methods [token m]))
   :host-instance? (fn [token x]
                     (let [c (get interface-classes token)]
                       (boolean (cond c (php/is_a x c)
                                      (and (contains? record-interfaces token) (record?* x)) true
                                      ;; a reify carries metadata
                                      (contains? '#{clojure.lang.IObj clojure.lang.IMeta} token) (and (php/is_object x) (php/method_exists x "cohostMeta"))
                                      :else false))))
   :require-host! (fn [lib] (throw (ex-info (str "cohost: phel has no require at run time: " lib) {:lib lib})))
   :var-ns (fn [v] (symbol (.getNamespace v)))
   :var-sym (fn [v] (symbol (.getName v)))
   :var? (fn [x] (php/instanceof x PhelVar))
   :namespace? (fn [_] false)
   :dynamic-var? (fn [v] (boolean (or (.isDynamic v) (:dynamic (meta v)))))
   :set-dynamic! (fn [v] (set-var-meta! v (assoc (meta v) :dynamic true)))
   :alter-var-meta! alter-var-meta!
   :push-thread-bindings! push-bindings!
   :pop-thread-bindings! (fn [] (.popFrame (DynamicScope/getInstance)))
   :var-thread-bound? (fn [v] (.hasBinding (DynamicScope/getInstance) (.getNamespace v) (.getName v)))
   :thread-bindings thread-bindings
   ;; var-get reads the thread's binding first (phel.core's reads the root)
   :var-get (fn [v] (let [ds (DynamicScope/getInstance) ns (.getNamespace v) nm (.getName v)]
                      (if (.hasBinding ds ns nm) (.getBinding ds ns nm) (.getDefinition (Registry/getInstance) ns nm))))
   :var-raw-root (fn [v] (.getDefinition (Registry/getInstance) (.getNamespace v) (.getName v)))
   :var-bound? var-bound?
   :var-meta var-meta
   :meta (fn [x] (cond (php/instanceof x PhelVar) (var-meta x)
                       (and (php/is_object x) (php/method_exists x "cohostMeta")) (.cohostMeta x)
                       :else (meta x)))
   :lazy-seq (fn [f] (lazy-seq (f)))
   :delay (fn [f] (delay (f)))
   ;; a PHP scalar or array is never a user type; and phel.core's class of a
   ;; string is the class that string names, which the shim's type lookup is not
   :host-data? (fn [x] (not (php/is_object x)))
   :exception? (fn [x] (php/instanceof x \Throwable))
   :exception-class exception-class
   :exception-message exception-message
   :exception-string exception-string
   :ex-info new-ex-info
   :char-code (fn [c] (php/mb_ord c))
   :char? (fn [x] (and (string? x) (= 1 (php/mb_strlen x))))
   :transient? (fn [x] (or (php/instanceof x TransientVectorInterface) (php/instanceof x TransientMapInterface)
                           (php/instanceof x TransientHashSetInterface)))
   :lazy-seq? (fn [x] (php/instanceof x LazySeqInterface))
   :atom? (fn [x] (php/instanceof x Atom))
   ;; Phel's reference and number types
   :volatile? (fn [x] (php/instanceof x Volatile))
   :delay? (fn [x] (php/instanceof x Delay))
   :reduced? (fn [x] (php/instanceof x Reduced))
   :deref? (fn [x] (or (php/instanceof x Atom) (php/instanceof x Volatile) (php/instanceof x Delay)
                       (php/instanceof x Reduced) (php/instanceof x Future) (php/instanceof x PhelVar)
                       (php/is_a x "cohost\\hosts\\phel\\IDeref")))
   :pending? (fn [x] (or (php/instanceof x Delay) (php/instanceof x LazySeqInterface) (php/instanceof x Future)))
   :uuid? (fn [x] (php/instanceof x UUID))
   :bigint? (fn [x] (php/instanceof x BigInt))
   :ratio? (fn [x] (php/instanceof x Ratio))
   :decimal? (fn [x] (php/instanceof x BigDecimal))
   :sorted? (fn [x] (or (php/instanceof x PersistentSortedMap) (php/instanceof x PersistentSortedSet)))
   :nano-time (fn [] (php/hrtime true))
   :current-time-millis (fn [] (php/intdiv (php/hrtime true) 1000000))
   :math-ceil (fn [x] (php/ceil x))
   :math-floor (fn [x] (php/floor x))
   :math-sqrt (fn [x] (php/sqrt x))
   :math jvm-math
   ;; (a PHP int saturates: one that does not print back as written overflowed)
   :parse-long (fn [s] (when (= 1 (php/preg_match "/^[+-]?[0-9]+$/" s))
                         (let [v (php/intval s 10)
                               digits (php/preg_replace "/^(-?)0*(?=[0-9])/" "$1" (php/ltrim s "+"))]
                           (when (or (= 0 v) (= digits (php/strval v))) v))))
   :parse-double (fn [s] (php/floatval s))
   :upper-case (fn [s] (php/mb_strtoupper (str s)))
   :lower-case (fn [s] (php/mb_strtolower (str s)))
   ;; a host array is an ArrayObject: a PHP array is a value, which an aset in
   ;; a callee would change for the callee alone
;; Character's classes are Unicode's (PCRE's \p classes)
   :java-statics {'Character/isLetter (fn [c] (= 1 (php/preg_match "/^\\p{L}$/u" (str c))))
                  'Character/isDigit (fn [c] (= 1 (php/preg_match "/^\\p{Nd}$/u" (str c))))
                  'Character/isLetterOrDigit (fn [c] (= 1 (php/preg_match "/^[\\p{L}\\p{Nd}]$/u" (str c))))
                  'Character/isAlphabetic (fn [c] (= 1 (php/preg_match "/^[\\p{L}\\p{Nl}]$/u" (str c))))
                  'Character/isUpperCase (fn [c] (= 1 (php/preg_match "/^\\p{Lu}$/u" (str c))))
                  'Character/isLowerCase (fn [c] (= 1 (php/preg_match "/^\\p{Ll}$/u" (str c))))}
   :to-array (fn [coll] (new \ArrayObject (to-array coll)))
   :array? (fn [x] (php/instanceof x \ArrayObject))
   :sort-array! (fn [arr cmp] (.exchangeArray arr (to-array (sort cmp (vec arr)))) arr)
   :index-of (fn [s sub from] (let [i (php/mb_strpos s sub from)] (if (php/=== i false) -1 i)))})

;; A float becomes a string (in the code Phel compiles, and in str) with PHP's
;; precision, 14 digits by default: 0.49999999999999994 compiled as 0.5. -1 is
;; the shortest string that reads back as the same double, as the JVM writes it.
;; (phel-config.php sets it before Phel compiles anything; this, where it ran
;; from elsewhere.)
(php/ini_set "precision" "-1")

;; cohost's boot redefines names as a REPL session does (core.clj's let, fn,
;; defn twice); Phel allows that in its interactive mode
(Phel/addDefinition "phel.core" "*interactive-mode*" true)

(adapter/install! adapter)
