(ns cohost.object-eve
  "jank-seat hosting for the converged object (Eve-in-cohost unit 6, doc/eve-cohost/UNIT6-DESIGN.md sections 3a,
   8.2 option (a)): Eve's completion builds its instances as cohost's object. cohost supplies its struct --
   cohost_object, through cohost.hosts.jank-host's new-object / cohost-object? / instance-desc / inst-fields -- and
   nothing else; Eve's completion (eve.host-completion/set-host-object!, the Eve-side change) builds it, with Eve's
   tag in the descriptor slot, Eve's field vector in the fields slot, and Eve's own =, hash and print
   (eve.host-completion/object-behaviors) in the equiv / hasheq / toString / toCodeString slots. The other slots stay
   nil: an Eve value answers Eve's protocols, as before. Told apart from cohost's own types by descriptor family: a
   cohost type's descriptor is a map, an Eve instance's is its tag, a symbol (DJ-2: one object, told apart by tag).

   jank-only (.jank); nothing in cohost's shim or boot requires it -- loaded where Eve's jank realization is on the
   module path, after cohost.hosts.jank-host. Requiring it loads Eve's completion and installs the object at once,
   so every Eve namespace loaded after it makes cohost objects (an eve_obj made before still counts as Eve's: the
   completion's object? answers both)."
  (:require [cohost.hosts.jank-host :as jank-host]
            [eve.host-completion :as completion]))

(def ^:private eve-methods
  (let [{:keys [equiv hash str]} completion/object-behaviors]
    [equiv hash str str nil nil nil nil nil nil]))

(defn eve-instance?
  "x is an Eve instance in cohost's object: a cohost object whose descriptor is a symbol (Eve's tag)."
  [x]
  (and (jank-host/cohost-object? x) (symbol? (jank-host/instance-desc x))))

(defn install!
  "Give Eve's completion cohost's object for its instances. Returns true."
  []
  (completion/set-host-object! {:make (fn [tag fields] (jank-host/new-object tag eve-methods fields))
                                :object? eve-instance?
                                :tag jank-host/instance-desc
                                :fields jank-host/inst-fields})
  true)

(install!)
