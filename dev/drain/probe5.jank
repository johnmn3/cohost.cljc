(ns probe5
  (:require [cohost.hosts.jank-host]))

(defn attempt [label f]
  (try (println label "=>" (pr-str (f)))
       (catch cpp/jank.runtime.object_ref e
         (println label "THREW:" (try (ex-message e) (catch cpp/jank.runtime.object_ref _ "<none>"))))))

(attempt "find-ns cohost.core (unloaded)" #(find-ns 'cohost.core))
(attempt "find-ns clojure.core" #(some? (find-ns 'clojure.core)))
(attempt "ns-interns clojure.core has conj" #(some? (get (ns-interns 'clojure.core) 'conj)))
(attempt "candidate interned-var unloaded" #(when (find-ns 'cohost.core) (get (ns-interns 'cohost.core) '*agent*)))
(attempt "candidate interned-var clojure.core/conj" #(when (find-ns 'clojure.core) (get (ns-interns 'clojure.core) 'conj)))
(println "PROBE5 done")
