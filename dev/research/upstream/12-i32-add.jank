;; jank-12: + - * on two small integers compute in 32 bits.
(println "(+ 2147483647 1) =>" (+ 2147483647 1))
(println "(inc 2147483647) =>" (inc 2147483647))
(println "(+ 2147483647 2147483647) =>" (+ 2147483647 2147483647))
(println "(- -2147483648 1) =>" (- -2147483648 1))
(println "(* 65536 65536) =>" (* 65536 65536))
(println "(* 2147483647 2) =>" (* 2147483647 2))
(println "(reduce + (range 1000000)) =>" (reduce + (range 1000000)))
(println "(+ 3000000000 1) =>" (+ 3000000000 1))
(println "(let [a 2147483647 b 1] (+ a b)) =>" (let [a 2147483647 b 1] (+ a b)))
(defn add2 [a b] (+ a b))
(println "(add2 2147483647 1) =>" (add2 2147483647 1))
;; U1-1 (i64 overflow, Clojure's semantics): + - * throw on i64 overflow as inc does; +' promotes.
;; Expected after the patch: throws, throws, throws, throws, 9223372036854775808.
;; On apt 0.1-noble: throws, -9223372036854775808, 9223372036854775807, 0, 9223372036854775808.
(defn ovf [f] (try (str (f)) (catch :default e "throws")))
(println "(inc 9223372036854775807) =>" (ovf #(inc 9223372036854775807)))
(println "(+ 9223372036854775807 1) =>" (ovf #(+ 9223372036854775807 1)))
(println "(- -9223372036854775807 2) =>" (ovf #(- -9223372036854775807 2)))
(println "(* 4294967296 4294967296) =>" (ovf #(* 4294967296 4294967296)))
(println "(+' 9223372036854775807 1) =>" (ovf #(+' 9223372036854775807 1)))
