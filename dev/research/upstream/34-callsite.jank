;; jank-34: a variadic call goes through jit_variadic_function::call's arity switch and a virtual
;; call; a multimethod call is three dynamic calls. 29's shapes, plus the redefinition and
;; dispatch-shape lines.
(defn id1 [x] x)
(defn id2 [x y] x)
(defn idv [x & ys] x)
(defn idv-first [x & ys] (first ys))
(defn idv-count [x & ys] (+ x (count ys)))
(defmulti mm (fn [x] 0))
(defmethod mm 0 [x] x)
(defmulti par (fn [x] (if (even? x) :even :odd)))
(defmethod par :even [x] x)
(defmethod par :odd [x] x)
(defmulti kw-mm :k)
(defmethod kw-mm :a [m] 1)
(defmethod kw-mm :b [m] 2)
(def ma {:k :a}) (def mb {:k :b})
(def n 10000000)
(timed "fn-call 1e7" (fn [] (loop [i 0] (if (< i n) (recur (inc (id1 i))) i))))
(timed "call-2 1e7" (fn [] (loop [i 0] (if (< i n) (recur (inc (id2 i i))) i))))
(timed "call-variadic 1e7" (fn [] (loop [i 0] (if (< i n) (recur (inc (idv i i))) i))))
(timed "call-variadic-first 1e7" (fn [] (loop [i 0] (if (< i n) (recur (inc (idv-first i i))) i))))
(timed "call-variadic-count 1e7" (fn [] (loop [i 0] (if (< i n) (recur (idv-count i i)) i))))
(timed "multi-one-method 1e7" (fn [] (loop [i 0] (if (< i n) (recur (inc (mm i))) i))))
(timed "multi-two-methods-alternating 1e7" (fn [] (loop [i 0] (if (< i n) (recur (inc (par i))) i))))
(timed "multi-keyword-alternating 1e7" (fn [] (loop [i 0 c 0] (if (< i n) (recur (inc i) (+ c (kw-mm (if (even? i) ma mb)))) c))))
;; correctness: escaping rest params (Clojure prints (2 3) [(2 3)] (5 6) 3 nil)
(defn ret-rest [x & ys] ys)
(def store (atom nil))
(defn keep-rest [x & ys] (reset! store ys) x)
(defn next-rest [x & ys] (next ys))
(defn first-rest [x & ys] (first ys))
(keep-rest 1 5 6)
(println "escaping" (ret-rest 1 2 3) [(ret-rest 1 2 3)] @store (first-rest 1 3 4) (next-rest 1 2) "expected (2 3) [(2 3)] (5 6) 3 nil")
;; correctness: methods, prefers and the hierarchy changing mid-loop
(defmulti grow (fn [x] (:t x)))
(defmethod grow :default [x] :default)
(def seen-add (loop [i 0 acc []] (if (< i 4) (do (when (= i 2) (defmethod grow :a [x] :a)) (recur (inc i) (conj acc (grow {:t :a})))) acc)))
(derive ::square ::shape)
(derive ::square ::rect)
(defmulti shape-kind :t)
(defmethod shape-kind ::shape [x] :shape)
(defmethod shape-kind ::rect [x] :rect)
(def seen-prefer (do (prefer-method shape-kind ::rect ::shape) (shape-kind {:t ::square})))
(defmulti tagged :t)
(defmethod tagged ::animal [x] :animal)
(defmethod tagged :default [x] :default)
(def seen-derive (loop [i 0 acc []] (if (< i 4) (do (when (= i 2) (derive ::dog ::animal)) (recur (inc i) (conj acc (tagged {:t ::dog})))) acc)))
(println "multi" seen-add seen-prefer seen-derive "expected [:default :default :a :a] :rect [:default :default :animal :animal]")
;; correctness (34): a variadic var redefined mid-loop, rebound with with-redefs, and called
;; with every arg count around its arities (Clojure prints [1 1 2 2] [:r :r] [0 1 (2) (2 3)] [:one [1 2 nil] [1 2 (3)]])
(def vf (fn [& xs] 1))
(defn call-vf [] (vf 1 2))
(def seen-redef (loop [i 0 acc []] (if (< i 4) (do (when (= i 2) (def vf (fn [& xs] 2))) (recur (inc i) (conj acc (call-vf)))) acc)))
(defn vg [& xs] :v)
(def seen-redefs [(with-redefs [vg (fn [& xs] :r)] (vg 1 2)) (with-redefs [vg (fn [a b] :r)] (vg 1 2))])
(defn va ([] 0) ([a] 1) ([a & r] r))
(def seen-arities [(va) (va 1) (va 1 2) (va 1 2 3)])
(defn vb ([a] :one) ([a b & r] [a b r]))
(def seen-vb [(vb 1) (vb 1 2) (vb 1 2 3)])
(println "variadic" seen-redef seen-redefs seen-arities seen-vb "expected [1 1 2 2] [:r :r] [0 1 (2) (2 3)] [:one [1 2 nil] [1 2 (3)]]")
;; correctness (34): dispatch shapes (Clojure prints :c :b :b nil :x [2 3] :two)
(defmulti mc (fn [x] :c)) (defmethod mc :c [x] :c)
(defmulti mk (fn [m] (:k m))) (defmethod mk :b [m] :b) (defmethod mk :default [m] nil)
(defmulti mg (fn [m] (get m :k))) (defmethod mg :b [m] :b)
(defmulti mn (fn [x] nil)) (defmethod mn nil [x] nil)
(defmulti m2 (fn [a b] :two)) (defmethod m2 :two [a b] :two)
(def mx-sym :x) (defmulti mx (fn [x] mx-sym)) (defmethod mx :x [x] :x)
(println "shapes" (mc 1) (mk {:k :b}) (mg {:k :b}) (mn 1) (mx 1) [(par 2) (par 3)] (m2 1 2) "expected :c :b :b nil :x [2 3] :two")
