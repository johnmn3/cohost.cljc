;; jank-20: a ^long parameter unboxes on entry, but the return is always boxed, so a hinted
;; leaf fn is slower than the unhinted one; a return hint is ignored.
(defn add-plain [a b] (+ a b))
(defn add-hinted [^long a ^long b] (+ a b))
(defn ^long add-ret-hinted [^long a ^long b] (+ a b))
(defn fib-plain [n] (if (< n 2) n (+ (fib-plain (dec n)) (fib-plain (- n 2)))))
(defn fib-hinted [^long n] (if (< n 2) n (+ (fib-hinted (dec n)) (fib-hinted (- n 2)))))
(cpp/raw "namespace r20 { inline long fib(long n) { return n < 2 ? n : fib(n - 1) + fib(n - 2); } }")
(defn fib-cpp [^long n] (cpp/r20.fib n))
(def n 2000000)
(timed "2e6 calls add-plain" (fn [] (loop [i 0 acc 0] (if (< i n) (recur (inc i) (add-plain acc 3)) acc))))
(timed "2e6 calls add-hinted (^long params)" (fn [] (loop [i 0 acc 0] (if (< i n) (recur (inc i) (add-hinted acc 3)) acc))))
(timed "2e6 calls add-ret-hinted (^long params and return)" (fn [] (loop [i 0 acc 0] (if (< i n) (recur (inc i) (add-ret-hinted acc 3)) acc))))
(timed "fib 30 plain" #(fib-plain 30))
(timed "fib 30 ^long param" #(fib-hinted 30))
(timed "fib 30 in C++ through cpp/raw" #(fib-cpp 30))
;; Correctness of a native entry (U6). Expected (Clojure):
;;   native results: 9000000000000000000 2.5 0 5050 [3 2 1] 1024 3.5 6765 5
;;   native overflow: throws 4611686018427387904 throws
;;   native via apply/map: 3 [1 4 9] [0.5 1.5]
(defn ^long sq-ret [^long x] (* x x))
(defn ^double half [^double x] (/ x 2.0))
(defn count-down [^long n] (if (< n 1) 0 (count-down (dec n))))
(defn sum-to [^long n] (if (< n 1) 0 (+ n (sum-to (dec n)))))
(defn mixed [^long n acc] (if (< n 1) acc (mixed (dec n) (conj acc n))))
(defn multi ([^long n] (multi n 1)) ([^long n ^long k] (if (< n 1) k (multi (dec n) (* k 2)))))
(defn dbl [^long n ^long k] (if (< k 1) n (dbl (* n 2) (dec k))))
(defn real-tail [^long n] (if (< n 1) 0.5 (+ 1.0 (real-tail (dec n)))))
(println "native results:" (sq-ret 3000000000) (half 5.0) (count-down 10000) (sum-to 100) (mixed 3 []) (multi 10) (real-tail 3)
         (fib-hinted 20) (add-ret-hinted 2 3))
(println "native overflow:" (try (sq-ret 4000000000) (catch :default e "throws")) (dbl 1 62) (try (dbl 1 64) (catch :default e "throws")))
(println "native via apply/map:" (apply add-hinted [1 2]) (vec (map sq-ret [1 2 3])) (vec (map half [1.0 3.0])))
