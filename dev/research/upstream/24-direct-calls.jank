;; jank-24: a call through a var is a var deref plus a dynamic call; variadic and multimethod calls cost more.
(ns p24.other)
(defn id1 [x] x)
(ns user (:require [p24.other]))
(defn id1 [x] x)
(defn id2 [x y] x)
(defn idv [x & ys] x)
(defmulti mm (fn [x] 0))
(defmethod mm 0 [x] x)
(cpp/raw "namespace r24 {
  inline jank::runtime::object_ref id(jank::runtime::object_ref x) { return x; }
}")
(def n 10000000)
(timed "loop-only 1e7" (fn [] (loop [i 0] (if (< i n) (recur (inc i)) i))))
(timed "call-cpp-objref 1e7" (fn [] (loop [i 0] (if (< i n) (recur (inc (cpp/r24.id i))) i))))
(timed "call-var-same-ns 1e7" (fn [] (loop [i 0] (if (< i n) (recur (inc (id1 i))) i))))
(timed "call-var-other-ns 1e7" (fn [] (loop [i 0] (if (< i n) (recur (inc (p24.other/id1 i))) i))))
(timed "call-local 1e7" (fn [] (let [f id1] (loop [i 0] (if (< i n) (recur (inc (f i))) i)))))
(timed "call-2 1e7" (fn [] (loop [i 0] (if (< i n) (recur (inc (id2 i i))) i))))
(timed "call-variadic 1e7" (fn [] (loop [i 0] (if (< i n) (recur (inc (idv i i))) i))))
(timed "call-multi 1e7" (fn [] (loop [i 0] (if (< i n) (recur (inc (mm i))) i))))
;; redefinition: a call compiled against one definition must see the next (Clojure prints 1 2 3 2 [:a :b])
(defn rf [] 1)
(defn call-rf [] (rf))
(def r1 (call-rf))
(defn rf [] 2)
(def r2 (call-rf))
(def r3 (with-redefs [rf (fn [] 3)] (loop [i 0 x 0] (if (< i 3) (recur (inc i) (call-rf)) x))))
(def r4 (call-rf))
(defn rv [a] [:a a])
(defn call-rv [] (rv :b))
(alter-var-root (var rv) (fn [_] (fn [a] [:a a])))
(println "redefinition" r1 r2 r3 r4 (call-rv) "expected 1 2 3 2 [:a :b]")
(defn ^:dynamic dyn-f [] :root)
(defn call-dyn [] (dyn-f))
(println "binding" (binding [dyn-f (fn [] :bound)] (call-dyn)) (call-dyn) "expected :bound :root")
(defn arity-f ([x] [:one x]) ([x y] [:two x y]) ([x y & zs] [:many x y zs]))
(println "arities" (arity-f 1) (arity-f 1 2) (arity-f 1 2 3) (idv 1) (idv 1 2 3) "expected [:one 1] [:two 1 2] [:many 1 2 (3)] 1 1")
