;; jank-32: the f64 variant of 28. An untyped param of an arity doing real arithmetic is
;; speculated as f64 (as i64 when the body shows integer evidence: an inc/nth/quot operand, or
;; arithmetic against an integer literal or an integer loop local); the boxing entry picks the
;; i64 entry, the f64 entry or the generic body by each argument's tag. An integer is never
;; converted to a real, so (scale 2) is still Clojure's 3.0 and a string takes the generic body.
;; Expected (Clojure 1.12, the same forms with Math/sqrt; nbody's value scaled by 1e9, rounded):
;;   real speculation: 3.0 3.0 throws 55.0 55.0 57054003 true 0.125 50 50 2
(cpp/raw "#include <cmath>\nnamespace r32 { inline double sqrt_(double x) { return std::sqrt(x); } }")
(defn ovf [f] (try (f) (catch :default e "throws")))
(defn scale [x] (* x 1.5))
(defn down-d [n] (loop [i n acc 0.0] (if (< 0.0 i) (recur (- i 1.0) (+ acc i)) acc)))
(defn down-d-hinted [^double n] (loop [i n acc 0.0] (if (< 0.0 i) (recur (- i 1.0) (+ acc i)) acc)))
(defn kstep [n bx cx]
  (loop [i 0 e 0.0 bx bx cx cx]
    (if (< i n)
      (let [dx (- bx cx) dy (- 2.0 5.5) dz (- 3.0 6.25)
            dist (cpp/r32.sqrt_ (+ (* dx dx) (* dy dy) (* dz dz)))
            mag (/ 0.01 (* dist dist dist))]
        (recur (inc i) (+ e mag) (- bx (* dx 0.5 mag)) (+ cx (* dx 0.5 mag))))
      e)))
(defn kstep-hinted [^long n ^double bx ^double cx]
  (loop [i 0 e 0.0 bx bx cx cx]
    (if (< i n)
      (let [dx (- bx cx) dy (- 2.0 5.5) dz (- 3.0 6.25)
            dist (cpp/r32.sqrt_ (+ (* dx dx) (* dy dy) (* dz dz)))
            mag (/ 0.01 (* dist dist dist))]
        (recur (inc i) (+ e mag) (- bx (* dx 0.5 mag)) (+ cx (* dx 0.5 mag))))
      e)))
(defn eval-a [i j] (/ 1.0 (+ (quot (* (+ i j) (+ i j 1)) 2) (inc i))))
(defn mandel [cr ci] (loop [zr 0.0 zi 0.0 k 0] (if (and (< k 50) (< (+ (* zr zr) (* zi zi)) 4.0)) (recur (+ (- (* zr zr) (* zi zi)) cr) (+ (* 2.0 zr zi) ci) (inc k)) k)))
(println "real speculation:" (scale 2) (scale 2.0) (ovf #(scale "a")) (down-d 10.0) (down-d 10)
         (cpp/jank.runtime.to_int (* 1e9 (kstep 1000 1.0 4.0))) (= (kstep 10 1 4) (kstep 10 1.0 4.0)) (eval-a 1 2) (mandel -0.5 0.5) (mandel 0 0) (mandel 1.0 1.0))
(timed "down-d 2e6 (untyped, real arg)" #(down-d 2000000.0))
(timed "down-d-hinted 2e6 (^double)" #(down-d-hinted 2000000.0))
(timed "kstep 1e6 (untyped n bx cx)" #(kstep 1000000 1.0 4.0))
(timed "kstep-hinted 1e6" #(kstep-hinted 1000000 1.0 4.0))
(timed "eval-a 1e6 (two untyped ints into a real)" #(loop [k 0 s 0.0] (if (< k 1000000) (recur (inc k) (+ s (eval-a k 7))) s)))
(defn mandel-row [y m] (loop [x 0 m m] (if (< x 100) (recur (inc x) (+ m (mandel (- (* x 0.03) 2.0) (- (* y 0.03) 1.5)))) m)))
(timed "mandel 100x100 (untyped cr ci)" #(loop [y 0 n 0] (if (< y 100) (recur (inc y) (mandel-row y n)) n)))
