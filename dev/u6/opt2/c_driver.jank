;; unit 6 option (2) measurement (scratch): (c) interception. Counting wrappers re-root jank's clojure.core fns;
;; the counters are C++ statics, so a wrapper calls nothing it wraps. For each call site: how far the fn's counter
;; moved on one call (1 = intercepted through the var, 0 = bypassed).
(def c0 (volatile! 0)) (def c1 (volatile! 0)) (def c2 (volatile! 0)) (def c3 (volatile! 0)) (def c4 (volatile! 0))
(def c5 (volatile! 0)) (def c6 (volatile! 0)) (def c7 (volatile! 0)) (def c8 (volatile! 0)) (def c9 (volatile! 0))
(def cs {0 c0 1 c1 2 c2 3 c3 4 c4 5 c5 6 c6 7 c7 8 c8 9 c9})
(require 'u6o2.callsites)
(println "MODULE marker" u6o2.callsites/marker "(pre-count [1 2]) =" (u6o2.callsites/pre-count [1 2]))
(def names ['count 'seq 'first 'next 'rest 'coll? 'counted? 'empty? 'nth 'get])
(defn wrap! [i s]
  (let [v (resolve (symbol "clojure.core" (name s))) core @v c (cs i)]
    (alter-var-root v (fn [_] (fn ([a] (vswap! c inc) (core a))
                                 ([a b] (vswap! c inc) (core a b))
                                 ([a b c2] (vswap! c inc) (core a b c2)))))))
(wrap! 0 'count) (wrap! 1 'seq) (wrap! 2 'first) (wrap! 3 'next) (wrap! 4 'rest)
(wrap! 5 'coll?) (wrap! 6 'counted?) (wrap! 7 'empty?) (wrap! 8 'nth) (wrap! 9 'get)
;; compiled after the re-root (JIT, this file)
(defn post-count [v] (count v)) (defn post-seq [v] (seq v)) (defn post-first [v] (first v))
(defn post-next [v] (next v)) (defn post-rest [v] (rest v)) (defn post-coll? [v] (coll? v))
(defn post-counted? [v] (counted? v)) (defn post-empty? [v] (empty? v)) (defn post-nth [v] (nth v 0))
(defn post-get [m] (get m :a))
(defn d [label i thunk]
  (let [c (cs i) b @c _ (thunk) a @c]
    (println "INTERCEPT" label (- a b))))
(def v [1 2 3]) (def m {:a 1})
(d "control (var-get #'count) called" 0 #((var-get #'clojure.core/count) v))
(d "control (var-get #'first) called" 2 #((var-get #'clojure.core/first) v))
(d "pre  count" 0 #(u6o2.callsites/pre-count v))   (d "post count" 0 #(post-count v))
(d "pre  seq" 1 #(u6o2.callsites/pre-seq v))       (d "post seq" 1 #(post-seq v))
(d "pre  first" 2 #(u6o2.callsites/pre-first v))   (d "post first" 2 #(post-first v))
(d "pre  next" 3 #(u6o2.callsites/pre-next v))     (d "post next" 3 #(post-next v))
(d "pre  rest" 4 #(u6o2.callsites/pre-rest v))     (d "post rest" 4 #(post-rest v))
(d "pre  coll?" 5 #(u6o2.callsites/pre-coll? v))   (d "post coll?" 5 #(post-coll? v))
(d "pre  counted?" 6 #(u6o2.callsites/pre-counted? v)) (d "post counted?" 6 #(post-counted? v))
(d "pre  empty?" 7 #(u6o2.callsites/pre-empty? v)) (d "post empty?" 7 #(post-empty? v))
(d "pre  nth" 8 #(u6o2.callsites/pre-nth v))       (d "post nth" 8 #(post-nth v))
(d "pre  get" 9 #(u6o2.callsites/pre-get m))       (d "post get" 9 #(post-get m))
(d "pre  higher-order count" 0 #(u6o2.callsites/pre-ho-count v))
(d "pre  higher-order first" 2 #(u6o2.callsites/pre-ho-first v))
(d "pre  higher-order coll?" 5 #(u6o2.callsites/pre-ho-coll? v))
;; jank's own core fns (compiled into jank) over a vector: do their inner calls reach the re-rooted vars?
(d "core (doall (map inc v)) -> seq" 1 #(doall (map inc v)))
(d "core (doall (map inc v)) -> first" 2 #(doall (map inc v)))
(d "core (into [] v) -> seq" 1 #(into [] v))
(d "core (every? odd? v) -> first" 2 #(every? odd? v))
(d "core (every? odd? v) -> seq" 1 #(every? odd? v))
(d "core (last v) -> next" 3 #(last v))
(d "core (last v) -> first" 2 #(last v))
(println "DONE")
