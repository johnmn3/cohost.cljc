;; Eve-in-cohost unit 6, step 2 (doc/eve-cohost/UNIT6-DESIGN.md sections 8.2, 8.5): cohost's jank boot and battery
;; with Eve's completion loaded AND given cohost's object (cohost.object-eve), in the same process before them --
;; boot_with_completion.jank's measurement with the converged object installed.
;;
;;   LC_ALL=en_US.UTF-8 jank --module-path <aot-dir>:src:<bb classpath jank> run dev/u6/boot_with_converged.jank
;;
;; No Eve atom, region or value is used by the boot: only the completion, with the object installed, is loaded.
(require 'cohost.run)
(require 'cohost.object-eve)
(println "EVE-OBJECT-CONVERGED")
(apply cohost.run/-main (or *command-line-args* ()))
