;; Eve-in-cohost unit 6, step 4's gate row "root identity stable across a snapshot rebuild" (doc/eve-cohost/
;; UNIT6-DESIGN.md §5). Boots from the jank AOT snapshot (as dev/perf/jank_snapshot_run.jank does), turns Eve's atom
;; layer on as boot :eve-atoms does (cohost.atom-eve installed, the registry atom minted in its startup domain, the
;; booted core and user namespaces published into it: their interns and data roots, plan SS10), makes one user atom
;; holding a fixed value, and prints Eve's content digest (eve.digest/compute-digest: SHA-256 over the root's canonical
;; codec bytes, 8 i32 words) of the startup domain's root -- the registry table -- and of the user atom's root.
;;
;;   jank -O3 --module-path <the snapshot's module path> run dev/u6/snapshot_root.jank
;;
;; Run once per snapshot build: the snapshot cleaned and built again between runs, the two ROOT lines must match.
;; Its own namespace, every core name jank's: the snapshot's booted core is cohost.core, and the user namespace a
;; booted program gets (cohost.boot/make-user-ns!) refers it -- its deref is stock's, which casts to a Future.
(ns u6.snapshot-root)
(require 'cohost.run)
(require 'cohost.adapter)
(require 'cohost.boot)
(require 'cohost.core)
(when-not (cohost.boot/snapshot-report)
  (throw (ex-info "cohost.core loaded, but it is not a snapshot (no snapshot report)" {})))
(require 'cohost.atom)
(require 'cohost.atom-eve)
(require 'eve.digest)
(cohost.atom-eve/install!)
(def registry (cohost.atom/registry-atom))
(cohost.atom/set-fill! true)
(doseq [ns-sym [cohost.boot/core-ns cohost.boot/user-ns]]
  (cohost.atom/publish-namespace! ns-sym))
(def user-atom (cohost.atom/make-atom {:u6 :snapshot-root :v [1 2 3] :s "eve"}))
(def compute (resolve 'eve.digest/compute-digest))
(let [table @registry]
  (println "ROOT startup-domain namespaces" (count table)
           "entries" (reduce + (map count (vals table)))
           "digest" (pr-str (compute table))))
(println "ROOT user-atom digest" (pr-str (compute @(cohost.atom/eve-handle user-atom)))
         "value" (pr-str (cohost.atom/deref-atom user-atom)))
(println "ROOT state" (pr-str (cohost.atom-eve/hosting-state)))
