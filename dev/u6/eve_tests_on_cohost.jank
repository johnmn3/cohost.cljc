;; Eve-in-cohost unit 6 (doc/eve-cohost/UNIT6-DESIGN.md sections 8.5, 8.8): Eve's own jank test runner, run inside a
;; cohost process -- cohost's jank host loaded first, as on the seat. Under option 3 there is one object: Eve's
;; completion's, which cohost's host requires first and builds its own type instances on. Eve's runner then loads the
;; named test namespaces and exits through eve.process/exit!.
;;
;;   LC_ALL=en_US.UTF-8 jank --module-path <cohost>/src:<bb classpath jank>:<eve>/adapters/completion/jank/test:\
;;     <eve>/adapters/slab-io/test:<eve>/test run dev/u6/eve_tests_on_cohost.jank -- <test-ns> ...
(require 'cohost.hosts.jank-host)
(println "EVE-ON-COHOST")
(require 'eve.runner.jank-main)
(apply (resolve 'eve.runner.jank-main/-main) "test" *command-line-args*)
