diff --git a/src/cohost/hosts/jvm.clj b/src/cohost/hosts/jvm.clj
index cc7536c..c1f08db 100644
--- a/src/cohost/hosts/jvm.clj
+++ b/src/cohost/hosts/jvm.clj
@@ -176,6 +176,21 @@
    :sorted-comparator (fn [x] (let [c (.comparator ^clojure.lang.Sorted x)]
                                 (if (ifn? c) c (fn [a b] (.compare ^java.util.Comparator c a b)))))
    :multifn? (fn [x] (instance? clojure.lang.MultiFn x))
+   ;; T4 (cohost-jvm-speed lane): the booted core's defmulti builds the
+   ;; host's own MultiFn, not the shim's — the shim's members delegate
+   ;; through :multifn-op below (its host-mf? path), and the object is
+   ;; called as the IFn it is.
+   :multifn-ctor (fn [name dispatch-fn default hierarchy]
+                   (clojure.lang.MultiFn. name dispatch-fn default hierarchy))
+   :multifn-op (fn [mf op args]
+                 (let [mf ^clojure.lang.MultiFn mf]
+                   (case op
+                     :add (do (.addMethod mf (nth args 0) (nth args 1)) mf)
+                     :remove (do (.removeMethod mf (nth args 0)) mf)
+                     :get (.getMethod mf (nth args 0))
+                     :table (.getMethodTable mf)
+                     :prefers (.getPreferTable mf)
+                     :prefer (do (.preferMethod mf (nth args 0) (nth args 1)) mf))))
    ;; a member by name: a no-arg call is a field or a no-arg method; the
    ;; existence check (cached per class) keeps a method's own
    ;; IllegalArgumentException apart from "no such member"
