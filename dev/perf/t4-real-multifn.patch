-(def new-MultiFn
+(def new-MultiFn-shim
   (fn [name dispatch-fn default hierarchy]
     (let [state (atom {:name name :dispatch-fn dispatch-fn :default default :hierarchy hierarchy :methods {} :prefers {}})
           no-method (fn [dv] (throw (host/ex* 'IllegalArgumentException (str "No method in multimethod '" name "' for dispatch value: " dv))))
@@ -1700,6 +1701,15 @@
             ([a b c] (let [dv (dispatch-fn a b c) m (mf-method state dv)] (if m (m a b c) (no-method dv))))
             ([a b c & more] (let [dv (apply dispatch-fn a b c more) m (mf-method state dv)]
                               (if m (apply m a b c more) (no-method dv))))))))))
+;; where the host has its own multimethod (adapter :multifn-ctor; the JVM's
+;; clojure.lang.MultiFn), construction returns the host object: the shim's
+;; MultiFn members delegate to it via :multifn-op (host-mf?), and it is
+;; called as the fn it is. Other hosts build the shim's own MultiFn above.
+(def new-MultiFn
+  (fn [name dispatch-fn default hierarchy]
+    (if h-multifn-ctor
+      (h-multifn-ctor name dispatch-fn default hierarchy)
+      (new-MultiFn-shim name dispatch-fn default hierarchy))))
