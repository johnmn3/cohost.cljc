;; jank-FAST Step 6 stage 2. Boot with record mode on, load the twelve
;; libraries the batteries and the bench load, and write every recorded event
;; to target/jank-snapshot/events.edn (dev/perf/jank_snapshot_emit.clj turns
;; them into modules). Does not compile. Run by dev/perf/jank_snapshot_ensure.clj
;; when the snapshot is stale.
;;   jank --module-path <aot-dir>:src run dev/perf/jank_snapshot_record.jank
;;
;; For an app's executable (D-7, src/cohost/build_jank.clj), with arguments:
;;   ... run dev/perf/jank_snapshot_record.jank -- --out <events.edn> \
;;       --root <dir> ... --lib <ns> ...
;; the --root directories are added as source roots (after the stock root, as
;; cohost.cli adds a project's), the twelve libraries are loaded, then each
;; --lib (the app's main namespace: it loads what it requires), and the
;; events go to --out.
(require 'cohost.run)
(require 'cohost.boot)
(require 'cohost.adapter)
(require 'cohost.bench)

(def opts
  (loop [args (seq (or *command-line-args* ())) o {:roots [] :libs []}]
    (if-let [[a b & more] args]
      (case a
        "--out" (recur more (assoc o :out b))
        "--root" (recur more (update o :roots conj b))
        "--lib" (recur more (update o :libs conj (symbol b)))
        (recur (next args) o))
      o)))

(let [r (cohost.boot/boot! {:record? true})]
  (cohost.boot/print-report r))
(doseq [d (:roots opts)] (cohost.boot/add-source-root! d))
(doseq [lib (concat cohost.bench/libs (:libs opts))]
  (cohost.adapter/try-all (fn [] (cohost.boot/load-lib! lib))
                          (fn [e] (println "RECORD-LIB-ERROR" lib (cohost.adapter/error-message e)))))
(let [ev (cohost.boot/snapshot-stop!)
      text (pr-str ev)]
  (cohost.adapter/spit-file (or (:out opts) "target/jank-snapshot/events.edn") text)
  (println "SNAPSHOT-EVENTS" (count ev) "bytes" (count text)))
