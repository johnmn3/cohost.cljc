;; STM lane (continuation): probe_tx on the JANK seat.
;; Run: jank --module-path src:. run dev/stm/probe_tx_jank.jank
;; Installs the jank host adapter, then loads the seat-agnostic probe
;; script (probe_tx.clj -- the same 23 semantics checks the JVM seat
;; runs) so cohost.tx executes on jank's runtime. Eve hosting is NOT
;; installed on this seat (cohost.atom-eve's jank joint is unbuilt --
;; STATUS 10), so refs seat in host atoms: this run proves the STM
;; semantics + the throw-crossing question (STATUS 1) on jank frames.
(ns probe-tx-jank
  (:require [cohost.hosts.jank-host]
            [clojure.string :as str]))

;; Loading probe_tx.clj from raw jank (STM jank chase lane, 2026-11-06;
;; the runner as originally banked never ran -- see
;; STATUS-jank-chase.md milestones 3-9 for the measured chain):
;;   * load-file does not exist in jank's clojure.core;
;;   * load-string / load-reader exist but are "TODO: port" stubs;
;;   * `load` reaches only flat same-root modules; subdirectory modules
;;     resolve via require's ns-name -> munged-path rule, and jank's
;;     module search sees .jank/.cljc files only (.clj is invisible).
;; So the shared script is materialized as a generated .jank module
;; (gitignored; probe_tx.clj remains the single source) and required by
;; name. The generated copy is SEAT-ADAPTED in spelling only -- the
;; checks, their order and their expected values are untouched:
;;   * JVM class catches -> (catch cpp/jank.runtime.object_ref ...):
;;     on this seat every cohost-layer throw (host/ex* products and
;;     ex-infos alike) crosses as a jank object_ref, and this catch
;;     binds it properly -- (catch :default e) would bind e to nil,
;;     which the interrupt checks cannot use (they pass e to
;;     thread/interrupted-ex?). JVM class names do not resolve in
;;     jank's analyzer at all.
;;   * (Exception. "boom") -> (ex-info "boom" {}): the seat-native
;;     throwable; the abort checks only need a throw that propagates.
;;   * (Thread/sleep -> (@#'clojure.core/sleep: jank core keeps its
;;     sleep private (cpp/jank.runtime.sleep); Thread/ does not
;;     resolve on raw jank.
;;   * (System/nanoTime) -> (cpp/cohost_time.nano_time): the chrono
;;     clock cohost's jank host itself installs (jank_host.jank).
;;   * (System/exit ...) -> dropped (a println remains): raw jank has
;;     no System/exit; the probe's own PROBE-TX verdict line is the
;;     result of record.
;; (cohost's booted path fills these gaps via core-extras and the
;; codemod; this raw runner does not boot.)
(defn- jank-adapt [s]
  (-> s
      (str/replace "(catch IllegalStateException"
                   "(catch cpp/jank.runtime.object_ref")
      (str/replace "(catch Exception"
                   "(catch cpp/jank.runtime.object_ref")
      (str/replace "(Exception. \"boom\")" "(ex-info \"boom\" {})")
      (str/replace "(Thread/sleep" "(@#'clojure.core/sleep")
      (str/replace "(System/nanoTime)" "(cpp/cohost_time.nano_time)")
      (str/replace "(System/exit (if (empty? @failures) 0 1))"
                   "(println \"INFO probe_tx_jank: System/exit dropped on raw jank\")")))

(spit "dev/stm/probe_tx_jank_generated.jank"
      (str "(ns dev.stm.probe-tx-jank-generated)\n"
           (jank-adapt (slurp "probe_tx.clj"))))
(require 'dev.stm.probe-tx-jank-generated)
(println "INFO probe_tx_jank: script completed")
