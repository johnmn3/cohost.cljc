;; cohost: boot the stock clojure/core.clj inside a clojure-like.
;; Each task installs that host's adapter (src/cohost/hosts/), boots
;; core.clj, prints the boot report, and runs the behavior battery
;; (src/cohost/battery.cljc) in a namespace that sees only the booted core.
{:tasks
 {;; the source a bench ran: git HEAD, -dirty when the tree had changes
  :init (defn git-rev []
          (try (let [h (clojure.string/trim (:out (babashka.process/shell {:out :string} "git" "rev-parse" "--short" "HEAD")))
                     dirty (seq (clojure.string/trim (:out (babashka.process/shell {:out :string} "git" "status" "--porcelain" "--" "src" "bb.edn"))))]
                 (str "--git=" h (when dirty "-dirty")))
               (catch Exception _ "--git=unknown")))
  boot:jolt {:doc "jolt (Chez Scheme): the `jolt` binary on PATH"
             :task (shell "jolt" "-Scp" "src" "-m" "cohost.run")}
  boot:lpy  {:doc "basilisp (Python): the uv/pip-installed `basilisp` on PATH"
             :task (shell "basilisp" "run" "-p" "src" "-c" "(require 'cohost.run) (cohost.run/-main)")}
  boot:jvm  {:doc "JVM Clojure as the host (the reference adapter)"
             :task (shell "clojure" "-M" "-m" "cohost.run")}
  boot:cljs {:doc "ClojureScript, self-hosted on Node: compile the bootstrap build, then run it"
             :task (do (shell "clojure" "-M:cljs" "-m" "cljs.main" "-co" "cljs-node.edn" "-c")
                       (shell "node" "target/cljs-node/main.js"))}
  boot:browser {:doc "ClojureScript, self-hosted in Chromium: compile the browser build, serve it, run it under Playwright"
                :task (do (shell "clojure" "-M:cljs" "-m" "cljs.main" "-co" "cljs-browser.edn" "-c")
                          (shell "python3" "-I" "dev/browser_boot.py"))}
  eval:jolt {:doc "boot on jolt, then evaluate the arguments in the stock user namespace: bb eval:jolt '(swap! (atom 0) + 1 2 3)'"
             :task (apply shell "jolt" "-Scp" "src" "-m" "cohost.run" "--eval" *command-line-args*)}
  corpus:jolt {:doc "a conformance corpus (rows: :suite :label :actual :expected :portability), the stock core vs jolt's own core, each side in its own jolt process: bb corpus:jolt path/to/corpus.edn (the jolt-conformance corpus is jolt's test/chez/corpus.edn, https://github.com/jolt-lang/jolt)"
               ;; each side runs in target/corpus-cwd: rows that write files
               ;; (spit, a directory as a file) write them there
               :task (let [abs (fn [p] (str (babashka.fs/absolutize p)))
                           path (if-let [p (first *command-line-args*)]
                                  (abs p)
                                  (do (println "usage: bb corpus:jolt path/to/corpus.edn  (jolt's test/chez/corpus.edn: https://github.com/jolt-lang/jolt)")
                                      (System/exit 1)))
                           run (fn [side]
                                 (shell {:dir "target/corpus-cwd"} "jolt" "-Scp" (abs "src") "-e"
                                        (str "(require 'cohost.run 'cohost.corpus) (cohost.boot/boot! {:root " (pr-str (abs "resources/cohost/clojure-1.12.0")) "}) (cohost.boot/make-user-ns!) "
                                             "(cohost.corpus/run-corpus! {:path " (pr-str path) " :side " side " :out " (pr-str (abs (str "target/corpus-" (name side) ".edn"))) "}) (System/exit 0)")))]
                       (babashka.fs/create-dirs "target/corpus-cwd")
                       (run :stock)
                       (run :host)
                       (load-file "src/cohost/corpus_report.cljc")
                       (let [rd (fn [f] (clojure.edn/read-string (slurp f)))
                             merged ((resolve 'cohost.corpus-report/merge-sides) (rd "target/corpus-stock.edn") (rd "target/corpus-host.edn"))]
                         ((resolve 'cohost.corpus-report/summarize) merged 40 "jolt")))}
  corpus:jvm {:doc "after corpus:jolt: the rows jolt's core passes and the stock core fails, evaluated on JVM Clojure 1.12.0 (dev/corpus_jvm.clj) — which of them the JVM answers as the corpus expects"
              :task (let [abs (fn [p] (str (babashka.fs/absolutize p)))
                          cp (clojure.string/trim (:out (shell {:out :string} "clojure" "-Spath")))]
                      (babashka.fs/create-dirs "target/corpus-cwd")
                      (shell {:dir "target/corpus-cwd"} "java" "-cp" cp "clojure.main" (abs "dev/corpus_jvm.clj")
                             (abs "src/cohost/corpus_report.cljc") (abs "target/corpus-stock.edn")
                             (abs "target/corpus-host.edn") (abs "target/corpus-gap-jvm.edn")))}
  bench:jolt {:doc "cohost.bench on jolt: each case through jolt's own core and through the stock core, in one process (target/bench-jolt.edn)"
              :task (do (babashka.fs/create-dirs "target")
                        ;; jolt wraps calls in runtime-compiled code (cohost's) in
                        ;; trace bookkeeping unless JOLT_TRACE=0; its own core is
                        ;; compiled ahead of time: the setting rides with the results
                        (apply shell "jolt" "-Scp" "src" "-m" "cohost.run" "--bench" (git-rev)
                               (str "--note=JOLT_TRACE=" (or (System/getenv "JOLT_TRACE") "unset")) *command-line-args*))}
  bench:jvm {:doc "cohost.bench on JVM Clojure, whose own core is the baseline (target/bench-clj.edn)"
             :task (do (babashka.fs/create-dirs "target")
                       (apply shell "clojure" "-M" "-m" "cohost.run" "--bench" (git-rev) *command-line-args*))}
  bench:lpy {:doc "cohost.bench on basilisp (target/bench-lpy.edn)"
             :task (do (babashka.fs/create-dirs "target")
                       (shell "basilisp" "run" "-p" "src" "-c"
                              (str "(require 'cohost.run) (apply cohost.run/-main \"--bench\" " (pr-str (vec (cons (git-rev) *command-line-args*))) ")")))}
  bench:cljs {:doc "cohost.bench on self-hosted ClojureScript in Node (target/bench-cljs.edn)"
              :task (do (shell "clojure" "-M:cljs" "-m" "cljs.main" "-co" "cljs-node.edn" "-c")
                        (apply shell "node" "target/cljs-node/main.js" "--bench" (git-rev) *command-line-args*))}
  bench:browser {:doc "cohost.bench on self-hosted ClojureScript in Chromium (target/bench-chromium.edn)"
                 :task (do (shell "clojure" "-M:cljs" "-m" "cljs.main" "-co" "cljs-browser.edn" "-c")
                           (shell "python3" "-I" "dev/browser_boot.py" "bench"))}
  bench:report {:doc "the tables from target/bench-*.edn: every host against JVM Clojure, and each host's own core against the stock core"
                :task (load-file "dev/bench_report.clj")}
  ;; the five hosts of doc/hosts/PLAN.md; each install is dev/install/<host>.sh
  boot:cljw {:doc "ClojureWasm (Zig): the `cljw` binary on PATH (v1.15.4)"
             :task (shell "cljw" "-cp" "src" "-m" "cohost.run")}
  boot:phel {:doc "Phel (PHP 8.5): the `phel` wrapper over phel.phar on PATH (v0.54.0)"
             :task (shell "phel" "eval" "(require 'cohost.run) (cohost.run/-main)")}
  boot:lg   {:doc "let-go (Go): the `lg` binary on PATH (v1.13.0)"
             :task (shell "lg" "-source-paths" "src" "-m" "cohost.run")}
  boot:cljrs {:doc "clojurust (Rust): the cargo-installed `cljrs` on PATH (0.2.32)"
              :task (shell "cljrs" "run" "--src-path" "src" "src/cohost/run.cljc")}
  boot:jank {:doc "jank (C++/LLVM): the apt-installed `jank` on PATH"
             :task (shell "jank" "--module-path" "src" "run-main" "cohost.run")}
  bench:cljw {:doc "cohost.bench on ClojureWasm (target/bench-cljw.edn)"
              :task (do (babashka.fs/create-dirs "target")
                        (apply shell "cljw" "-cp" "src" "-m" "cohost.run" "--bench" (git-rev) *command-line-args*))}
  bench:phel {:doc "cohost.bench on Phel (target/bench-phel.edn)"
              :task (do (babashka.fs/create-dirs "target")
                        (shell "phel" "eval"
                               (str "(require 'cohost.run) (apply cohost.run/-main \"--bench\" " (pr-str (vec (cons (git-rev) *command-line-args*))) ")")))}
  bench:lg  {:doc "cohost.bench on let-go (target/bench-lg.edn)"
             :task (do (babashka.fs/create-dirs "target")
                       (apply shell "lg" "-source-paths" "src" "-m" "cohost.run" "--bench" (git-rev) *command-line-args*))}
  bench:cljrs {:doc "cohost.bench on clojurust (target/bench-cljrs.edn)"
               :task (do (babashka.fs/create-dirs "target")
                         (apply shell "cljrs" "run" "--src-path" "src" "src/cohost/run.cljc" "--" "--bench" (git-rev) *command-line-args*))}
  bench:jank {:doc "cohost.bench on jank (target/bench-jank.edn)"
              :task (do (babashka.fs/create-dirs "target")
                        (apply shell "jank" "--module-path" "src" "run-main" "cohost.run" "--" "--bench" (git-rev) *command-line-args*))}
  lint:reader-order {:doc "every #? in src: :jolt and :cljw (which also read :clj arms) ahead of :clj, nothing after :default, no unknown feature"
                     :task (load-file "dev/lint_reader_order.clj")}
  boot:all  {:doc "every host that is on PATH"
             :task (doseq [[t exe] [["boot:jolt" "jolt"] ["boot:lpy" "basilisp"] ["boot:jvm" "clojure"]
                                    ["boot:cljw" "cljw"] ["boot:phel" "phel"] ["boot:lg" "lg"]
                                    ["boot:cljrs" "cljrs"] ["boot:jank" "jank"]]]
                     (if (babashka.fs/which exe)
                       (do (println (str "== " t " ==")) (shell "bb" t))
                       (println (str "== " t " == (skipped: no " exe " on PATH)"))))}}}
