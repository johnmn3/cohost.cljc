;; cohost: boot the stock clojure/core.clj inside a clojure-like.
;; Each task installs that host's adapter (src/cohost/hosts/), boots
;; core.clj, prints the boot report, and runs the behavior battery
;; (src/cohost/battery.cljc) in a namespace that sees only the booted core.
{:tasks
 {;; the source a bench ran: git HEAD, -dirty when the tree had changes
  :init (do (defn git-rev []
            (try (let [h (clojure.string/trim (:out (babashka.process/shell {:out :string} "git" "rev-parse" "--short" "HEAD")))
                       dirty (seq (clojure.string/trim (:out (babashka.process/shell {:out :string} "git" "status" "--porcelain" "--" "src" "bb.edn"))))]
                   (str "--git=" h (when dirty "-dirty")))
                 (catch Exception _ "--git=unknown")))
          ;; Cache dir of cohost's objects. Recompiles when src/cohost or the
          ;; jank binary changed (dev/perf/jank_aot_ensure.clj).
          (defn jank-aot-dir []
            (load-file "dev/perf/jank_aot_ensure.clj"))
          ;; The jank binary every jank task runs: JANK_BIN, default jank on
          ;; PATH (a source build: dev/install/jank-src.sh, upstream/jank/README.md)
          (def jank-bin (let [b (System/getenv "JANK_BIN")]
                          (if (clojure.string/blank? b) "jank" b)))
          ;; The AOT snapshot's module path when the snapshot is fresh, else
          ;; nil; never builds it (bb boot:jank-snapshot does). Its key:
          ;; dev/perf/jank_snapshot_key.clj. A JANK_BIN binary has its own snapshot
          ;; (target/jank-snapshot-<hash of its path>), keyed by its version, path,
          ;; size and mtime (X1-7), as its AOT objects are.
          ;; jank-FAST research item 1 (S3-1): the jank tasks that evaluate
          ;; cohost run its JIT at -O3. COHOST_JANK_O=-O0 (or any level), or
          ;; =none for the command line without -O (as before).
          (defn jank-o []
            (let [o (System/getenv "COHOST_JANK_O")]
              (cond (nil? o) ["-O3"] (= "none" o) [] :else [o])))
          ;; jank-MAX A1: the collector environment of every jank process these tasks
          ;; start (dev/perf/jank_gc_env.clj; the user's GC_* win, COHOST_JANK_GC=none
          ;; sets nothing)
          (load-file "dev/perf/jank_gc_env.clj")
          (defn jank-shell [& args]
            (apply babashka.process/shell {:extra-env (jank-gc-env)} args))
          (defn jank! [& args]
            (apply jank-shell (concat [jank-bin] (jank-o) args)))
          ;; unit 8: the -Sdeps of cohost's Node cljs builds -- Eve's hosts.edn
          ;; :cljs row on the classpath (cohost.hosts.cljs-eve is in them)
          ;; basilisp seats: Eve's :lpy host row from the sibling ../eve (hosts.edn,
          ;; the same row Eve's own bb classpath composes: src + adapter roots, absolute),
          ;; as `-p` pairs, and the form that loads eve.host-completion first
          ;; (sorted-map, sorted-set-by ... that basilisp 0.5.1 lacks; cohost.http needs them).
          ;; Without these roots eve.host-completion never loads: bench:lpy died at
          ;; "unable to resolve symbol 'sorted-map'" (src/cohost/http.cljc:176).
          (defn lpy-eve-paths []
            (let [eve (str (babashka.fs/canonicalize "../eve"))
                  row (get (clojure.edn/read-string (slurp (str eve "/hosts.edn"))) :lpy)]
              (mapcat (fn [r] ["-p" (str eve "/" r)]) (cons "src" row))))
          (def lpy-eve-load "(require 'eve.host-completion) ")
          (defn eve-cljs-sdeps []
            (load-file "dev/eve-cljs/eve_paths.clj")
            (when-not (babashka.fs/exists? ((resolve 'eve-paths/eve-checkout-dir) "."))
              (babashka.process/shell "clojure" "-P" "-M:cljs"))
            ((resolve 'eve-paths/eve-cljs-build-sdeps) "." nil))
          (defn jank-snapshot-path []
            (load-file "dev/perf/jank_snapshot_key.clj")
            ((resolve 'fresh-path))))
  docs:check {:doc "README.md's and doc/guide's bash blocks, run as written against one fresh cohost/app project per target: bb docs:check [target ...] (default jvm)"
              :task (do (def docs? true) (load-file "dev/cli-demo/readme_check.clj"))}
  readme:check {:doc "README.md's bash blocks, run as written against a fresh cohost/app project per target: bb readme:check [target ...] (default jvm)"
                :task (load-file "dev/cli-demo/readme_check.clj")}
  cli:check {:doc "the cohost CLI against the Clojure CLI on the demo (dev/cli-demo): bb cli:check [target ...]; one line per target x case: SAME, ABSENT or DIFF"
             :task (load-file "dev/cli-demo/check.clj")}
  clj-body:test {:doc "the :clj leg: stub clojure/jolt on PATH and a stub champaca bundle: bb clj-body:test"
                 :task (load-file "dev/clj_body_test.clj")}
  clj-body:jolt-load {:doc "Load cohost.cli and cohost.clj-champaca under jolt (the analyzer). Skips when jolt is not on PATH. Not part of clj-body:test."
                      :task (if (babashka.fs/which "jolt")
                              (shell "jolt" "-Scp" "src" "-e"
                                     "(require 'cohost.clj-champaca) (require 'cohost.cli) (println :jolt-loaded)")
                              (println "clj-body:jolt-load: skipped, jolt is not on PATH"))}
  debug-seam:check {:doc "the debug-seam checklist (doc/debug-seam-research.md (c), checks #1-#14) through the seam on one target: bb debug-seam:check [jvm|jank]; one PASS/FAIL/SKIP line per check"
                    :task (load-file "dev/debug_seam_check.clj")}
  boot:jolt {:doc "jolt (Chez Scheme): the `jolt` binary on PATH"
             :task (shell "jolt" "-Scp" "src" "-m" "cohost.run")}
  ;; D-6: from the cached boot when it is fresh (never stale); else boot!
  ;; as before. bb boot:lpy-snapshot builds it (dev/perf/lpy_snapshot_ensure.clj).
  boot:lpy  {:doc "basilisp (Python): the uv/pip-installed `basilisp` on PATH; from the cached boot when fresh"
             :task (if-let [snap (do (load-file "dev/perf/lpy_snapshot_ensure.clj") ((resolve 'lpy-fresh-src)))]
                     (shell "basilisp" "run" "-p" snap "-p" "src" "dev/perf/lpy_snapshot_run.lpy" "--snapshot")
                     (apply shell "basilisp" "run" (concat (lpy-eve-paths) ["-p" "src" "-c" (str lpy-eve-load "(require 'cohost.run) (cohost.run/-main)")])))}
  boot:lpy-snapshot {:doc "basilisp: build the cached boot when stale (record, emit, compile the bytecode), then boot from it and run the batteries"
                     :task (let [snap (do (load-file "dev/perf/lpy_snapshot_ensure.clj") ((resolve 'lpy-ensure!)))]
                             (shell "basilisp" "run" "-p" snap "-p" "src" "dev/perf/lpy_snapshot_run.lpy" "--snapshot"))}
  boot:jvm  {:doc "JVM Clojure as the host (the reference adapter)"
             ;; -XX:hashCode=3 (sequential identity hashes) is the eduction
             ;; canary's lever: stock 1.12.0's CollReduce dispatch for
             ;; Eduction rides on the impl map's hash iteration order over
             ;; Class keys, and under the default identity-hash mode the
             ;; build box's order picks the IReduceInit impl whose body
             ;; casts Eduction to IReduce (220/221; the row passes on the
             ;; collation box). Sequential hashes make the order
             ;; deterministic and the dispatch the lawful one, without
             ;; changing anything the battery measures (every row runs and
             ;; asserts the same values). See doc/eve-cohost/RELEASE-
             ;; CLEANUP-STATUS.md item 4 and UNIT4-REMAINDER-REPORT.md.
             :task (shell "clojure" "-J-XX:+UnlockExperimentalVMOptions" "-J-XX:hashCode=3" "-M:eve" "-m" "cohost.run")}
  boot:cljs {:doc "ClojureScript, self-hosted on Node: compile the bootstrap build, then run it"
             :task (do (shell "clojure" "-Sdeps" (eve-cljs-sdeps) "-M:cljs" "-m" "cljs.main" "-co" "cljs-node.edn" "-c")
                       (shell "node" "target/cljs-node/main.js"))}
  boot:browser {:doc "ClojureScript, self-hosted in Chromium: compile the browser build, serve it, run it under Playwright"
                :task (do (shell "clojure" "-M:cljs" "-m" "cljs.main" "-co" "cljs-browser.edn" "-c")
                          (shell "python3" "-I" "dev/browser_boot.py"))}
  eval:jolt {:doc "boot on jolt, then evaluate the arguments in the stock user namespace: bb eval:jolt '(swap! (atom 0) + 1 2 3)'"
             :task (apply shell "jolt" "-Scp" "src" "-m" "cohost.run" "--eval" *command-line-args*)}
  corpus:jolt {:doc "a conformance corpus (rows: :suite :label :actual :expected :portability), the stock core vs jolt's own core, each side in its own jolt process: bb corpus:jolt path/to/corpus.edn (the jolt-conformance corpus is jolt's test/chez/corpus.edn, https://github.com/jolt-lang/jolt)"
               ;; each side runs in target/corpus-cwd: rows that write files
               ;; (spit, a directory as a file) write them there
               :task (let [abs (fn [p] (str (babashka.fs/absolutize p)))
                           path (if-let [p (first *command-line-args*)]
                                  (abs p)
                                  (do (println "usage: bb corpus:jolt path/to/corpus.edn  (jolt's test/chez/corpus.edn: https://github.com/jolt-lang/jolt)")
                                      (System/exit 1)))
                           run (fn [side]
                                 (shell {:dir "target/corpus-cwd"} "jolt" "-Scp" (abs "src") "-e"
                                        (str "(require 'cohost.run 'cohost.corpus) (cohost.boot/boot! {:root " (pr-str (abs "resources/cohost/clojure-1.12.0")) "}) (cohost.boot/make-user-ns!) "
                                             "(cohost.corpus/run-corpus! {:path " (pr-str path) " :side " side " :out " (pr-str (abs (str "target/corpus-" (name side) ".edn"))) "}) (System/exit 0)")))]
                       (babashka.fs/create-dirs "target/corpus-cwd")
                       (run :stock)
                       (run :host)
                       (load-file "src/cohost/corpus_report.cljc")
                       (let [rd (fn [f] (clojure.edn/read-string (slurp f)))
                             merged ((resolve 'cohost.corpus-report/merge-sides) (rd "target/corpus-stock.edn") (rd "target/corpus-host.edn"))]
                         ((resolve 'cohost.corpus-report/summarize) merged 40 "jolt")))}
  corpus:jvm {:doc "after corpus:jolt: the rows jolt's core passes and the stock core fails, evaluated on JVM Clojure 1.12.0 (dev/corpus_jvm.clj) — which of them the JVM answers as the corpus expects"
              :task (let [abs (fn [p] (str (babashka.fs/absolutize p)))
                          cp (clojure.string/trim (:out (shell {:out :string} "clojure" "-Spath")))]
                      (babashka.fs/create-dirs "target/corpus-cwd")
                      (shell {:dir "target/corpus-cwd"} "java" "-cp" cp "clojure.main" (abs "dev/corpus_jvm.clj")
                             (abs "src/cohost/corpus_report.cljc") (abs "target/corpus-stock.edn")
                             (abs "target/corpus-host.edn") (abs "target/corpus-gap-jvm.edn")))}
  bench:jolt {:doc "cohost.bench on jolt: each case through jolt's own core and through the stock core, in one process (target/bench-jolt.edn)"
              :task (do (babashka.fs/create-dirs "target")
                        ;; jolt wraps calls in runtime-compiled code (cohost's) in
                        ;; trace bookkeeping unless JOLT_TRACE=0; its own core is
                        ;; compiled ahead of time: the setting rides with the results
                        (apply shell "jolt" "-Scp" "src" "-m" "cohost.run" "--bench" (git-rev)
                               (str "--note=JOLT_TRACE=" (or (System/getenv "JOLT_TRACE") "unset")) *command-line-args*))}
  bench:jvm {:doc "cohost.bench on JVM Clojure, whose own core is the baseline (target/bench-clj.edn)"
             :task (do (babashka.fs/create-dirs "target")
                       (apply shell "clojure" "-M" "-m" "cohost.run" "--bench" (git-rev) *command-line-args*))}
  bench:lpy {:doc "cohost.bench on basilisp (target/bench-lpy.edn)"
             :task (do (babashka.fs/create-dirs "target")
                       (apply shell "basilisp" "run" (concat (lpy-eve-paths) ["-p" "src" "-c"
                              (str lpy-eve-load "(require 'cohost.run) (apply cohost.run/-main \"--bench\" " (pr-str (vec (cons (git-rev) *command-line-args*))) ")")])))}
  bench:cljs {:doc "cohost.bench on self-hosted ClojureScript in Node (target/bench-cljs.edn)"
              :task (do (shell "clojure" "-Sdeps" (eve-cljs-sdeps) "-M:cljs" "-m" "cljs.main" "-co" "cljs-node.edn" "-c")
                        (apply shell "node" "target/cljs-node/main.js" "--bench" (git-rev) *command-line-args*))}
  bench:browser {:doc "cohost.bench on self-hosted ClojureScript in Chromium (target/bench-chromium.edn)"
                 :task (do (shell "clojure" "-M:cljs" "-m" "cljs.main" "-co" "cljs-browser.edn" "-c")
                           (shell "python3" "-I" "dev/browser_boot.py" "bench"))}
  bench:report {:doc "the tables from target/bench-*.edn: every host against JVM Clojure, and each host's own core against the stock core"
                :task (load-file "dev/bench_report.clj")}
  ;; the five hosts of doc/hosts/PLAN.md; each install is dev/install/<host>.sh
  boot:cljw {:doc "ClojureWasm (Zig): the `cljw` binary on PATH (v1.15.4)"
             :task (shell "cljw" "-cp" "src" "-m" "cohost.run")}
  boot:phel {:doc "Phel (PHP 8.5): the `phel` wrapper over phel.phar on PATH (v0.54.0)"
             ;; 1 GB of stack, as bin/cohost's Phel launch: PHP's 8 MB default segfaults freeing a long lazy seq
             :task (shell "bash" "-c" "ulimit -s 1048576 2>/dev/null; exec phel run dev/phel_main.phel")}
  boot:lg   {:doc "let-go (Go): the `lg` binary on PATH (v1.13.0); it has no -m, so dev/lg_main.lg calls cohost.run"
             :task (shell "lg" "-source-paths" "src" "dev/lg_main.lg")}
  ;; CLJRS_IR_THRESHOLD=1: clojurust lowers a fn to its IR on the first call,
  ;; not the fiftieth; its evaluator expands a fn's macros again on every run
  ;; until then. CLJRS_NO_JIT: its JIT compiles calls of vswap!, intern and
  ;; their kind as calls of values, which throw. --src-path target/cljrs-ns:
  ;; the adapter writes a file there for each namespace cohost makes, so that
  ;; clojurust's require (its only refer) can refer it (doc/REPORT.md)
  boot:cljrs {:doc "clojurust (Rust): the cargo-installed `cljrs` on PATH (0.2.32)"
              :task (shell {:extra-env {"CLJRS_IR_THRESHOLD" "1" "CLJRS_NO_JIT" "1"}} "cljrs" "run" "--src-path" "src" "--src-path" "target/cljrs-ns" "src/cohost/run.cljc")}
  ;; Source only. boot:jank loads the compiled modules.
  boot:jank-jit {:doc "jank from source only (no AOT objects)"
                 :task (jank! "--module-path" "src" "run-main" "cohost.run")}
  ;; jank-FAST Step 6 stage 2: from the AOT snapshot when it is fresh (it is
  ;; never loaded stale); else cohost's AOT modules booting core.clj.
  boot:jank {:doc "jank (C++/LLVM): the AOT snapshot when fresh (bb boot:jank-snapshot builds it), else cohost's AOT modules, recompiled when src/cohost or the jank binary is stale. Source path: boot:jank-jit."
             :task (if-let [p (jank-snapshot-path)]
                     (jank! "--module-path" p "run" "dev/perf/jank_snapshot_run.jank")
                     (jank! "--module-path" (str (jank-aot-dir) ":src") "run-main" "cohost.run"))}
  ;; jank-FAST Step 2. Phase timers inside boot! ({:profile? true} only) plus
  ;; the twelve libraries. One run. Median of three: dev/perf/jank_boot_profile.sh
  boot:jank-profile {:doc "jank boot with phase timers (doc/perf/jank.md, Boot profile). One run."
                     :task (jank-shell jank-bin "--module-path" "src" "run" "dev/perf/jank_boot_profile.jank")}
  ;; Same profile after the AOT modules boot:jank loads. Median of three:
  ;; dev/perf/jank_aot_profile.sh
  boot:jank-aot-profile {:doc "jank boot profile with cohost namespaces AOT'd -O3. One run."
                         :task (jank! "--module-path" (str (jank-aot-dir) ":src")
                                      "run" "dev/perf/jank_boot_profile.jank")}
  ;; jank-FAST Step 6 stage 1. Same objects as boot:jank, then the load stamp
  ;; immediately before cohost.run/-main (dev/perf/jank_aot_load.jank).
  ;; The adapter is cohost.hosts.jank-host (not cohost.hosts.jank): the C++
  ;; namespace is no longer named jank, so jank::runtime does not resolve
  ;; inward and the module can be compiled with the rest of cohost.run.
  ;; Load-time medians: dev/perf/jank_aot_time.sh
  boot:jank-aot {:doc "jank: AOT cohost's namespaces (-O3, including cohost.hosts.jank-host and cohost.shim) and boot through the load stamp. See dev/perf/jank_aot_time.sh."
                 :task (apply jank-shell jank-bin "--module-path" (str (jank-aot-dir) ":src")
                              "run" "dev/perf/jank_aot_load.jank" "--" *command-line-args*)}
  ;; jank-FAST Step 6 stage 2. Boot from the AOT snapshot of the booted core
  ;; and libraries (target/jank-snapshot/, generated, not committed). The
  ;; snapshot is keyed by a hash of every input and rebuilt when stale, never
  ;; loaded stale: dev/perf/jank_snapshot_ensure.clj. Args as boot:jank
  ;; (--no-libs, --bench [--quick]).
  boot:jank-snapshot {:doc "jank: boot from the AOT snapshot (rebuilt first when stale), then the batteries or --bench. See dev/perf/jank_snapshot_ensure.clj."
                      ;; any jank binary (JANK_BIN, X1-7): each has its own snapshot root and key
                      :task (apply jank! "--module-path" (load-file "dev/perf/jank_snapshot_ensure.clj")
                                   "run" "dev/perf/jank_snapshot_run.jank" "--" *command-line-args*)}
  ;; D-7: a native executable of a project's app on jank (src/cohost/build_jank.clj;
  ;; lane C's cohost.build calls the same build! for cohost -T:build jank-exe).
  build:jank {:doc "jank: bb build:jank <project-dir> <main-ns> [name] -- the app as one native executable (<project>/target/jank/<name>), rebuilt when stale"
              :task (let [[dir main nm] *command-line-args*
                          project (str (babashka.fs/canonicalize dir))
                          spath (:out (babashka.process/shell {:dir project :out :string} (str (babashka.fs/canonicalize "bin/cohost")) ":jank" "-Spath"))
                          roots (vec (remove clojure.string/blank? (clojure.string/split (clojure.string/trim spath) (re-pattern ":"))))]
                      (load-file "src/cohost/build_jank.clj")
                      (println ((resolve 'cohost.build-jank/build!)
                                {:repo (str (babashka.fs/canonicalize ".")) :project project :roots roots :main main :name nm})))}
  bench:cljw {:doc "cohost.bench on ClojureWasm (target/bench-cljw.edn)"
              :task (do (babashka.fs/create-dirs "target")
                        (apply shell "cljw" "-cp" "src" "-m" "cohost.run" "--bench" (git-rev) *command-line-args*))}
  bench:phel {:doc "cohost.bench on Phel (target/bench-phel.edn), with a 1 GB C stack"
              ;; Phel's own count of a long lazy seq, sort, frequencies and
              ;; distinct of 50,000-100,000 items recurse past PHP's default
              ;; 8 MB C stack and segfault (doc/REPORT.md)
              :task (do (babashka.fs/create-dirs "target")
                        (apply shell "bash" "-c" "ulimit -s 1048576 2>/dev/null; exec phel run dev/phel_main.phel \"$@\"" "bench-phel"
                               "--bench" (git-rev) *command-line-args*))}
  bench:lg  {:doc "cohost.bench on let-go (target/bench-lg.edn)"
             :task (do (babashka.fs/create-dirs "target")
                       (apply shell "lg" "-source-paths" "src" "dev/lg_main.lg" "--bench" (git-rev) *command-line-args*))}
  bench:cljrs {:doc "cohost.bench on clojurust (target/bench-cljrs.edn)"
               :task (do (babashka.fs/create-dirs "target")
                         (apply shell {:extra-env {"CLJRS_IR_THRESHOLD" "1" "CLJRS_NO_JIT" "1"}} "cljrs" "run" "--src-path" "src" "--src-path" "target/cljrs-ns" "src/cohost/run.cljc" "--" "--bench" (git-rev) *command-line-args*))}
  bench:programs {:doc "Step 8 program suite. bb bench:programs <target>|all. Times land in doc/PERF.md."
                  :task (load-file "dev/bench_programs.clj")}
  bench:jank {:doc "cohost.bench on jank, the AOT snapshot when fresh, else AOT modules (target/bench-jank.edn). Source path: boot:jank-jit, then the same --bench arguments."
              :task (do (babashka.fs/create-dirs "target")
                        (if-let [p (jank-snapshot-path)]
                          (apply jank! "--module-path" p "run" "dev/perf/jank_snapshot_run.jank" "--" "--bench" (git-rev) *command-line-args*)
                          (apply jank! "--module-path" (str (jank-aot-dir) ":src") "run-main" "cohost.run" "--" "--bench" (git-rev) *command-line-args*)))}
  lint:reader-order {:doc "every #? in src: :jolt and :cljw (which also read :clj arms) ahead of :clj, nothing after :default, no unknown feature"
                     :task (load-file "dev/lint_reader_order.clj")}
  boot:all  {:doc "every host that is on PATH"
             :task (doseq [[t exe] [["boot:jolt" "jolt"] ["boot:lpy" "basilisp"] ["boot:jvm" "clojure"]
                                    ["boot:cljw" "cljw"] ["boot:phel" "phel"] ["boot:lg" "lg"]
                                    ["boot:cljrs" "cljrs"] ["boot:jank" jank-bin]]]
                     (if (babashka.fs/which exe)
                       (do (println (str "== " t " ==")) (shell "bb" t))
                       (println (str "== " t " == (skipped: no " exe " on PATH)"))))}}}
